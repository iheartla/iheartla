 "outputs": {
  "numpy": "\"\"\"\n`Output` = `Parameters` `Minimize`(`Parameters`)\n                    where\n                    `Parameters`: ℝ ^ (2 × 2): a matrix\n                    `Minimize`: ℝ^(2 × 2) -> ℝ^(2 × 2): a function \n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, Parameters, Minimize):\n        Parameters = np.asarray(Parameters, dtype=np.float64)\n        assert Parameters.shape == (2, 2)\n        # `Output` = `Parameters` `Minimize`(`Parameters`)\n        self.Output = Parameters @ Minimize(Parameters)\n\n\n\n\n\n",
  "eigen": "/*\n`Output` = `Parameters` `Minimize`(`Parameters`)\n                    where\n                    `Parameters`: ℝ ^ (2 × 2): a matrix\n                    `Minimize`: ℝ^(2 × 2) -> ℝ^(2 × 2): a function \n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    Eigen::Matrix<DT, 2, 2> Output;\n\n    heartlib(\n        const Eigen::Matrix<double, 2, 2> & Parameters,\n        const std::function<Eigen::Matrix<double, 2, 2>(Eigen::Matrix<double, 2, 2>)> & Minimize)\n    {\n    \n        // `Output` = `Parameters` `Minimize`(`Parameters`)\n        Output = Parameters * Minimize((Parameters).eval());\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\n\\mathit{Output} & = \\mathit{Parameters} \\mathit{Minimize}\\left( \\mathit{Parameters} \\right) \\\\\n\\intertext{where} \n\\mathit{Parameters} & : \\mathbb{R}^{ 2 \\times 2 } \\text{ a matrix} \\\\\n\\mathit{Minimize} & : \\mathbb{R}^{ 2 \\times 2 }\\rightarrow \\mathbb{R}^{ 2 \\times 2 } \\text{ a function } \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n\\mathit{Output} & = \\mathit{Parameters} \\mathit{Minimize}\\left( \\mathit{Parameters} \\right) \\\\\nwhere \\\\\n\\mathit{Parameters} & : \\mathbb{R}^{ 2 \\times 2 } \\text{ a matrix} \\\\\n\\mathit{Minimize} & : \\mathbb{R}^{ 2 \\times 2 }\\rightarrow \\mathbb{R}^{ 2 \\times 2 } \\text{ a function } \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(Parameters, Minimize)\n% output = heartlib(Parameters, Minimize)\n%\n%    `Output` = `Parameters` `Minimize`(`Parameters`)\n%                        where\n%                        `Parameters`: ℝ ^ (2 × 2): a matrix\n%                        `Minimize`: ℝ^(2 × 2) -> ℝ^(2 × 2): a function \n    assert( isequal(size(Parameters), [2, 2]) );\n\n    % `Output` = `Parameters` `Minimize`(`Parameters`)\n\n    Output = Parameters * Minimize(Parameters);\n    output.Output = Output;\nend\n",
  "macromathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'Output', 'heartlib', 'def', false, '')\", \"id\":\"heartlib-Output\", \"sym\":\"Output\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"def\", \"case\":\"equation\"} }{ {\\mathit{Output}} } & = \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'Parameters', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-Parameters\", \"sym\":\"Parameters\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {\\mathit{Parameters}} } \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'Minimize', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-Minimize\", \"sym\":\"Minimize\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {\\mathit{Minimize}} }\\left( \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'Parameters', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-Parameters\", \"sym\":\"Parameters\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {\\mathit{Parameters}} } \\right)\\\\\\eqlabel{ {\"onclick\":\"event.stopPropagation(); onClickEq(this, 'heartlib', ['Minimize', 'Parameters', 'Output'], false, [], [], 'YE91dHB1dGAgPSBgUGFyYW1ldGVyc2AgYE1pbmltaXplYChgUGFyYW1ldGVyc2Ap');\"} }{}\n \\\\\nwhere \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'Parameters', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-Parameters\", \"sym\":\"Parameters\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {\\mathit{Parameters}} } & : \\mathbb{R}^{ 2 \\times 2 } \\text{ a matrix} \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'Minimize', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-Minimize\", \"sym\":\"Minimize\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {\\mathit{Minimize}} } & : \\mathbb{R}^{ 2 \\times 2 }\\rightarrow \\mathbb{R}^{ 2 \\times 2 } \\text{ a function } \\\\\n\\\\\n\\end{align*}\n"
