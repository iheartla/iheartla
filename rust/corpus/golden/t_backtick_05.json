 "outputs": {
  "numpy": "\"\"\"\ncc = 2\n        `dd` = 3\n        ee = aa bb cc dd\n        ff = `aa` `bb` `cc` `dd`\n        where\n        `aa`: ℝ\n        bb: ℝ \n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, aa, bb):\n        assert np.ndim(aa) == 0\n        assert np.ndim(bb) == 0\n        # cc = 2\n        self.cc = 2\n        # `dd` = 3\n        self.dd = 3\n        # ee = aa bb cc dd\n        self.ee = aa * bb * self.cc * self.dd\n        # ff = `aa` `bb` `cc` `dd`\n        self.ff = aa * bb * self.cc * self.dd\n\n\n\n\n\n",
  "eigen": "/*\ncc = 2\n        `dd` = 3\n        ee = aa bb cc dd\n        ff = `aa` `bb` `cc` `dd`\n        where\n        `aa`: ℝ\n        bb: ℝ \n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    int cc;\n    int dd;\n    DT ee;\n    DT ff;\n\n    heartlib(\n        const double & aa,\n        const double & bb)\n    {\n    \n        // cc = 2\n        cc = 2;\n        // `dd` = 3\n        dd = 3;\n        // ee = aa bb cc dd\n        ee = aa * bb * cc * dd;\n        // ff = `aa` `bb` `cc` `dd`\n        ff = aa * bb * cc * dd;\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\n\\mathit{cc} & = 2 \\\\\n\\mathit{dd} & = 3 \\\\\n\\mathit{ee} & = \\mathit{aa} \\mathit{bb} \\mathit{cc} \\mathit{dd} \\\\\n\\mathit{ff} & = \\mathit{aa} \\mathit{bb} \\mathit{cc} \\mathit{dd} \\\\\n\\intertext{where} \n\\mathit{aa} & : \\mathbb{R} \\\\\n\\mathit{bb} & : \\mathbb{R} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n\\mathit{cc} & = 2 \\\\\n\\mathit{dd} & = 3 \\\\\n\\mathit{ee} & = \\mathit{aa} \\mathit{bb} \\mathit{cc} \\mathit{dd} \\\\\n\\mathit{ff} & = \\mathit{aa} \\mathit{bb} \\mathit{cc} \\mathit{dd} \\\\\nwhere \\\\\n\\mathit{aa} & : \\mathbb{R} \\\\\n\\mathit{bb} & : \\mathbb{R} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(aa, bb)\n% output = heartlib(aa, bb)\n%\n%    cc = 2\n%            `dd` = 3\n%            ee = aa bb cc dd\n%            ff = `aa` `bb` `cc` `dd`\n%            where\n%            `aa`: ℝ\n%            bb: ℝ \n    assert(numel(aa) == 1);\n    assert(numel(bb) == 1);\n\n    % cc = 2\n\n    cc = 2;\n    % `dd` = 3\n\n    dd = 3;\n    % ee = aa bb cc dd\n\n    ee = aa * bb * cc * dd;\n    % ff = `aa` `bb` `cc` `dd`\n\n    ff = aa * bb * cc * dd;\n    output.cc = cc;\n    output.dd = dd;\n    output.ee = ee;\n    output.ff = ff;\nend\n",
