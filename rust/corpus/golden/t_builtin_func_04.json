 "outputs": {
  "numpy": "\"\"\"\nsin,asin,arcsin,cos,acos,arccos,tan,atan,arctan,atan2,sinh,asinh,arsinh,cosh,acosh,arcosh,tanh,atanh,artanh,cot,sec,csc from trigonometry\ntrace,tr,trace,tr,diag,vec,det,rank,null,orth,inv from linearalgebra\nc = atan2(a, b)\n        where\n        a: scalar\n        b: scalar\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, a, b):\n        assert np.ndim(a) == 0\n        assert np.ndim(b) == 0\n        # c = atan2(a, b)\n        self.c = np.arctan2(a, b)\n\n\n\n\n\n",
  "eigen": "/*\nsin,asin,arcsin,cos,acos,arccos,tan,atan,arctan,atan2,sinh,asinh,arsinh,cosh,acosh,arcosh,tanh,atanh,artanh,cot,sec,csc from trigonometry\ntrace,tr,trace,tr,diag,vec,det,rank,null,orth,inv from linearalgebra\nc = atan2(a, b)\n        where\n        a: scalar\n        b: scalar\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    DT c;\n\n    heartlib(\n        const double & a,\n        const double & b)\n    {\n    \n        // c = atan2(a, b)\n        c = atan2(a, b);\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\n \\omit \\span \\text{ sin, asin, arcsin, cos, acos, arccos, tan, atan, arctan, atan2, sinh, asinh, arsinh, cosh, acosh, arcosh, tanh, atanh, artanh, cot, sec, csc from trigonometry }\\\\\n \\\\\n \\omit \\span \\text{ trace, tr, trace, tr, diag, vec, det, rank, null, orth, inv from linearalgebra }\\\\\n \\\\\nc & = atan2\\left( a, b \\right) \\\\\n\\intertext{where} \na & : \\mathbb{R} \\\\\nb & : \\mathbb{R} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n & \\text{ sin, asin, arcsin, cos, acos, arccos, tan, atan, arctan, atan2, sinh, asinh, arsinh, cosh, acosh, arcosh, tanh, atanh, artanh, cot, sec, csc from trigonometry }\\\\\n \\\\\n & \\text{ trace, tr, trace, tr, diag, vec, det, rank, null, orth, inv from linearalgebra }\\\\\n \\\\\nc & = atan2\\left( a, b \\right) \\\\\nwhere \\\\\na & : \\mathbb{R} \\\\\nb & : \\mathbb{R} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(a, b)\n% output = heartlib(a, b)\n%\n%    sin,asin,arcsin,cos,acos,arccos,tan,atan,arctan,atan2,sinh,asinh,arsinh,cosh,acosh,arcosh,tanh,atanh,artanh,cot,sec,csc from trigonometry\n%    trace,tr,trace,tr,diag,vec,det,rank,null,orth,inv from linearalgebra\n%    c = atan2(a, b)\n%            where\n%            a: scalar\n%            b: scalar\n    assert(numel(a) == 1);\n    assert(numel(b) == 1);\n\n    % c = atan2(a, b)\n\n    c = atan2(a, b);\n    output.c = c;\nend\n",
  "macromathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n & \\text{ sin, asin, arcsin, cos, acos, arccos, tan, atan, arctan, atan2, sinh, asinh, arsinh, cosh, acosh, arcosh, tanh, atanh, artanh, cot, sec, csc from trigonometry }\\\\\n \\\\\n & \\text{ trace, tr, trace, tr, diag, vec, det, rank, null, orth, inv from linearalgebra }\\\\\n \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'c', 'heartlib', 'def', false, '')\", \"id\":\"heartlib-c\", \"sym\":\"c\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"def\", \"case\":\"equation\"} }{ {c} } & = atan2\\left( \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'a', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-a\", \"sym\":\"a\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {a} }, \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'b', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-b\", \"sym\":\"b\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {b} } \\right)\\\\\\eqlabel{ {\"onclick\":\"event.stopPropagation(); onClickEq(this, 'heartlib', ['a', 'b', 'c'], false, [], [], 'YyA9IGF0YW4yKGEsIGIp');\"} }{}\n \\\\\nwhere \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'a', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-a\", \"sym\":\"a\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {a} } & : \\mathbb{R} \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'b', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-b\", \"sym\":\"b\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {b} } & : \\mathbb{R} \\\\\n\\\\\n\\end{align*}\n"
