 "outputs": {
  "numpy": "\"\"\"\nsin,asin,arcsin,cos,acos,arccos,tan,atan,arctan,atan2,sinh,asinh,arsinh,cosh,acosh,arcosh,tanh,atanh,artanh,cot,sec,csc from trigonometry\ntrace,tr,trace,tr,diag,vec,det,rank,null,orth,inv from linearalgebra\nA = sin(T)\n        where\n        T: ℝ ^ (2×2): a sequence\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, T):\n        T = np.asarray(T, dtype=np.float64)\n        assert T.shape == (2, 2)\n        # A = sin(T)\n        self.A = np.sin(T)\n\n\n\n\n\n",
  "eigen": "/*\nsin,asin,arcsin,cos,acos,arccos,tan,atan,arctan,atan2,sinh,asinh,arsinh,cosh,acosh,arcosh,tanh,atanh,artanh,cot,sec,csc from trigonometry\ntrace,tr,trace,tr,diag,vec,det,rank,null,orth,inv from linearalgebra\nA = sin(T)\n        where\n        T: ℝ ^ (2×2): a sequence\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    Eigen::Matrix<DT, 2, 2> A;\n\n    heartlib(const Eigen::Matrix<double, 2, 2> & T)\n    {\n    \n        // A = sin(T)\n        A = T.unaryExpr<DT(*)(DT)>(&std::sin);\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\n \\omit \\span \\text{ sin, asin, arcsin, cos, acos, arccos, tan, atan, arctan, atan2, sinh, asinh, arsinh, cosh, acosh, arcosh, tanh, atanh, artanh, cot, sec, csc from trigonometry }\\\\\n \\\\\n \\omit \\span \\text{ trace, tr, trace, tr, diag, vec, det, rank, null, orth, inv from linearalgebra }\\\\\n \\\\\nA & = sin\\left( T \\right) \\\\\n\\intertext{where} \nT & : \\mathbb{R}^{ 2 \\times 2 } \\text{ a sequence} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n & \\text{ sin, asin, arcsin, cos, acos, arccos, tan, atan, arctan, atan2, sinh, asinh, arsinh, cosh, acosh, arcosh, tanh, atanh, artanh, cot, sec, csc from trigonometry }\\\\\n \\\\\n & \\text{ trace, tr, trace, tr, diag, vec, det, rank, null, orth, inv from linearalgebra }\\\\\n \\\\\nA & = sin\\left( T \\right) \\\\\nwhere \\\\\nT & : \\mathbb{R}^{ 2 \\times 2 } \\text{ a sequence} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(T)\n% output = heartlib(T)\n%\n%    sin,asin,arcsin,cos,acos,arccos,tan,atan,arctan,atan2,sinh,asinh,arsinh,cosh,acosh,arcosh,tanh,atanh,artanh,cot,sec,csc from trigonometry\n%    trace,tr,trace,tr,diag,vec,det,rank,null,orth,inv from linearalgebra\n%    A = sin(T)\n%            where\n%            T: ℝ ^ (2×2): a sequence\n    assert( isequal(size(T), [2, 2]) );\n\n    % A = sin(T)\n\n    A = sin(T);\n    output.A = A;\nend\n",
  "macromathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n & \\text{ sin, asin, arcsin, cos, acos, arccos, tan, atan, arctan, atan2, sinh, asinh, arsinh, cosh, acosh, arcosh, tanh, atanh, artanh, cot, sec, csc from trigonometry }\\\\\n \\\\\n & \\text{ trace, tr, trace, tr, diag, vec, det, rank, null, orth, inv from linearalgebra }\\\\\n \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'A', 'heartlib', 'def', false, '')\", \"id\":\"heartlib-A\", \"sym\":\"A\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"def\", \"case\":\"equation\"} }{ {A} } & = sin\\left( \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'T', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-T\", \"sym\":\"T\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {T} } \\right)\\\\\\eqlabel{ {\"onclick\":\"event.stopPropagation(); onClickEq(this, 'heartlib', ['T', 'A'], false, [], [], 'QSA9IHNpbihUKQ==');\"} }{}\n \\\\\nwhere \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'T', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-T\", \"sym\":\"T\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {T} } & : \\mathbb{R}^{ 2 \\times 2 } \\text{ a sequence} \\\\\n\\\\\n\\end{align*}\n"
