 "outputs": {
  "numpy": "\"\"\"\nA = sum_(j for j < 2 or j > 3 ) Q_j\n                where\n                Q: ℝ ^ 5\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, Q):\n        Q = np.asarray(Q, dtype=np.float64)\n        assert Q.shape == (5,)\n        # A = sum_(j for j < 2 or j > 3 ) Q_j\n        sum_0 = 0\n        for j in range(1, len(Q)+1):\n            if((j < 2) or (j > 3)):\n                sum_0 += Q[j-1]\n        self.A = sum_0\n\n\n\n\n\n",
  "eigen": "/*\nA = sum_(j for j < 2 or j > 3 ) Q_j\n                where\n                Q: ℝ ^ 5\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    DT A;\n\n    heartlib(const Eigen::Matrix<double, 5, 1> & Q)\n    {\n    \n        // A = sum_(j for j < 2 or j > 3 ) Q_j\n        DT sum_0 = 0;\n        for(int j=1; j<=Q.size(); j++){\n            if((j < 2) || (j > 3)){\n                sum_0 += Q[j-1];\n            }\n        }\n        A = sum_0;\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\nA & = \\sum_{j < 2 \\text{{ or }}j > 3}Q_{ j } \\\\\n\\intertext{where} \nQ & : \\mathbb{R}^{ 5} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\nA & = \\sum_{j < 2 \\text{{ or }}j > 3}Q_{ j } \\\\\nwhere \\\\\nQ & : \\mathbb{R}^{ 5} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(Q)\n% output = heartlib(Q)\n%\n%    A = sum_(j for j < 2 or j > 3 ) Q_j\n%                    where\n%                    Q: ℝ ^ 5\n    Q = reshape(Q,[],1);\n\n    assert( numel(Q) == 5 );\n\n    % A = sum_(j for j < 2 or j > 3 ) Q_j\n\n    sum_0 = 0;\n    for j = 1:size(Q,1)\n        if (j < 2) || (j > 3)\n          sum_0 = sum_0 + Q(j);\n        end\n    end\n    A = sum_0;\n    output.A = A;\nend\n",
  "macromathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'A', 'heartlib', 'def', false, '')\", \"id\":\"heartlib-A\", \"sym\":\"A\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"def\", \"case\":\"equation\"} }{ {A} } & = \\sum_{\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'j', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-j\", \"sym\":\"j\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {j} } < 2 \\text{{ or }}\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'j', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-j\", \"sym\":\"j\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {j} } > 3}\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'Q', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-Q\", \"sym\":\"Q\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {Q} }_{ j }\\\\\\eqlabel{ {\"onclick\":\"event.stopPropagation(); onClickEq(this, 'heartlib', ['Q', 'A'], false, [], [], 'QSA9IHN1bV8oaiBmb3IgaiA8IDIgb3IgaiA-IDMgKSBRX2o=');\"} }{}\n \\\\\nwhere \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'Q', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-Q\", \"sym\":\"Q\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {Q} } & : \\mathbb{R}^{ 5} \\\\\n\\\\\n\\end{align*}\n"
