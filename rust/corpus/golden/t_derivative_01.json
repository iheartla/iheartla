 "outputs": {
  "numpy": "\"\"\"\nS(x) = { ∞ if x_1 ⋅ x_2 ≤ 0\n                             (x_1 ⋅ x_2)² otherwise where x_i ∈ ℝ^2\n                    E = S(x)\n                    G = ∂E/∂x\n                    where\n                    x_i ∈ ℝ^2\n\"\"\"\nimport autograd.numpy as np\nimport autograd\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    _differentiating = 0  # (> 0 while the program is recomputed for a derivative)\n\n    def __init__(self, x):\n        x = np.array(x, dtype=np.float64)\n        dim_0 = x.shape[0]\n        assert x.shape == (dim_0, 2, )\n\n        self.x = x\n        # E = S(x)\n        self.E = self.S(x)\n        if not type(self)._differentiating:\n            # G = ∂E/∂x\n            self.G = autograd.grad(lambda dx: self._without_derivatives(lambda: type(self)(np.reshape(dx, np.shape(x)))).E)(np.ravel(x))\n\n    def S(self, x):\n        x = np.array(x, dtype=np.float64)\n        dim_1 = x.shape[0]\n        assert x.shape == (dim_1, 2, )\n\n        if np.dot((x[1-1]).ravel(), (x[2-1]).ravel()) <= 0:\n            S_ret = np.inf\n        else:\n            S_ret = np.power(np.array((np.dot((x[1-1]).ravel(), (x[2-1]).ravel())), dtype=np.float64), 2)\n        return S_ret\n    def _without_derivatives(self, make):\n        \"\"\"make(), skipping the derivatives of every instance it constructs\"\"\"\n        type(self)._differentiating += 1\n        try:\n            return make()\n        finally:\n            type(self)._differentiating -= 1\n\n\n\n\n\n",
  "eigen": "/*\nS(x) = { ∞ if x_1 ⋅ x_2 ≤ 0\n                             (x_1 ⋅ x_2)² otherwise where x_i ∈ ℝ^2\n                    E = S(x)\n                    G = ∂E/∂x\n                    where\n                    x_i ∈ ℝ^2\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include <autodiff/reverse/var.hpp>\n#include <autodiff/reverse/var/eigen.hpp>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = autodiff::var;\n    using MatrixD = Eigen::Matrix<autodiff::var, Eigen::Dynamic, Eigen::Dynamic>;\n    using VectorD = Eigen::Matrix<autodiff::var, Eigen::Dynamic, 1>;\n    DT E;\n    Eigen::VectorXd G;\n    std::vector<Eigen::Matrix<DT, 2, 1>> x;\n    autodiff::ArrayXvar new_x;\n    template<typename REAL>\n    REAL S(\n        const std::vector<Eigen::Matrix<REAL, 2, 1>> & x)\n    {\n        const long dim_1 = x.size();\n        REAL S_ret;\n        if((x.at(1-1)).dot(x.at(2-1)) <= 0){\n            S_ret = INFINITY;\n        }\n        else{\n            S_ret = pow(((x.at(1-1)).dot(x.at(2-1))), 2);\n        }\n        return S_ret;    \n    }\n    heartlib(const std::vector<Eigen::Matrix<double, 2, 1>> & x)\n    {\n        const long dim_0 = x.size();\n        new_x.resize(dim_0*2);\n        for (int i = 0; i < x.size(); ++i)\n        {\n            new_x.segment(2*i, 2) = x[i];\n        }\n        this->x.resize(x.size());\n        for (int i = 0; i < x.size(); ++i)\n        {\n            this->x[i] = new_x.segment(2*i, 2);\n        }\n        // E = S(x)\n        E = S(this->x);\n        // G = ∂E/∂x\n        G = gradient(E, this->new_x);\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\nS\\left( x \\right) & = \\begin{cases} \\infty & \\text{if }  x_{ 1 } \\cdot x_{ 2 } ≤ 0 \\\\ {\\left( x_{ 1 } \\cdot x_{ 2 } \\right)}^{2} & \\text{otherwise} \\end{cases} \\text{{ where }}  x_{i} ∈ \\mathbb{R}^{ 2} \\\\\nE & = S\\left( x \\right) \\\\\nG & = \\frac{\\partial E}{\\partial x} \\\\\n\\intertext{where} \nx_{i} & ∈ \\mathbb{R}^{ 2} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
