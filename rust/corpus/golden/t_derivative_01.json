  "matlab": "function output = heartlib(x)\n% output = heartlib(x)\n%\n%    S(x) = { ∞ if x_1 ⋅ x_2 ≤ 0\n%                                 (x_1 ⋅ x_2)² otherwise where x_i ∈ ℝ^2\n%                        E = S(x)\n%                        G = ∂E/∂x\n%                        where\n%                        x_i ∈ ℝ^2\n    dim_0 = size(x, 1);\n    assert( isequal(size(x), [dim_0, 2]) );\n\n    % E = S(x)\n\n    E = S(x);\n    % G = ∂E/∂x\n\n    G = ;\n    function [ret] = S(x)\n        dim_1 = size(x, 1);\n        assert( isequal(size(x), [dim_1, 2]) );\n\n        if dot(x(1,:)',x(2,:)') <= 0\n            ret = inf;\n        else\n            ret = (dot(x(1,:)',x(2,:)')).^2;\n        end\n    end\n\n    output.E = E;\n    output.G = G;\n    output.S = @S;\n    output.x = x;\nend\n",
