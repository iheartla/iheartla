 "outputs": {
  "numpy": "\"\"\"\nsin from trigonometry\n                    A = x ⋅ x + sin(x_1)\n                    G = ∂A/∂x\n                    H = ∂²A/∂x²\n                    f(y) = y ⋅ y where y ∈ ℝ^3\n                    K = ∂²f(x)/∂x²\n                    where\n                    x ∈ ℝ^3\n\"\"\"\nimport autograd.numpy as np\nimport autograd\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    _differentiating = 0  # (> 0 while the program is recomputed for a derivative)\n\n    def __init__(self, x):\n        x = np.array(x, dtype=np.float64)\n        assert x.shape == (3,)\n\n        self.x = x\n        # A = x ⋅ x + sin(x_1)\n        self.A = np.dot((x).ravel(), (x).ravel()) + np.sin(x[1-1])\n        if not type(self)._differentiating:\n            # G = ∂A/∂x\n            self.G = autograd.grad(lambda dx: self._without_derivatives(lambda: type(self)(np.reshape(dx, np.shape(x)))).A)(np.ravel(x))\n        if not type(self)._differentiating:\n            # H = ∂²A/∂x²\n            self.H = autograd.hessian(lambda dx_1: self._without_derivatives(lambda: type(self)(np.reshape(dx_1, np.shape(x)))).A)(np.ravel(x))\n        if not type(self)._differentiating:\n            # K = ∂²f(x)/∂x²\n            self.K = autograd.hessian(lambda dx_2: self.f(np.reshape(dx_2, np.shape(x))))(np.ravel(x))\n\n    def f(self, y):\n        y = np.array(y, dtype=np.float64)\n        assert y.shape == (3,)\n\n        return np.dot((y).ravel(), (y).ravel())\n    def _without_derivatives(self, make):\n        \"\"\"make(), skipping the derivatives of every instance it constructs\"\"\"\n        type(self)._differentiating += 1\n        try:\n            return make()\n        finally:\n            type(self)._differentiating -= 1\n\n\n\n\n\n",
  "eigen": "/*\nsin from trigonometry\n                    A = x ⋅ x + sin(x_1)\n                    G = ∂A/∂x\n                    H = ∂²A/∂x²\n                    f(y) = y ⋅ y where y ∈ ℝ^3\n                    K = ∂²f(x)/∂x²\n                    where\n                    x ∈ ℝ^3\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include <autodiff/reverse/var.hpp>\n#include <autodiff/reverse/var/eigen.hpp>\n#define IHEARTLA_DERIVATIVES\n#include \"type_helper.h\"\n\nusing namespace heartlang;\nstruct heartlib {\n    using DT = autodiff::var;\n    using MatrixD = Eigen::Matrix<autodiff::var, Eigen::Dynamic, Eigen::Dynamic>;\n    using VectorD = Eigen::Matrix<autodiff::var, Eigen::Dynamic, 1>;\n    DT A;\n    Eigen::Matrix<double, 3, 1> G;\n    Eigen::Matrix<double, 3, 3> H;\n    Eigen::Matrix<double, 3, 3> K;\n    Eigen::Matrix<DT, 3, 1> x;\n    template<typename REAL>\n    REAL f(\n        const Eigen::Matrix<REAL, 3, 1> & y)\n    {\n        return (y).dot(y);    \n    }\n    heartlib(const Eigen::Matrix<double, 3, 1> & x)\n    {\n    \n        this->x = x;\n        // A = x ⋅ x + sin(x_1)\n        A = (this->x).dot(this->x) + sin(this->x[1-1]);\n        // G = ∂A/∂x\n        G = gradient(A, this->x);\n        // H = ∂²A/∂x²\n        H = hessian(A, this->new_x);\n        // K = ∂²f(x)/∂x²\n        K = hessian(f((this->x).eval()), this->new_x);\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\n \\omit \\span \\text{ sin from trigonometry }\\\\\n \\\\\nA & = x \\cdot x + sin\\left( x_{ 1 } \\right) \\\\\nG & = \\frac{\\partial A}{\\partial x} \\\\\nH & = \\frac{\\partial^2A}{\\partial {x}^2} \\\\\nf\\left( y \\right) & = y \\cdot y \\text{{ where }}  y ∈ \\mathbb{R}^{ 3} \\\\\nK & = \\frac{\\partial^2f\\left( x \\right)}{\\partial {x}^2} \\\\\n\\intertext{where} \nx & ∈ \\mathbb{R}^{ 3} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
