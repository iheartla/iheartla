  "matlab": "function output = heartlib(x)\n% output = heartlib(x)\n%\n%    sin from trigonometry\n%                        A = x ⋅ x + sin(x_1)\n%                        G = ∂A/∂x\n%                        H = ∂²A/∂x²\n%                        f(y) = y ⋅ y where y ∈ ℝ^3\n%                        K = ∂²f(x)/∂x²\n%                        where\n%                        x ∈ ℝ^3\n    x = reshape(x,[],1);\n\n    assert( numel(x) == 3 );\n\n    % A = x ⋅ x + sin(x_1)\n\n    A = dot(x,x) + sin(x(1));\n    % G = ∂A/∂x\n\n    G = ;\n    % H = ∂²A/∂x²\n\n    H = ;\n    % K = ∂²f(x)/∂x²\n\n    K = ;\n    function [ret] = f(y)\n        y = reshape(y,[],1);\n        assert( numel(y) == 3 );\n\n        ret = dot(y,y);\n    end\n\n    output.A = A;\n    output.G = G;\n    output.H = H;\n    output.K = K;\n    output.f = @f;\n    output.x = x;\nend\n",
