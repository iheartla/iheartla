  "numpy": "\"\"\"\nsin from trigonometry\n                    A = t^3 + sin(t)\n                    H = ∂²A/∂t²\n                    f(s) = s^4 where s ∈ ℝ\n                    K = ∂²f(t)/∂t²\n                    where\n                    t ∈ ℝ\n\"\"\"\nimport autograd.numpy as np\nimport autograd\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    _differentiating = 0  # (> 0 while the program is recomputed for a derivative)\n\n    def __init__(self, t):\n        assert np.ndim(t) == 0\n\n        self.t = t\n        # A = t^3 + sin(t)\n        self.A = np.power(np.array(t, dtype=np.float64), 3) + np.sin(t)\n        if not type(self)._differentiating:\n            # H = ∂²A/∂t²\n            self.H = autograd.hessian(lambda dx: self._without_derivatives(lambda: type(self)(dx)).A)(t)\n        if not type(self)._differentiating:\n            # K = ∂²f(t)/∂t²\n            self.K = autograd.hessian(lambda dx_1: self.f(dx_1))(t)\n\n    def f(self, s):\n        assert np.ndim(s) == 0\n\n        return np.power(np.array(s, dtype=np.float64), 4)\n    def _without_derivatives(self, make):\n        \"\"\"make(), skipping the derivatives of every instance it constructs\"\"\"\n        type(self)._differentiating += 1\n        try:\n            return make()\n        finally:\n            type(self)._differentiating -= 1\n\n\n\n\n\n",
  "eigen": "/*\nsin from trigonometry\n                    A = t^3 + sin(t)\n                    H = ∂²A/∂t²\n                    f(s) = s^4 where s ∈ ℝ\n                    K = ∂²f(t)/∂t²\n                    where\n                    t ∈ ℝ\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include <autodiff/reverse/var.hpp>\n#include <autodiff/reverse/var/eigen.hpp>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = autodiff::var;\n    using MatrixD = Eigen::Matrix<autodiff::var, Eigen::Dynamic, Eigen::Dynamic>;\n    using VectorD = Eigen::Matrix<autodiff::var, Eigen::Dynamic, 1>;\n    DT A;\n    double H;\n    double K;\n    DT t;\n    template<typename REAL>\n    REAL f(\n        const REAL & s)\n    {\n        return pow(s, 4);    \n    }\n    heartlib(const double & t)\n    {\n    \n        this->t = t;\n        // A = t^3 + sin(t)\n        A = pow(this->t, 3) + sin(this->t);\n        // H = ∂²A/∂t²\n        H = [&](){ auto d = derivativesx(A, wrt(this->t)); return double(derivatives(d[0], wrt(this->t))[0]); }();\n        // K = ∂²f(t)/∂t²\n        K = [&](){ auto d = derivativesx(f(this->t), wrt(this->t)); return double(derivatives(d[0], wrt(this->t))[0]); }();\n    }\n};\n\n\n\n\n\n",
