 "outputs": {
  "numpy": "\"\"\"\nf( M ) + f(N)\n                    where\n                    M: ℝ^( m×m )\n                    N: ℝ^( m×m )\n                    f: ℝ^( k×k ) -> ℝ^( k×k )  \n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, M, N, f):\n        M = np.asarray(M, dtype=np.float64)\n        N = np.asarray(N, dtype=np.float64)\n        m = M.shape[1]\n        assert M.shape == (m, m)\n        assert N.shape == (m, m)\n        self.ret = f(M) + f(N)\n\n\n\n\n\n",
  "eigen": "/*\nf( M ) + f(N)\n                    where\n                    M: ℝ^( m×m )\n                    N: ℝ^( m×m )\n                    f: ℝ^( k×k ) -> ℝ^( k×k )  \n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    MatrixD ret;\n\n    heartlib(\n        const Eigen::MatrixXd & M,\n        const Eigen::MatrixXd & N,\n        const std::function<Eigen::MatrixXd(Eigen::MatrixXd)> & f)\n    {\n        const long m = M.cols();\n        assert( M.rows() == m );\n        assert( N.rows() == m );\n        assert( N.cols() == m );\n        ret = f(M) + f(N);\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\n \\omit \\span f\\left( M \\right) + f\\left( N \\right) \\\\\n\\intertext{where} \nM & : \\mathbb{R}^{ m \\times m } \\\\\nN & : \\mathbb{R}^{ m \\times m } \\\\\nf & : \\mathbb{R}^{ k \\times k }\\rightarrow \\mathbb{R}^{ k \\times k } \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n & f\\left( M \\right) + f\\left( N \\right) \\\\\nwhere \\\\\nM & : \\mathbb{R}^{ m \\times m } \\\\\nN & : \\mathbb{R}^{ m \\times m } \\\\\nf & : \\mathbb{R}^{ k \\times k }\\rightarrow \\mathbb{R}^{ k \\times k } \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(M, N, f)\n% output = heartlib(M, N, f)\n%\n%    f( M ) + f(N)\n%                        where\n%                        M: ℝ^( m×m )\n%                        N: ℝ^( m×m )\n%                        f: ℝ^( k×k ) -> ℝ^( k×k )  \n    m = size(M, 2);\n    assert( isequal(size(M), [m, m]) );\n    assert( isequal(size(N), [m, m]) );\n\n    ret = f(M) + f(N);\n    output.ret = ret;\nend\n",
