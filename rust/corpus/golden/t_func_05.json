 "outputs": {
  "numpy": "\"\"\"\nA = P f(2)\n                    where\n                    P: ℝ ^(2×2): a matrix\n                    f: scalar -> ℝ^(2 × 2): a function\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, P, f):\n        P = np.asarray(P, dtype=np.float64)\n        assert P.shape == (2, 2)\n        # A = P f(2)\n        self.A = P @ f(2)\n\n\n\n\n\n",
  "eigen": "/*\nA = P f(2)\n                    where\n                    P: ℝ ^(2×2): a matrix\n                    f: scalar -> ℝ^(2 × 2): a function\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    Eigen::Matrix<DT, 2, 2> A;\n\n    heartlib(\n        const Eigen::Matrix<double, 2, 2> & P,\n        const std::function<Eigen::Matrix<double, 2, 2>(double)> & f)\n    {\n    \n        // A = P f(2)\n        A = P * f(DT(2));\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\nA & = P f\\left( 2 \\right) \\\\\n\\intertext{where} \nP & : \\mathbb{R}^{ 2 \\times 2 } \\text{ a matrix} \\\\\nf & : \\mathbb{R}\\rightarrow \\mathbb{R}^{ 2 \\times 2 } \\text{ a function} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\nA & = P f\\left( 2 \\right) \\\\\nwhere \\\\\nP & : \\mathbb{R}^{ 2 \\times 2 } \\text{ a matrix} \\\\\nf & : \\mathbb{R}\\rightarrow \\mathbb{R}^{ 2 \\times 2 } \\text{ a function} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(P, f)\n% output = heartlib(P, f)\n%\n%    A = P f(2)\n%                        where\n%                        P: ℝ ^(2×2): a matrix\n%                        f: scalar -> ℝ^(2 × 2): a function\n    assert( isequal(size(P), [2, 2]) );\n\n    % A = P f(2)\n\n    A = P * f(2);\n    output.A = A;\nend\n",
  "macromathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'A', 'heartlib', 'def', false, '')\", \"id\":\"heartlib-A\", \"sym\":\"A\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"def\", \"case\":\"equation\"} }{ {A} } & = \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'P', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-P\", \"sym\":\"P\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {P} } \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'f', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-f\", \"sym\":\"f\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {f} }\\left( 2 \\right)\\\\\\eqlabel{ {\"onclick\":\"event.stopPropagation(); onClickEq(this, 'heartlib', ['P', 'f', 'A'], false, [], [], 'QSA9IFAgZigyKQ==');\"} }{}\n \\\\\nwhere \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'P', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-P\", \"sym\":\"P\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {P} } & : \\mathbb{R}^{ 2 \\times 2 } \\text{ a matrix} \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'f', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-f\", \"sym\":\"f\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {f} } & : \\mathbb{R}\\rightarrow \\mathbb{R}^{ 2 \\times 2 } \\text{ a function} \\\\\n\\\\\n\\end{align*}\n"
