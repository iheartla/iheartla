 "outputs": {
  "numpy": "\"\"\"\nA = Pf(P+f(f(P⋅P))P)\n                    where\n                    P: ℝ ^ (2 × 2): a matrix\n                    f: ℝ^(2 × 2) -> ℝ^(2 × 2): a function\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, P, f):\n        P = np.asarray(P, dtype=np.float64)\n        assert P.shape == (2, 2)\n        # A = Pf(P+f(f(P⋅P))P)\n        self.A = P @ f(P + f(f(P @ P)) @ P)\n\n\n\n\n\n",
  "eigen": "/*\nA = Pf(P+f(f(P⋅P))P)\n                    where\n                    P: ℝ ^ (2 × 2): a matrix\n                    f: ℝ^(2 × 2) -> ℝ^(2 × 2): a function\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    Eigen::Matrix<DT, 2, 2> A;\n\n    heartlib(\n        const Eigen::Matrix<double, 2, 2> & P,\n        const std::function<Eigen::Matrix<double, 2, 2>(Eigen::Matrix<double, 2, 2>)> & f)\n    {\n    \n        // A = Pf(P+f(f(P⋅P))P)\n        A = P * f((P + f((f((P * P).eval())).eval()) * P).eval());\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\nA & = P f\\left( P + f\\left( f\\left( P \\cdot P \\right) \\right) P \\right) \\\\\n\\intertext{where} \nP & : \\mathbb{R}^{ 2 \\times 2 } \\text{ a matrix} \\\\\nf & : \\mathbb{R}^{ 2 \\times 2 }\\rightarrow \\mathbb{R}^{ 2 \\times 2 } \\text{ a function} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\nA & = P f\\left( P + f\\left( f\\left( P \\cdot P \\right) \\right) P \\right) \\\\\nwhere \\\\\nP & : \\mathbb{R}^{ 2 \\times 2 } \\text{ a matrix} \\\\\nf & : \\mathbb{R}^{ 2 \\times 2 }\\rightarrow \\mathbb{R}^{ 2 \\times 2 } \\text{ a function} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(P, f)\n% output = heartlib(P, f)\n%\n%    A = Pf(P+f(f(P⋅P))P)\n%                        where\n%                        P: ℝ ^ (2 × 2): a matrix\n%                        f: ℝ^(2 × 2) -> ℝ^(2 × 2): a function\n    assert( isequal(size(P), [2, 2]) );\n\n    % A = Pf(P+f(f(P⋅P))P)\n\n    A = P * f(P + f(f(P * P)) * P);\n    output.A = A;\nend\n",
