 "outputs": {
  "numpy": "\"\"\"\naₘ(f) = f where f,m ∈ ℤ^3\n                    aₘ(f) = f where f,m ∈ ℤ^(3×1)\n                    d = a((1,2,3), (2,3,4))\n                    \n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, ):\n        # d = a((1,2,3), (2,3,4))\n        self.d = self.a(np.hstack((1, 2, 3)), np.hstack((2, 3, 4)))\n\n    def a(self, m, f):\n        m = np.asarray(m, dtype=np.int64)\n        f = np.asarray(f, dtype=np.int64)\n        assert m.shape == (3,)\n        assert f.shape == (3,)\n\n        return f\n\n    def a_0(self, m, f):\n        m = np.asarray(m, dtype=np.int64)\n        f = np.asarray(f, dtype=np.int64)\n        assert m.shape == (3, 1)\n        assert f.shape == (3, 1)\n\n        return f\n\n\n\n\n\n",
  "eigen": "/*\naₘ(f) = f where f,m ∈ ℤ^3\n                    aₘ(f) = f where f,m ∈ ℤ^(3×1)\n                    d = a((1,2,3), (2,3,4))\n                    \n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    Eigen::Matrix<int, 3, 1> d;\n\n    Eigen::Matrix<int, 3, 1> a(\n        const Eigen::Matrix<int, 3, 1> & m,\n        const Eigen::Matrix<int, 3, 1> & f)\n    {\n        return f;    \n    }\n    Eigen::Matrix<int, 3, 1> a_0(\n        const Eigen::Matrix<int, 3, 1> & m,\n        const Eigen::Matrix<int, 3, 1> & f)\n    {\n        return f;    \n    }\n    heartlib()\n    {\n    \n        // d = a((1,2,3), (2,3,4))\n        Eigen::Matrix<int, 3, 1> d_0;\n        d_0 << 1, 2, 3;\n        Eigen::Matrix<int, 3, 1> d_1;\n        d_1 << 2, 3, 4;\n        d = a((d_0).eval(), (d_1).eval());\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\na_{m}\\left( f \\right) & = f \\text{{ where }}  f,m ∈ \\mathbb{Z}^{ 3} \\\\\na_{m}\\left( f \\right) & = f \\text{{ where }}  f,m ∈ \\mathbb{Z}^{ 3 \\times 1 } \\\\\nd & = a\\left( \\begin{pmatrix}\n1\\\\2\\\\3\\end{pmatrix},\\begin{pmatrix}\n2\\\\3\\\\4\\end{pmatrix} \\right) \\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n & a_{m}\\left( f \\right) & = f \\text{{ where }}  f,m ∈ \\mathbb{Z}^{ 3} \\\\\n & a_{m}\\left( f \\right) & = f \\text{{ where }}  f,m ∈ \\mathbb{Z}^{ 3 \\times 1 } \\\\\nd & = a\\left( \\begin{pmatrix}\n1\\\\2\\\\3\\end{pmatrix},\\begin{pmatrix}\n2\\\\3\\\\4\\end{pmatrix} \\right) \\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib()\n% output = heartlib()\n%\n%    aₘ(f) = f where f,m ∈ ℤ^3\n%                        aₘ(f) = f where f,m ∈ ℤ^(3×1)\n%                        d = a((1,2,3), (2,3,4))\n%                        \n    % d = a((1,2,3), (2,3,4))\n\n    d = a([1; 2; 3], [2; 3; 4]);\n    function [ret] = a(m, f)\n        m = reshape(m,[],1);\n        f = reshape(f,[],1);\n        assert( numel(m) == 3 );\n        assert( numel(f) == 3 );\n\n        ret = f;\n    end\n\n    function [ret_1] = a_0(m, f)\n        assert( isequal(size(m), [3, 1]) );\n        assert( isequal(size(f), [3, 1]) );\n\n        ret_1 = f;\n    end\n\n    output.d = d;\n    output.a = @a;\n    output.a_0 = @a_0;\nend\n",
