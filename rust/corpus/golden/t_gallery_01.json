 "outputs": {
  "numpy": "\"\"\"\nsin, cos from trigonometry\n        `x(θ, ϕ)` = [Rcos(θ)cos(ϕ)\n                     Rsin(θ)cos(ϕ)\n                     Rsin(ϕ)]\n        where\n        ϕ: ℝ : angle between 0 and 2π\n        θ: ℝ : angle between -π/2 and π/2\n        R: ℝ : the radius of the sphere\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, ϕ, θ, R):\n        assert np.ndim(ϕ) == 0\n        assert np.ndim(θ) == 0\n        assert np.ndim(R) == 0\n        # `x(θ, ϕ)` = [Rcos(θ)cos(ϕ)\n        #                      Rsin(θ)cos(ϕ)\n        #                      Rsin(ϕ)]\n        xθ_comma_ϕ_0 = np.zeros((3, 1))\n        xθ_comma_ϕ_0[0] = [R * np.cos(θ) * np.cos(ϕ)]\n        xθ_comma_ϕ_0[1] = [R * np.sin(θ) * np.cos(ϕ)]\n        xθ_comma_ϕ_0[2] = [R * np.sin(ϕ)]\n        self.xθ_comma_ϕ = xθ_comma_ϕ_0\n\n\n\n\n\n",
  "eigen": "/*\nsin, cos from trigonometry\n        `x(θ, ϕ)` = [Rcos(θ)cos(ϕ)\n                     Rsin(θ)cos(ϕ)\n                     Rsin(ϕ)]\n        where\n        ϕ: ℝ : angle between 0 and 2π\n        θ: ℝ : angle between -π/2 and π/2\n        R: ℝ : the radius of the sphere\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    Eigen::Matrix<DT, 3, 1> xθ_comma_ϕ;\n\n    heartlib(\n        const double & ϕ,\n        const double & θ,\n        const double & R)\n    {\n    \n        // `x(θ, ϕ)` = [Rcos(θ)cos(ϕ)\n        //                      Rsin(θ)cos(ϕ)\n        //                      Rsin(ϕ)]\n        Eigen::Matrix<DT, 3, 1> xθ_comma_ϕ_0;\n        xθ_comma_ϕ_0 << R * cos(θ) * cos(ϕ),\n        R * sin(θ) * cos(ϕ),\n        R * sin(ϕ);\n        xθ_comma_ϕ = xθ_comma_ϕ_0;\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\n \\omit \\span \\text{ sin, cos from trigonometry }\\\\\n \\\\\nx(θ, ϕ) & = \\begin{bmatrix}\nR cos\\left( θ \\right) cos\\left( ϕ \\right)\\\\\nR sin\\left( θ \\right) cos\\left( ϕ \\right)\\\\\nR sin\\left( ϕ \\right)\\\\\n\\end{bmatrix} \\\\\n\\intertext{where} \nϕ & : \\mathbb{R} \\text{ angle between 0 and 2π} \\\\\nθ & : \\mathbb{R} \\text{ angle between -π/2 and π/2} \\\\\nR & : \\mathbb{R} \\text{ the radius of the sphere} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n & \\text{ sin, cos from trigonometry }\\\\\n \\\\\nx(θ, ϕ) & = \\begin{bmatrix}\nR cos\\left( θ \\right) cos\\left( ϕ \\right)\\\\\nR sin\\left( θ \\right) cos\\left( ϕ \\right)\\\\\nR sin\\left( ϕ \\right)\\\\\n\\end{bmatrix} \\\\\nwhere \\\\\nϕ & : \\mathbb{R} \\text{ angle between 0 and 2π} \\\\\nθ & : \\mathbb{R} \\text{ angle between -π/2 and π/2} \\\\\nR & : \\mathbb{R} \\text{ the radius of the sphere} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(phi, theta, R)\n% output = heartlib(ϕ, θ, R)\n%\n%    sin, cos from trigonometry\n%            `x(θ, ϕ)` = [Rcos(θ)cos(ϕ)\n%                         Rsin(θ)cos(ϕ)\n%                         Rsin(ϕ)]\n%            where\n%            ϕ: ℝ : angle between 0 and 2π\n%            θ: ℝ : angle between -π/2 and π/2\n%            R: ℝ : the radius of the sphere\n    assert(numel(phi) == 1);\n    assert(numel(theta) == 1);\n    assert(numel(R) == 1);\n\n    % `x(θ, ϕ)` = [Rcos(θ)cos(ϕ)\n    %                      Rsin(θ)cos(ϕ)\n    %                      Rsin(ϕ)]\n\n    xtheta_phi_0 = zeros(3, 1);\n    xtheta_phi_0(1,:) = [R * cos(theta) * cos(phi)];\n    xtheta_phi_0(2,:) = [R * sin(theta) * cos(phi)];\n    xtheta_phi_0(3,:) = [R * sin(phi)];\n    xtheta_phi = xtheta_phi_0;\n    output.xtheta_phi = xtheta_phi;\nend\n",
  "macromathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n & \\text{ sin, cos from trigonometry }\\\\\n \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'x(θ, ϕ)', 'heartlib', 'def', false, '')\", \"id\":\"heartlib-x(θ, ϕ)\", \"sym\":\"x(θ, ϕ)\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"def\", \"case\":\"equation\"} }{ {x(θ, ϕ)} } & = \\begin{bmatrix}\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'R', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-R\", \"sym\":\"R\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {R} } cos\\left( \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'θ', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-θ\", \"sym\":\"θ\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {θ} } \\right) cos\\left( \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'ϕ', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-ϕ\", \"sym\":\"ϕ\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {ϕ} } \\right)\\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'R', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-R\", \"sym\":\"R\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {R} } sin\\left( \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'θ', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-θ\", \"sym\":\"θ\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {θ} } \\right) cos\\left( \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'ϕ', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-ϕ\", \"sym\":\"ϕ\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {ϕ} } \\right)\\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'R', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-R\", \"sym\":\"R\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {R} } sin\\left( \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'ϕ', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-ϕ\", \"sym\":\"ϕ\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {ϕ} } \\right)\\\\\n\\end{bmatrix}\\\\\\eqlabel{ {\"onclick\":\"event.stopPropagation(); onClickEq(this, 'heartlib', ['R', 'θ', 'ϕ', 'x(θ, ϕ)'], false, [], [], 'YHgozrgsIM-VKWAgPSBbUmNvcyjOuCljb3Moz5UpCiAgICAgICAgICAgICAgICAgICAgIFJzaW4ozrgpY29zKM-VKQogICAgICAgICAgICAgICAgICAgICBSc2luKM-VKV0=');\"} }{}\n \\\\\nwhere \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'ϕ', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-ϕ\", \"sym\":\"ϕ\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {ϕ} } & : \\mathbb{R} \\text{ angle between 0 and 2π} \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'θ', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-θ\", \"sym\":\"θ\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {θ} } & : \\mathbb{R} \\text{ angle between -π/2 and π/2} \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'R', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-R\", \"sym\":\"R\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {R} } & : \\mathbb{R} \\text{ the radius of the sphere} \\\\\n\\\\\n\\end{align*}\n"
