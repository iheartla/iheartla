 "outputs": {
  "numpy": "\"\"\"\nmin_(x ∈ ℝ^n) ∑_i ||A_i x + b_i ||_2 +(1/2)||x-`x₀`||^2_2\n        where\n        A_i: ℝ^(m × n)\n        `x₀`: ℝ^n\n        b_i: ℝ^m  \n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, A, x0, b):\n        A = np.asarray(A, dtype=np.float64)\n        x0 = np.asarray(x0, dtype=np.float64)\n        b = np.asarray(b, dtype=np.float64)\n        dim_0 = A.shape[0]\n        m = A.shape[1]\n        n = A.shape[2]\n        assert A.shape == (dim_0, m, n)\n        assert x0.shape == (n,)\n        assert b.shape == (dim_0, m, )\n\n        self.A = A\n        self.b = b\n        self.x0 = x0\n        def pack(x):\n            return np.concatenate([x])\n        def unpack(X):\n            return X[0:n]\n        def target(X):\n            x = unpack(X)\n            sum_0 = 0\n            for i in range(1, len(A)+1):\n                sum_0 += np.linalg.norm(A[i-1] @ x + b[i-1], 2)\n            return sum_0 + ((1) / (2)) * np.power(np.asarray(np.linalg.norm(x - x0, 2), dtype=np.float64), 2)\n        opt = minimize(target, np.zeros(n))\n        x = unpack(opt.x)\n        self.ret = opt.fun\n        self.x = x\n\n\n\n\n\n",
  "eigen": "/*\nmin_(x ∈ ℝ^n) ∑_i ||A_i x + b_i ||_2 +(1/2)||x-`x₀`||^2_2\n        where\n        A_i: ℝ^(m × n)\n        `x₀`: ℝ^n\n        b_i: ℝ^m  \n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include <LBFGS.h>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    DT ret;\n    std::vector<Eigen::MatrixXd> A;\n    std::vector<Eigen::VectorXd> b;\n    Eigen::VectorXd x0;\n    heartlib(\n        const std::vector<Eigen::MatrixXd> & A,\n        const Eigen::VectorXd & x0,\n        const std::vector<Eigen::VectorXd> & b)\n    {\n        const long dim_0 = A.size();\n        const long m = A[0].rows();\n        const long n = A[0].cols();\n        assert( A.size() == dim_0 );\n        for( const auto& el : A ) {\n            assert( el.rows() == m );\n            assert( el.cols() == n );\n        }\n        assert( x0.size() == n );\n        assert( b.size() == dim_0 );\n        for( const auto& el : b ) {\n            assert( el.size() == m );\n        }\n        this->A = A;\n        this->b = b;\n        this->x0 = x0;\n        auto pack = [&](VectorD & x)\n        {\n            VectorD vec_joined(n);\n            vec_joined << x;\n            return vec_joined;\n        };\n        auto unpack = [&](VectorD & X, VectorD & x)\n        {\n            x = X(Eigen::seqN(0, n));\n        };\n        LBFGSpp::LBFGSParam<DT> param;\n        param.epsilon = 1e-6;\n        param.max_iterations = 100;\n        LBFGSpp::LBFGSSolver<DT> solver(param); \n        auto target = [&](VectorD & X)\n        {\n            VectorD x;\n            unpack(X, x);\n            DT sum_0 = 0;\n            for(int i=1; i<=A.size(); i++){\n                sum_0 += (A.at(i-1) * x + b.at(i-1)).template lpNorm<2>();\n            }\n            return sum_0 + (1 / DT(2)) * pow((x - x0).template lpNorm<2>(), 2);\n        };\n        double eps = 1e-6;\n        auto helper = [&](VectorD & X, VectorD & grad)\n        {\n            double f_X = target(X);\n            for(int i = 0; i < grad.size(); ++i )\n            {\n                const double X_i = X[i];\n                X[i] += eps;\n                grad[i] = (target(X) - f_X)/eps;\n                X[i] = X_i;\n            }\n            return f_X;\n        };\n        VectorD init = VectorD::Zero(n);\n        double fx;\n        ret = solver.minimize(helper, init, fx);\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\n \\omit \\span \\begin{aligned} \\min_{x  \\in \\mathbb{R}^{ n}} \\quad & \\sum_{i} \\left\\|A_{ i } x + b_{ i }\\right\\|_2 + \\left( \\frac{1}{2} \\right) \\left\\|x - x₀\\right\\|_2^{2} \\\\\n\\end{aligned} \\\\\n\\intertext{where} \nA_{i} & : \\mathbb{R}^{ m \\times n } \\\\\nx₀ & : \\mathbb{R}^{ n} \\\\\nb_{i} & : \\mathbb{R}^{ m} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n & \\begin{aligned} \\min_{x  \\in \\mathbb{R}^{ n}} \\quad & \\sum_{i} \\left\\|A_{ i } x + b_{ i }\\right\\|_2 + \\left( \\frac{1}{2} \\right) \\left\\|x - x₀\\right\\|_2^{2} \\\\\n\\end{aligned} \\\\\nwhere \\\\\nA_{i} & : \\mathbb{R}^{ m \\times n } \\\\\nx₀ & : \\mathbb{R}^{ n} \\\\\nb_{i} & : \\mathbb{R}^{ m} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(A, x0, b)\n% output = heartlib(A, `x₀`, b)\n%\n%    min_(x ∈ ℝ^n) ∑_i ||A_i x + b_i ||_2 +(1/2)||x-`x₀`||^2_2\n%            where\n%            A_i: ℝ^(m × n)\n%            `x₀`: ℝ^n\n%            b_i: ℝ^m  \n    x0 = reshape(x0,[],1);\n\n    dim_0 = size(A, 1);\n    m = size(A, 2);\n    n = size(A, 3);\n    assert( isequal(size(A), [dim_0, m, n]) );\n    assert( numel(x0) == n );\n    assert( isequal(size(b), [dim_0, m]) );\n\n    x = optimvar('x', n);\n    function ret = target(x)\n        sum_0 = 0;\n        for i = 1:size(A, 1)\n            sum_0 = sum_0 + norm(squeeze(A(i,:,:)) * x + b(i,:)', 2);\n        end\n        ret = sum_0 + (1 / 2) * norm(x - x0, 2).^2;\n    end\n    [~, optimize] = fminunc(@target,zeros(n,1));\n    ret = optimize;\n    output.ret = ret;\n    output.A = A;    \n    output.b = b;    \n    output.x0 = x0;\nend\n",
  "macromathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n & \\begin{aligned} \\min_{x  \\in \\mathbb{R}^{ n}} \\quad & \\sum_{i} \\left\\|\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'A', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-A\", \"sym\":\"A\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {A} }_{ i } \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'x', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-x\", \"sym\":\"x\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {x} } + \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'b', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-b\", \"sym\":\"b\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {b} }_{ i }\\right\\|_2 + \\left( \\frac{1}{2} \\right) \\left\\|\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'x', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-x\", \"sym\":\"x\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {x} } - \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'x₀', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-x₀\", \"sym\":\"x₀\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {x₀} }\\right\\|_2^{2} \\\\\n\\end{aligned}\\\\\\eqlabel{ {\"onclick\":\"event.stopPropagation(); onClickEq(this, 'heartlib', ['A', 'b', 'x₀', 'x'], false, [], [], 'bWluXyh4IOKIiCDihJ1ebikg4oiRX2kgfHxBX2kgeCArIGJfaSB8fF8yICsoMS8yKXx8eC1geOKCgGB8fF4yXzI=', false);\"} }{}\n \\\\\nwhere \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'A', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-A_i\", \"sym\":\"A\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {A} }_{i} & : \\mathbb{R}^{ \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'm', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-m\", \"sym\":\"m\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {m} } \\times \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'n', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-n\", \"sym\":\"n\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {n} } } \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'x₀', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-x₀\", \"sym\":\"x₀\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {x₀} } & : \\mathbb{R}^{ \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'n', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-n\", \"sym\":\"n\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {n} }} \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'b', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-b_i\", \"sym\":\"b\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {b} }_{i} & : \\mathbb{R}^{ \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'm', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-m\", \"sym\":\"m\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {m} }} \\\\\n\\\\\n\\end{align*}\n"
