 "outputs": {
  "numpy": "\"\"\"\n`T₁` = 1/sqrt(2)U[0 0 0\n                  0 0 -1\n                  0 1 0]Vᵀ\n        where\n        U: ℝ^(3×3)\n        V: ℝ^(3×3)\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, U, V):\n        U = np.asarray(U, dtype=np.float64)\n        V = np.asarray(V, dtype=np.float64)\n        assert U.shape == (3, 3)\n        assert V.shape == (3, 3)\n        # `T₁` = 1/sqrt(2)U[0 0 0\n        #                   0 0 -1\n        #                   0 1 0]Vᵀ\n        T1_0 = np.zeros((3, 3))\n        T1_0[0] = [0, 0, 0]\n        T1_0[1] = [0, 0, -1]\n        T1_0[2] = [0, 1, 0]\n        self.T1 = (1) / (np.sqrt(2)) * U @ T1_0 @ V.T\n\n\n\n\n\n",
