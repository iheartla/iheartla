onclick\":\"event.stopPropagation(); onClickEq(this, 'heartlib', ['e₁', 'e₂', 'k₁', 'k₂', 'Ω'], false, [], [], 'zqkgPSBbYGXigoFgIGBl4oKCYF1bYGvigoFgICAgMAogICAgICAgICAgICAgICAgIDAgICAgYGvigoJgXSBbYGXigoFg4bWACgkJCSAgICAgICAgICAgICAgICAgYGXigoJg4bWAXQ==');\"} }{}\n \\\\\nwhere \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'k₁', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-k₁\", \"sym\":\"k₁\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {k₁} } & : \\mathbb{R} \\text{ control the desired kernel variance in either edge or orthogonal direction} \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'k₂', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-k₂\", \"sym\":\"k₂\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {k₂} } & : \\mathbb{R} \\text{ control the desired kernel variance in either edge or orthogonal direction} \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'e₁', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-e₁\", \"sym\":\"e₁\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {e₁} } & : \\mathbb{R}^{ 3} \\text{ orthogonal direction vectors} \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'e₂', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-e₂\", \"sym\":\"e₂\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {e₂} } & : \\mathbb{R}^{ 3} \\text{ orthogonal direction vectors} \\\\\n\\\\\n\\end{align*}\n"
