  "numpy": "\"\"\"\nΩ = [`e₁` `e₂`][`k₁`   0\n                 0    `k₂`] [`e₁`ᵀ\n\t\t\t                 `e₂`ᵀ]\n        where\n        `k₁`: ℝ  : control the desired kernel variance in either edge or orthogonal direction\n        `k₂`: ℝ  : control the desired kernel variance in either edge or orthogonal direction\n        `e₁`: ℝ ^ 3: orthogonal direction vectors\n        `e₂`: ℝ ^ 3: orthogonal direction vectors\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, k1, k2, e1, e2):\n        e1 = np.asarray(e1, dtype=np.float64)\n        e2 = np.asarray(e2, dtype=np.float64)\n        assert np.ndim(k1) == 0\n        assert np.ndim(k2) == 0\n        assert e1.shape == (3,)\n        assert e2.shape == (3,)\n        # Ω = [`e₁` `e₂`][`k₁`   0\n        #                  0    `k₂`] [`e₁`ᵀ\n        # \t\t\t                 `e₂`ᵀ]\n        Ω_0 = np.hstack(((e1).reshape(3, 1), (e2).reshape(3, 1)))\n        Ω_1 = np.zeros((2, 2))\n        Ω_1[0] = [k1, 0]\n        Ω_1[1] = [0, k2]\n        Ω_2 = np.vstack((e1.T.reshape(1, 3), e2.T.reshape(1, 3)))\n        self.Ω = Ω_0 @ Ω_1 @ Ω_2\n\n\n\n\n\n",
  "eigen": "/*\nΩ = [`e₁` `e₂`][`k₁`   0\n                 0    `k₂`] [`e₁`ᵀ\n\t\t\t                 `e₂`ᵀ]\n        where\n        `k₁`: ℝ  : control the desired kernel variance in either edge or orthogonal direction\n        `k₂`: ℝ  : control the desired kernel variance in either edge or orthogonal direction\n        `e₁`: ℝ ^ 3: orthogonal direction vectors\n        `e₂`: ℝ ^ 3: orthogonal direction vectors\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    Eigen::Matrix<DT, 3, 3> Ω;\n\n    heartlib(\n        const double & k1,\n        const double & k2,\n        const Eigen::Matrix<double, 3, 1> & e1,\n        const Eigen::Matrix<double, 3, 1> & e2)\n    {\n    \n        // Ω = [`e₁` `e₂`][`k₁`   0\n        //                  0    `k₂`] [`e₁`ᵀ\n        // \t\t\t                 `e₂`ᵀ]\n        Eigen::Matrix<DT, 3, 2> Ω_0;\n        Ω_0 << e1, e2;\n        Eigen::Matrix<DT, 2, 2> Ω_1;\n        Ω_1 << k1, 0,\n        0, k2;\n        Eigen::Matrix<DT, 2, 3> Ω_2;\n        Ω_2 << e1.transpose(),\n        e2.transpose();\n        Ω = Ω_0 * Ω_1 * Ω_2;\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\nΩ & = \\begin{bmatrix}\ne₁ & e₂\\\\\n\\end{bmatrix} \\begin{bmatrix}\nk₁ & 0\\\\\n0 & k₂\\\\\n\\end{bmatrix} \\begin{bmatrix}\n{e₁}^T\\\\\n{e₂}^T\\\\\n\\end{bmatrix} \\\\\n\\intertext{where} \nk₁ & : \\mathbb{R} \\text{ control the desired kernel variance in either edge or orthogonal direction} \\\\\nk₂ & : \\mathbb{R} \\text{ control the desired kernel variance in either edge or orthogonal direction} \\\\\ne₁ & : \\mathbb{R}^{ 3} \\text{ orthogonal direction vectors} \\\\\ne₂ & : \\mathbb{R}^{ 3} \\text{ orthogonal direction vectors} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\nΩ & = \\begin{bmatrix}\ne₁ & e₂\\\\\n\\end{bmatrix} \\begin{bmatrix}\nk₁ & 0\\\\\n0 & k₂\\\\\n\\end{bmatrix} \\begin{bmatrix}\n{e₁}^T\\\\\n{e₂}^T\\\\\n\\end{bmatrix} \\\\\nwhere \\\\\nk₁ & : \\mathbb{R} \\text{ control the desired kernel variance in either edge or orthogonal direction} \\\\\nk₂ & : \\mathbb{R} \\text{ control the desired kernel variance in either edge or orthogonal direction} \\\\\ne₁ & : \\mathbb{R}^{ 3} \\text{ orthogonal direction vectors} \\\\\ne₂ & : \\mathbb{R}^{ 3} \\text{ orthogonal direction vectors} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(k1, k2, e1, e2)\n% output = heartlib(`k₁`, `k₂`, `e₁`, `e₂`)\n%\n%    Ω = [`e₁` `e₂`][`k₁`   0\n%                     0    `k₂`] [`e₁`ᵀ\n%    \t\t\t                 `e₂`ᵀ]\n%            where\n%            `k₁`: ℝ  : control the desired kernel variance in either edge or orthogonal direction\n%            `k₂`: ℝ  : control the desired kernel variance in either edge or orthogonal direction\n%            `e₁`: ℝ ^ 3: orthogonal direction vectors\n%            `e₂`: ℝ ^ 3: orthogonal direction vectors\n    e1 = reshape(e1,[],1);\n    e2 = reshape(e2,[],1);\n\n    assert(numel(k1) == 1);\n    assert(numel(k2) == 1);\n    assert( numel(e1) == 3 );\n    assert( numel(e2) == 3 );\n\n    % Ω = [`e₁` `e₂`][`k₁`   0\n    %                  0    `k₂`] [`e₁`ᵀ\n    % \t\t\t                 `e₂`ᵀ]\n\n    Omega_0 = [[reshape(e1, [3, 1]), reshape(e2, [3, 1])]];\n    Omega_1 = zeros(2, 2);\n    Omega_1(1,:) = [k1, 0];\n    Omega_1(2,:) = [0, k2];\n    Omega_2 = [[e1']; [e2']];\n    Omega = Omega_0 * Omega_1 * Omega_2;\n    output.Omega = Omega;\nend\n",
