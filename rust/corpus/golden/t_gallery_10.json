 "outputs": {
  "numpy": "\"\"\"\nv_i = ∑_j w_i,j M_j u_i\n        where\n        w: ℝ^(4×4)\n        M_j: ℝ^(4×4)\n        u_i: ℝ^4\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, w, M, u):\n        w = np.asarray(w, dtype=np.float64)\n        M = np.asarray(M, dtype=np.float64)\n        u = np.asarray(u, dtype=np.float64)\n        dim_0 = M.shape[0]\n        dim_1 = u.shape[0]\n        assert w.shape == (4, 4)\n        assert M.shape == (dim_0, 4, 4)\n        assert u.shape == (dim_1, 4, )\n        assert 4 == dim_1 \n        # v_i = ∑_j w_i,j M_j u_i\n        self.v = np.zeros((dim_1, 4, ))\n        for i in range(1, dim_1+1):\n            sum_0 = np.zeros((4, ))\n            for j in range(1, w.shape[1]+1):\n                sum_0 += w[i-1, j-1] * M[j-1] @ u[i-1]\n            self.v[i-1] = sum_0\n\n\n\n\n\n",
  "eigen": "/*\nv_i = ∑_j w_i,j M_j u_i\n        where\n        w: ℝ^(4×4)\n        M_j: ℝ^(4×4)\n        u_i: ℝ^4\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    std::vector<Eigen::Matrix<DT, 4, 1>> v;\n\n    heartlib(\n        const Eigen::Matrix<double, 4, 4> & w,\n        const std::vector<Eigen::Matrix<double, 4, 4>> & M,\n        const std::vector<Eigen::Matrix<double, 4, 1>> & u)\n    {\n        const long dim_0 = M.size();\n        const long dim_1 = u.size();\n        assert( 4 == dim_1 );\n        // v_i = ∑_j w_i,j M_j u_i\n        v.resize(dim_1);\n        for( int i=1; i<=dim_1; i++){\n            MatrixD sum_0 = MatrixD::Zero(4, 1);\n            for(int j=1; j<=M.size(); j++){\n                sum_0 += w(i-1, j-1) * M.at(j-1) * u.at(i-1);\n            }\n            v.at(i-1) = sum_0;\n        }\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\nv_{ i } & = \\sum_{j} w_{i, j} M_{ j } u_{ i } \\\\\n\\intertext{where} \nw & : \\mathbb{R}^{ 4 \\times 4 } \\\\\nM_{j} & : \\mathbb{R}^{ 4 \\times 4 } \\\\\nu_{i} & : \\mathbb{R}^{ 4} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\nv_{ i } & = \\sum_{j} w_{i, j} M_{ j } u_{ i } \\\\\nwhere \\\\\nw & : \\mathbb{R}^{ 4 \\times 4 } \\\\\nM_{j} & : \\mathbb{R}^{ 4 \\times 4 } \\\\\nu_{i} & : \\mathbb{R}^{ 4} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(w, M, u)\n% output = heartlib(w, M, u)\n%\n%    v_i = ∑_j w_i,j M_j u_i\n%            where\n%            w: ℝ^(4×4)\n%            M_j: ℝ^(4×4)\n%            u_i: ℝ^4\n    dim_0 = size(M, 1);\n    dim_1 = size(u, 1);\n    assert( isequal(size(w), [4, 4]) );\n    assert( isequal(size(M), [dim_0, 4, 4]) );\n    assert( isequal(size(u), [dim_1, 4]) );\n    assert( 4 == dim_1 );\n\n    % v_i = ∑_j w_i,j M_j u_i\n\n    v = zeros(dim_1, 4);\n    for i = 1:dim_1\n        sum_0 = zeros(4,1);\n        for j = 1:size(M, 1)\n            sum_0 = sum_0 + w(i, j) * squeeze(M(j,:,:)) * u(i,:)';\n        end\n        v(i,:) = (sum_0)';\n    end\n    output.v = v;\nend\n",
  "macromathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'v', 'heartlib', 'def', false, '')\", \"id\":\"heartlib-v\", \"sym\":\"v\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"def\", \"case\":\"equation\"} }{ {v} }_{ i } & = \\sum_{j} \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'w', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-w\", \"sym\":\"w\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {w} }_{i, j} \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'M', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-M\", \"sym\":\"M\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {M} }_{ j } \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'u', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-u\", \"sym\":\"u\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {u} }_{ i }\\\\\\eqlabel{ {\"onclick\":\"event.stopPropagation(); onClickEq(this, 'heartlib', ['u', 'M', 'w', 'v'], false, [], [], 'dl9pID0g4oiRX2ogd19pLGogTV9qIHVfaQ==');\"} }{}\n \\\\\nwhere \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'w', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-w\", \"sym\":\"w\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {w} } & : \\mathbb{R}^{ 4 \\times 4 } \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'M', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-M_j\", \"sym\":\"M\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {M} }_{j} & : \\mathbb{R}^{ 4 \\times 4 } \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'u', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-u_i\", \"sym\":\"u\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {u} }_{i} & : \\mathbb{R}^{ 4} \\\\\n\\\\\n\\end{align*}\n"
