 "outputs": {
  "numpy": "\"\"\"\nn = ∑_T A_T||M_T v_T - [0 -1\n                        1  0] M_T u_T||²\n        where\n        v_i: ℝ^3\n        u_i: ℝ^3\n        M_i: ℝ^(2×3)\n        A_i: ℝ\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, v, u, M, A):\n        v = np.asarray(v, dtype=np.float64)\n        u = np.asarray(u, dtype=np.float64)\n        M = np.asarray(M, dtype=np.float64)\n        A = np.asarray(A, dtype=np.float64)\n        dim_0 = A.shape[0]\n        assert v.shape == (dim_0, 3, )\n        assert u.shape == (dim_0, 3, )\n        assert M.shape == (dim_0, 2, 3)\n        assert A.shape == (dim_0,)\n        # n = ∑_T A_T||M_T v_T - [0 -1\n        #                         1  0] M_T u_T||²\n        sum_0 = 0\n        for T in range(1, len(A)+1):\n            n_0 = np.zeros((2, 2))\n            n_0[0] = [0, -1]\n            n_0[1] = [1, 0]\n            sum_0 += A[T-1] * np.power(np.asarray(np.linalg.norm(M[T-1] @ v[T-1] - n_0 @ M[T-1] @ u[T-1], 2), dtype=np.float64), 2)\n        self.n = sum_0\n\n\n\n\n\n",
  "eigen": "/*\nn = ∑_T A_T||M_T v_T - [0 -1\n                        1  0] M_T u_T||²\n        where\n        v_i: ℝ^3\n        u_i: ℝ^3\n        M_i: ℝ^(2×3)\n        A_i: ℝ\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    DT n;\n\n    heartlib(\n        const std::vector<Eigen::Matrix<double, 3, 1>> & v,\n        const std::vector<Eigen::Matrix<double, 3, 1>> & u,\n        const std::vector<Eigen::Matrix<double, 2, 3>> & M,\n        const std::vector<double> & A)\n    {\n        const long dim_0 = A.size();\n        assert( v.size() == dim_0 );\n        assert( u.size() == dim_0 );\n        assert( M.size() == dim_0 );\n        // n = ∑_T A_T||M_T v_T - [0 -1\n        //                         1  0] M_T u_T||²\n        DT sum_0 = 0;\n        for(int T=1; T<=A.size(); T++){\n            Eigen::Matrix<int, 2, 2> n_0;\n            n_0 << 0, -1,\n            1, 0;\n            sum_0 += A.at(T-1) * pow((M.at(T-1) * v.at(T-1) - (n_0).template cast<DT>() * M.at(T-1) * u.at(T-1)).template lpNorm<2>(), 2);\n        }\n        n = sum_0;\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\nn & = \\sum_{T} A_{ T } \\left\\|M_{ T } v_{ T } - \\begin{bmatrix}\n0 & -1\\\\\n1 & 0\\\\\n\\end{bmatrix} M_{ T } u_{ T }\\right\\|^{2} \\\\\n\\intertext{where} \nv_{i} & : \\mathbb{R}^{ 3} \\\\\nu_{i} & : \\mathbb{R}^{ 3} \\\\\nM_{i} & : \\mathbb{R}^{ 2 \\times 3 } \\\\\nA_{i} & : \\mathbb{R} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\nn & = \\sum_{T} A_{ T } \\left\\|M_{ T } v_{ T } - \\begin{bmatrix}\n0 & -1\\\\\n1 & 0\\\\\n\\end{bmatrix} M_{ T } u_{ T }\\right\\|^{2} \\\\\nwhere \\\\\nv_{i} & : \\mathbb{R}^{ 3} \\\\\nu_{i} & : \\mathbb{R}^{ 3} \\\\\nM_{i} & : \\mathbb{R}^{ 2 \\times 3 } \\\\\nA_{i} & : \\mathbb{R} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(v, u, M, A)\n% output = heartlib(v, u, M, A)\n%\n%    n = ∑_T A_T||M_T v_T - [0 -1\n%                            1  0] M_T u_T||²\n%            where\n%            v_i: ℝ^3\n%            u_i: ℝ^3\n%            M_i: ℝ^(2×3)\n%            A_i: ℝ\n    A = reshape(A,[],1);\n\n    dim_0 = size(A, 1);\n    assert( isequal(size(v), [dim_0, 3]) );\n    assert( isequal(size(u), [dim_0, 3]) );\n    assert( isequal(size(M), [dim_0, 2, 3]) );\n    assert( size(A,1) == dim_0 );\n\n    % n = ∑_T A_T||M_T v_T - [0 -1\n    %                         1  0] M_T u_T||²\n\n    sum_0 = 0;\n    for T = 1:size(A, 1)\n        n_0 = zeros(2, 2);\n        n_0(1,:) = [0, -1];\n        n_0(2,:) = [1, 0];\n        sum_0 = sum_0 + A(T) * norm(squeeze(M(T,:,:)) * v(T,:)' - n_0 * squeeze(M(T,:,:)) * u(T,:)', 2).^2;\n    end\n    n = sum_0;\n    output.n = n;\nend\n",
  "macromathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'n', 'heartlib', 'def', false, '')\", \"id\":\"heartlib-n\", \"sym\":\"n\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"def\", \"case\":\"equation\"} }{ {n} } & = \\sum_{T} \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'A', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-A\", \"sym\":\"A\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {A} }_{ T } \\left\\|\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'M', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-M\", \"sym\":\"M\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {M} }_{ T } \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'v', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-v\", \"sym\":\"v\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {v} }_{ T } - \\begin{bmatrix}\n0 & -1\\\\\n1 & 0\\\\\n\\end{bmatrix} \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'M', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-M\", \"sym\":\"M\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {M} }_{ T } \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'u', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-u\", \"sym\":\"u\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {u} }_{ T }\\right\\|^{2}\\\\\\eqlabel{ {\"onclick\":\"event.stopPropagation(); onClickEq(this, 'heartlib', ['A', 'M', 'u', 'v', 'n'], false, [], [], 'biA9IOKIkV9UIEFfVHx8TV9UIHZfVCAtIFswIC0xCiAgICAgICAgICAgICAgICAgICAgICAgIDEgIDBdIE1fVCB1X1R8fMKy');\"} }{}\n \\\\\nwhere \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'v', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-v_i\", \"sym\":\"v\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {v} }_{i} & : \\mathbb{R}^{ 3} \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'u', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-u_i\", \"sym\":\"u\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {u} }_{i} & : \\mathbb{R}^{ 3} \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'M', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-M_i\", \"sym\":\"M\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {M} }_{i} & : \\mathbb{R}^{ 2 \\times 3 } \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'A', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-A_i\", \"sym\":\"A\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {A} }_{i} & : \\mathbb{R} \\\\\n\\\\\n\\end{align*}\n"
