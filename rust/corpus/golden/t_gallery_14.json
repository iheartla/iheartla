 "outputs": {
  "numpy": "\"\"\"\nmin_(C ∈ ℝ^3) ∑_i ||x_i + (R_i - I_3)C ||²\n        where\n        x_i: ℝ^3\n        R_i: ℝ^(3×3)\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, x, R):\n        x = np.asarray(x, dtype=np.float64)\n        R = np.asarray(R, dtype=np.float64)\n        dim_0 = x.shape[0]\n        assert x.shape == (dim_0, 3, )\n        assert R.shape == (dim_0, 3, 3)\n\n        self.x = x\n        self.R = R\n        def pack(C):\n            return np.concatenate([C])\n        def unpack(X):\n            return X[0:3]\n        def target(X):\n            C = unpack(X)\n            sum_0 = 0\n            for i in range(1, len(R)+1):\n                sum_0 += np.power(np.asarray(np.linalg.norm(x[i-1] + (R[i-1] - np.identity(3)) @ C, 2), dtype=np.float64), 2)\n            return sum_0\n        opt = minimize(target, np.zeros(3))\n        C = unpack(opt.x)\n        self.ret = opt.fun\n        self.C = C\n\n\n\n\n\n",
  "eigen": "/*\nmin_(C ∈ ℝ^3) ∑_i ||x_i + (R_i - I_3)C ||²\n        where\n        x_i: ℝ^3\n        R_i: ℝ^(3×3)\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include <LBFGS.h>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    DT ret;\n    std::vector<Eigen::Matrix<double, 3, 1>> x;\n    std::vector<Eigen::Matrix<double, 3, 3>> R;\n    heartlib(\n        const std::vector<Eigen::Matrix<double, 3, 1>> & x,\n        const std::vector<Eigen::Matrix<double, 3, 3>> & R)\n    {\n        const long dim_0 = x.size();\n        assert( R.size() == dim_0 );\n        this->x = x;\n        this->R = R;\n        auto pack = [&](Eigen::Matrix<DT, 3, 1> & C)\n        {\n            VectorD vec_joined(3);\n            vec_joined << C;\n            return vec_joined;\n        };\n        auto unpack = [&](VectorD & X, Eigen::Matrix<DT, 3, 1> & C)\n        {\n            C = X(Eigen::seqN(0, 3));\n        };\n        LBFGSpp::LBFGSParam<DT> param;\n        param.epsilon = 1e-6;\n        param.max_iterations = 100;\n        LBFGSpp::LBFGSSolver<DT> solver(param); \n        auto target = [&](VectorD & X)\n        {\n            Eigen::Matrix<DT, 3, 1> C;\n            unpack(X, C);\n            DT sum_0 = 0;\n            for(int i=1; i<=R.size(); i++){\n                sum_0 += pow((x.at(i-1) + (R.at(i-1) - MatrixD::Identity(3, 3)) * C).template lpNorm<2>(), 2);\n            }\n            return sum_0;\n        };\n        double eps = 1e-6;\n        auto helper = [&](VectorD & X, VectorD & grad)\n        {\n            double f_X = target(X);\n            for(int i = 0; i < grad.size(); ++i )\n            {\n                const double X_i = X[i];\n                X[i] += eps;\n                grad[i] = (target(X) - f_X)/eps;\n                X[i] = X_i;\n            }\n            return f_X;\n        };\n        VectorD init = VectorD::Zero(3);\n        double fx;\n        ret = solver.minimize(helper, init, fx);\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\n \\omit \\span \\begin{aligned} \\min_{C  \\in \\mathbb{R}^{ 3}} \\quad & \\sum_{i} \\left\\|x_{ i } + \\left( R_{ i } - I_{ 3 } \\right) C\\right\\|^{2} \\\\\n\\end{aligned} \\\\\n\\intertext{where} \nx_{i} & : \\mathbb{R}^{ 3} \\\\\nR_{i} & : \\mathbb{R}^{ 3 \\times 3 } \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n & \\begin{aligned} \\min_{C  \\in \\mathbb{R}^{ 3}} \\quad & \\sum_{i} \\left\\|x_{ i } + \\left( R_{ i } - I_{ 3 } \\right) C\\right\\|^{2} \\\\\n\\end{aligned} \\\\\nwhere \\\\\nx_{i} & : \\mathbb{R}^{ 3} \\\\\nR_{i} & : \\mathbb{R}^{ 3 \\times 3 } \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(x, R)\n% output = heartlib(x, R)\n%\n%    min_(C ∈ ℝ^3) ∑_i ||x_i + (R_i - I_3)C ||²\n%            where\n%            x_i: ℝ^3\n%            R_i: ℝ^(3×3)\n    dim_0 = size(x, 1);\n    assert( isequal(size(x), [dim_0, 3]) );\n    assert( isequal(size(R), [dim_0, 3, 3]) );\n\n    C = optimvar('C', 3);\n    function ret = target(C)\n        sum_0 = 0;\n        for i = 1:size(R, 1)\n            sum_0 = sum_0 + norm(x(i,:)' + (squeeze(R(i,:,:)) - speye(3)) * C, 2).^2;\n        end\n        ret = sum_0;\n    end\n    [~, optimize] = fminunc(@target,zeros(3,1));\n    ret = optimize;\n    output.ret = ret;\n    output.x = x;    \n    output.R = R;\nend\n",
  "macromathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n & \\begin{aligned} \\min_{C  \\in \\mathbb{R}^{ 3}} \\quad & \\sum_{i} \\left\\|\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'x', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-x\", \"sym\":\"x\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {x} }_{ i } + \\left( \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'R', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-R\", \"sym\":\"R\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {R} }_{ i } - I_{ 3 } \\right) \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'C', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-C\", \"sym\":\"C\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {C} }\\right\\|^{2} \\\\\n\\end{aligned}\\\\\\eqlabel{ {\"onclick\":\"event.stopPropagation(); onClickEq(this, 'heartlib', ['R', 'C', 'x'], false, [], [], 'bWluXyhDIOKIiCDihJ1eMykg4oiRX2kgfHx4X2kgKyAoUl9pIC0gSV8zKUMgfHzCsg==', false);\"} }{}\n \\\\\nwhere \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'x', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-x_i\", \"sym\":\"x\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {x} }_{i} & : \\mathbb{R}^{ 3} \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'R', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-R_i\", \"sym\":\"R\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {R} }_{i} & : \\mathbb{R}^{ 3 \\times 3 } \\\\\n\\\\\n\\end{align*}\n"
 }
