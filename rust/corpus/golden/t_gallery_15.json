 "outputs": {
  "numpy": "\"\"\"\ny_i = (a_i)ᵀ x + w_i\n        x̂ = (∑_i a_i(a_i)ᵀ)⁻¹ ∑_i y_i a_i\n        where\n        a_i: ℝ^n: the measurement vectors\n        w_i: ℝ: measurement noise\n        x: ℝ^n: measurement noise \n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, a, w, x):\n        a = np.asarray(a, dtype=np.float64)\n        w = np.asarray(w, dtype=np.float64)\n        x = np.asarray(x, dtype=np.float64)\n        dim_0 = w.shape[0]\n        n = a.shape[1]\n        assert a.shape == (dim_0, n, )\n        assert w.shape == (dim_0,)\n        assert x.shape == (n,)\n        # y_i = (a_i)ᵀ x + w_i\n        self.y = np.zeros(dim_0)\n        for i in range(1, dim_0+1):\n            self.y[i-1] = ((a[i-1]).T.reshape(1, n) @ x).item() + w[i-1]\n        # x̂ = (∑_i a_i(a_i)ᵀ)⁻¹ ∑_i y_i a_i\n        sum_0 = np.zeros((n, n))\n        for i in range(1, len(a)+1):\n            sum_0 += (a[i-1]).reshape(n, 1) @ (a[i-1]).T.reshape(1, n)\n        sum_1 = np.zeros((n, ))\n        for i in range(1, len(a)+1):\n            sum_1 += self.y[i-1] * a[i-1]\n        self.x̂ = np.linalg.solve((sum_0), sum_1)\n\n\n\n\n\n",
  "eigen": "/*\ny_i = (a_i)ᵀ x + w_i\n        x̂ = (∑_i a_i(a_i)ᵀ)⁻¹ ∑_i y_i a_i\n        where\n        a_i: ℝ^n: the measurement vectors\n        w_i: ℝ: measurement noise\n        x: ℝ^n: measurement noise \n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    VectorD y;\n    VectorD x̂;\n\n    heartlib(\n        const std::vector<Eigen::VectorXd> & a,\n        const std::vector<double> & w,\n        const Eigen::VectorXd & x)\n    {\n        const long dim_0 = w.size();\n        const long n = a[0].rows();\n        assert( a.size() == dim_0 );\n        for( const auto& el : a ) {\n            assert( el.size() == n );\n        }\n        assert( x.size() == n );\n        // y_i = (a_i)ᵀ x + w_i\n        y.resize(dim_0);\n        for( int i=1; i<=dim_0; i++){\n            y[i-1] = ((a.at(i-1)).transpose() * x).value() + w.at(i-1);\n        }\n        // x̂ = (∑_i a_i(a_i)ᵀ)⁻¹ ∑_i y_i a_i\n        MatrixD sum_0 = MatrixD::Zero(n, n);\n        for(int i=1; i<=a.size(); i++){\n            sum_0 += a.at(i-1) * (a.at(i-1)).transpose();\n        }\n        MatrixD sum_1 = MatrixD::Zero(n, 1);\n        for(int i=1; i<=a.size(); i++){\n            sum_1 += this->y[i-1] * a.at(i-1);\n        }\n        x̂ = (to_double((sum_0))).colPivHouseholderQr().solve(to_double(sum_1));\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\ny_{ i } & = {\\left( a_{ i } \\right)}^T x + w_{ i } \\\\\n\\textit{x̂} & = \\left( \\sum_{i} a_{ i } {\\left( a_{ i } \\right)}^T \\right)^{-1}\\sum_{i} y_{ i } a_{ i } \\\\\n\\intertext{where} \na_{i} & : \\mathbb{R}^{ n} \\text{ the measurement vectors} \\\\\nw_{i} & : \\mathbb{R} \\text{ measurement noise} \\\\\nx & : \\mathbb{R}^{ n} \\text{ measurement noise } \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\ny_{ i } & = {\\left( a_{ i } \\right)}^T x + w_{ i } \\\\\n\\textit{x̂} & = \\left( \\sum_{i} a_{ i } {\\left( a_{ i } \\right)}^T \\right)^{-1}\\sum_{i} y_{ i } a_{ i } \\\\\nwhere \\\\\na_{i} & : \\mathbb{R}^{ n} \\text{ the measurement vectors} \\\\\nw_{i} & : \\mathbb{R} \\text{ measurement noise} \\\\\nx & : \\mathbb{R}^{ n} \\text{ measurement noise } \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(a, w, x)\n% output = heartlib(a, w, x)\n%\n%    y_i = (a_i)ᵀ x + w_i\n%            x̂ = (∑_i a_i(a_i)ᵀ)⁻¹ ∑_i y_i a_i\n%            where\n%            a_i: ℝ^n: the measurement vectors\n%            w_i: ℝ: measurement noise\n%            x: ℝ^n: measurement noise \n    w = reshape(w,[],1);\n    x = reshape(x,[],1);\n\n    dim_0 = size(w, 1);\n    n = size(a, 2);\n    assert( isequal(size(a), [dim_0, n]) );\n    assert( size(w,1) == dim_0 );\n    assert( numel(x) == n );\n\n    % y_i = (a_i)ᵀ x + w_i\n\n    y = zeros(dim_0,1);\n    for i = 1:dim_0\n        y(i) = (a(i,:)')' * x + w(i);\n    end\n    % x̂ = (∑_i a_i(a_i)ᵀ)⁻¹ ∑_i y_i a_i\n\n    sum_0 = zeros(n, n);\n    for i = 1:size(a, 1)\n        sum_0 = sum_0 + reshape(a(i,:)', [n, 1]) * (a(i,:)')';\n    end\n    sum_1 = zeros(n,1);\n    for i = 1:size(a, 1)\n        sum_1 = sum_1 + y(i) * a(i,:)';\n    end\n    x_hat = (((sum_0))\\(sum_1));\n    output.y = y;\n    output.x_hat = x_hat;\nend\n",
  "macromathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'y', 'heartlib', 'def', false, '')\", \"id\":\"heartlib-y\", \"sym\":\"y\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"def\", \"case\":\"equation\"} }{ {y} }_{ i } & = {\\left( \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'a', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-a\", \"sym\":\"a\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {a} }_{ i } \\right)}^T \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'x', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-x\", \"sym\":\"x\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {x} } + \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'w', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-w\", \"sym\":\"w\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {w} }_{ i }\\\\\\eqlabel{ {\"onclick\":\"event.stopPropagation(); onClickEq(this, 'heartlib', ['a', 'w', 'x', 'y'], false, [], [], 'eV9pID0gKGFfaSnhtYAgeCArIHdfaQ==');\"} }{}\n \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'x̂', 'heartlib', 'def', false, '')\", \"id\":\"heartlib-x̂\", \"sym\":\"x̂\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"def\", \"case\":\"equation\"} }{ {\\textit{x̂}} } & = \\left( \\sum_{i} \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'a', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-a\", \"sym\":\"a\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {a} }_{ i } {\\left( \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'a', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-a\", \"sym\":\"a\", \"func\":\"hea