 "outputs": {
  "numpy": "\"\"\"\n`I(X;Y)` = ∑_i ∑_j x_j p_i,j log_2(p_i,j/∑_k x_k p_i,k)\n        where\n        x: ℝ^n\n        p: ℝ^(m×n)\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, x, p):\n        x = np.asarray(x, dtype=np.float64)\n        p = np.asarray(p, dtype=np.float64)\n        n = x.shape[0]\n        m = p.shape[0]\n        assert x.shape == (n,)\n        assert p.shape == (m, n)\n        # `I(X;Y)` = ∑_i ∑_j x_j p_i,j log_2(p_i,j/∑_k x_k p_i,k)\n        sum_0 = 0\n        for i in range(1, p.shape[0]+1):\n            sum_1 = 0\n            for j in range(1, p.shape[1]+1):\n                sum_2 = 0\n                for k in range(1, p.shape[1]+1):\n                    sum_2 += x[k-1] * p[i-1, k-1]\n                sum_1 += x[j-1] * p[i-1, j-1] * np.log2((p[i-1, j-1]) / (sum_2))\n            sum_0 += sum_1\n        self.IX_semicolon_Y = sum_0\n\n\n\n\n\n",
  "eigen": "/*\n`I(X;Y)` = ∑_i ∑_j x_j p_i,j log_2(p_i,j/∑_k x_k p_i,k)\n        where\n        x: ℝ^n\n        p: ℝ^(m×n)\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    DT IX_semicolon_Y;\n\n    heartlib(\n        const Eigen::VectorXd & x,\n        const Eigen::MatrixXd & p)\n    {\n        const long n = x.size();\n        const long m = p.rows();\n        assert( p.cols() == n );\n        // `I(X;Y)` = ∑_i ∑_j x_j p_i,j log_2(p_i,j/∑_k x_k p_i,k)\n        DT sum_0 = 0;\n        for(int i=1; i<=p.rows(); i++){\n            DT sum_1 = 0;\n            for(int j=1; j<=p.cols(); j++){\n                DT sum_2 = 0;\n                for(int k=1; k<=p.cols(); k++){\n                    sum_2 += x[k-1] * p(i-1, k-1);\n                }\n                sum_1 += x[j-1] * p(i-1, j-1) * (log10(p(i-1, j-1) / DT(sum_2)) / log10(2));\n            }\n            sum_0 += sum_1;\n        }\n        IX_semicolon_Y = sum_0;\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\nI(X;Y) & = \\sum_{i} \\sum_{j} x_{ j } p_{i, j}  \\log_2{ \\frac{p_{i, j}}{\\sum_{k} x_{ k } p_{i, k}} } \\\\\n\\intertext{where} \nx & : \\mathbb{R}^{ n} \\\\\np & : \\mathbb{R}^{ m \\times n } \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\nI(X;Y) & = \\sum_{i} \\sum_{j} x_{ j } p_{i, j}  \\log_2{ \\frac{p_{i, j}}{\\sum_{k} x_{ k } p_{i, k}} } \\\\\nwhere \\\\\nx & : \\mathbb{R}^{ n} \\\\\np & : \\mathbb{R}^{ m \\times n } \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(x, p)\n% output = heartlib(x, p)\n%\n%    `I(X;Y)` = ∑_i ∑_j x_j p_i,j log_2(p_i,j/∑_k x_k p_i,k)\n%            where\n%            x: ℝ^n\n%            p: ℝ^(m×n)\n    x = reshape(x,[],1);\n\n    n = size(x, 1);\n    m = size(p, 1);\n    assert( numel(x) == n );\n    assert( isequal(size(p), [m, n]) );\n\n    % `I(X;Y)` = ∑_i ∑_j x_j p_i,j log_2(p_i,j/∑_k x_k p_i,k)\n\n    sum_0 = 0;\n    for i = 1:size(p,1)\n        sum_1 = 0;\n        for j = 1:size(p,2)\n            sum_2 = 0;\n            for k = 1:size(p,2)\n                sum_2 = sum_2 + x(k) * p(i, k);\n            end\n            sum_1 = sum_1 + x(j) * p(i, j) * log2(p(i, j) / sum_2);\n        end\n        sum_0 = sum_0 + sum_1;\n    end\n    IX_semicolon_Y = sum_0;\n    output.IX_semicolon_Y = IX_semicolon_Y;\nend\n",
  "macromathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'I(X;Y)', 'heartlib', 'def', false, '')\", \"id\":\"heartlib-I(X;Y)\", \"sym\":\"I(X;Y)\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"def\", \"case\":\"equation\"} }{ {I(X;Y)} } & = \\sum_{i} \\sum_{j} \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'x', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-x\", \"sym\":\"x\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {x} }_{ j } \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'p', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-p\", \"sym\":\"p\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {p} }_{i, j}  \\log_2{ \\frac{\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'p', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-p\", \"sym\":\"p\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {p} }_{i, j}}{\\sum_{k} \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'x', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-x\", \"sym\":\"x\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {x} }_{ k } \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'p', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-p\", \"sym\":\"p\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {p} }_{i, k}} }\\\\\\eqlabel{ {\"onclick\":\"event.stopPropagation(); onClickEq(this, 'heartlib', ['p', 'x', 'I(X;Y)'], false, [], [], 'YEkoWDtZKWAgPSDiiJFfaSDiiJFfaiB4X2ogcF9pLGogbG9nXzIocF9pLGov4oiRX2sgeF9rIHBfaSxrKQ==');\"} }{}\n \\\\\nwhere \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'x', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-x\", \"sym\":\"x\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {x} } & : \\mathbb{R}^{ \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'n', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-n\", \"sym\":\"n\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {n} }} \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'p', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-p\", \"sym\":\"p\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {p} } & : \\mathbb{R}^{ \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'm', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-m\", \"sym\":\"m\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {m} } \\times \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'n', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-n\", \"sym\":\"n\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {n} } } \\\\\n\\\\\n\\end{align*}\n"
 }
