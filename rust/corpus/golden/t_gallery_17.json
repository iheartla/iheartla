 "outputs": {
  "numpy": "\"\"\"\n`L(x,v)` = xᵀWx + ∑_i v_i(x_i²-1)\n        where\n        x: ℝ^n\n        W: ℝ^(n×n)\n        v: ℝ^n\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, x, W, v):\n        x = np.asarray(x, dtype=np.float64)\n        W = np.asarray(W, dtype=np.float64)\n        v = np.asarray(v, dtype=np.float64)\n        n = x.shape[0]\n        assert x.shape == (n,)\n        assert W.shape == (n, n)\n        assert v.shape == (n,)\n        # `L(x,v)` = xᵀWx + ∑_i v_i(x_i²-1)\n        sum_0 = 0\n        for i in range(1, len(v)+1):\n            sum_0 += v[i-1] * (np.power(np.asarray(x[i-1], dtype=np.float64), 2) - 1)\n        self.Lx_comma_v = (x.T.reshape(1, n) @ W @ x).item() + sum_0\n\n\n\n\n\n",
  "eigen": "/*\n`L(x,v)` = xᵀWx + ∑_i v_i(x_i²-1)\n        where\n        x: ℝ^n\n        W: ℝ^(n×n)\n        v: ℝ^n\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    DT Lx_comma_v;\n\n    heartlib(\n        const Eigen::VectorXd & x,\n        const Eigen::MatrixXd & W,\n        const Eigen::VectorXd & v)\n    {\n        const long n = x.size();\n        assert( W.rows() == n );\n        assert( W.cols() == n );\n        assert( v.size() == n );\n        // `L(x,v)` = xᵀWx + ∑_i v_i(x_i²-1)\n        DT sum_0 = 0;\n        for(int i=1; i<=v.size(); i++){\n            sum_0 += v[i-1] * (pow(x[i-1], 2) - 1);\n        }\n        Lx_comma_v = (x.transpose() * W * x).value() + sum_0;\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\nL(x,v) & = {x}^T W x + \\sum_{i} v_{ i } \\left( {x_{ i }}^{2} - 1 \\right) \\\\\n\\intertext{where} \nx & : \\mathbb{R}^{ n} \\\\\nW & : \\mathbb{R}^{ n \\times n } \\\\\nv & : \\mathbb{R}^{ n} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\nL(x,v) & = {x}^T W x + \\sum_{i} v_{ i } \\left( {x_{ i }}^{2} - 1 \\right) \\\\\nwhere \\\\\nx & : \\mathbb{R}^{ n} \\\\\nW & : \\mathbb{R}^{ n \\times n } \\\\\nv & : \\mathbb{R}^{ n} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(x, W, v)\n% output = heartlib(x, W, v)\n%\n%    `L(x,v)` = xᵀWx + ∑_i v_i(x_i²-1)\n%            where\n%            x: ℝ^n\n%            W: ℝ^(n×n)\n%            v: ℝ^n\n    x = reshape(x,[],1);\n    v = reshape(v,[],1);\n\n    n = size(x, 1);\n    assert( numel(x) == n );\n    assert( isequal(size(W), [n, n]) );\n    assert( numel(v) == n );\n\n    % `L(x,v)` = xᵀWx + ∑_i v_i(x_i²-1)\n\n    sum_0 = 0;\n    for i = 1:size(v,1)\n        sum_0 = sum_0 + v(i) * (x(i).^2 - 1);\n    end\n    Lx_v = x' * W * x + sum_0;\n    output.Lx_v = Lx_v;\nend\n",
