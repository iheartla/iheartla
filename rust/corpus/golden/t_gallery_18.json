 "outputs": {
  "numpy": "\"\"\"\ngiven\n        p_i: ℝ^3: points on lines\n        d_i: ℝ^3: unit directions along lines\n        P_i = ( I_3 - d_i d_iᵀ )\n        q = ( ∑_i P_iᵀP_i )⁻¹ ( ∑_i P_iᵀP_i p_i )\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, p, d):\n        p = np.asarray(p, dtype=np.float64)\n        d = np.asarray(d, dtype=np.float64)\n        dim_0 = p.shape[0]\n        assert p.shape == (dim_0, 3, )\n        assert d.shape == (dim_0, 3, )\n        # P_i = ( I_3 - d_i d_iᵀ )\n        self.P = np.zeros((dim_0, 3, 3))\n        for i in range(1, dim_0+1):\n            self.P[i-1] = (np.identity(3) - (d[i-1]).reshape(3, 1) @ d[i-1].T.reshape(1, 3))\n        # q = ( ∑_i P_iᵀP_i )⁻¹ ( ∑_i P_iᵀP_i p_i )\n        sum_0 = np.zeros((3, 3))\n        for i in range(1, len(self.P)+1):\n            sum_0 += self.P[i-1].T @ self.P[i-1]\n        sum_1 = np.zeros((3, ))\n        for i in range(1, len(p)+1):\n            sum_1 += self.P[i-1].T @ self.P[i-1] @ p[i-1]\n        self.q = np.linalg.solve((sum_0), (sum_1))\n\n\n\n\n\n",
  "eigen": "/*\ngiven\n        p_i: ℝ^3: points on lines\n        d_i: ℝ^3: unit directions along lines\n        P_i = ( I_3 - d_i d_iᵀ )\n        q = ( ∑_i P_iᵀP_i )⁻¹ ( ∑_i P_iᵀP_i p_i )\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    std::vector<Eigen::Matrix<DT, 3, 3>> P;\n    Eigen::Matrix<DT, 3, 1> q;\n\n    heartlib(\n        const std::vector<Eigen::Matrix<double, 3, 1>> & p,\n        const std::vector<Eigen::Matrix<double, 3, 1>> & d)\n    {\n        const long dim_0 = p.size();\n        assert( d.size() == dim_0 );\n        // P_i = ( I_3 - d_i d_iᵀ )\n        P.resize(dim_0);\n        for( int i=1; i<=dim_0; i++){\n            P.at(i-1) = (MatrixD::Identity(3, 3) - d.at(i-1) * d.at(i-1).transpose());\n        }\n        // q = ( ∑_i P_iᵀP_i )⁻¹ ( ∑_i P_iᵀP_i p_i )\n        MatrixD sum_0 = MatrixD::Zero(3, 3);\n        for(int i=1; i<=P.size(); i++){\n            sum_0 += this->P.at(i-1).transpose() * this->P.at(i-1);\n        }\n        MatrixD sum_1 = MatrixD::Zero(3, 1);\n        for(int i=1; i<=P.size(); i++){\n            sum_1 += this->P.at(i-1).transpose() * this->P.at(i-1) * p.at(i-1);\n        }\n        q = (to_double((sum_0))).colPivHouseholderQr().solve(to_double((sum_1)));\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\n\\intertext{given} \np_{i} & : \\mathbb{R}^{ 3} \\text{ points on lines} \\\\\nd_{i} & : \\mathbb{R}^{ 3} \\text{ unit directions along lines} \\\\\n\\\\\nP_{ i } & = I_{ 3 } - d_{ i } {d_{ i }}^T \\\\\nq & = \\left( \\sum_{i} {P_{ i }}^T P_{ i } \\right)^{-1}\\left( \\sum_{i} {P_{ i }}^T P_{ i } p_{ i } \\right) \\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\ngiven \\\\\np_{i} & : \\mathbb{R}^{ 3} \\text{ points on lines} \\\\\nd_{i} & : \\mathbb{R}^{ 3} \\text{ unit directions along lines} \\\\\n\\\\\nP_{ i } & = I_{ 3 } - d_{ i } {d_{ i }}^T \\\\\nq & = \\left( \\sum_{i} {P_{ i }}^T P_{ i } \\right)^{-1}\\left( \\sum_{i} {P_{ i }}^T P_{ i } p_{ i } \\right) \\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(p, d)\n% output = heartlib(p, d)\n%\n%    given\n%            p_i: ℝ^3: points on lines\n%            d_i: ℝ^3: unit directions along lines\n%            P_i = ( I_3 - d_i d_iᵀ )\n%            q = ( ∑_i P_iᵀP_i )⁻¹ ( ∑_i P_iᵀP_i p_i )\n    dim_0 = size(p, 1);\n    assert( isequal(size(p), [dim_0, 3]) );\n    assert( isequal(size(d), [dim_0, 3]) );\n\n    % P_i = ( I_3 - d_i d_iᵀ )\n\n    P = zeros(dim_0, 3, 3);\n    for i = 1:dim_0\n        squeeze(P(i,:,:)) = (speye(3) - reshape(d(i,:)', [3, 1]) * d(i,:)'');\n    end\n    % q = ( ∑_i P_iᵀP_i )⁻¹ ( ∑_i P_iᵀP_i p_i )\n\n    sum_0 = zeros(3, 3);\n    for i = 1:size(P, 1)\n        sum_0 = sum_0 + squeeze(P(i,:,:))' * squeeze(P(i,:,:));\n    end\n    sum_1 = zeros(3,1);\n    for i = 1:size(P, 1)\n        sum_1 = sum_1 + squeeze(P(i,:,:))' * squeeze(P(i,:,:)) * p(i,:)';\n    end\n    q = (((sum_0))\\((sum_1)));\n    output.P = P;\n    output.q = q;\nend\n",
  "macromathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\ngiven \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'p', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-p_i\", \"sym\":\"p\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {p} }_{i} & : \\mathbb{R}^{ 3} \\text{ points on lines} \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'd', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-d_i\", \"sym\":\"d\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {d} }_{i} & : \\mathbb{R}^{ 3} \\text{ unit directions along lines} \\\\\n\\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'P', 'heartlib', 'def', false, '')\", \"id\":\"heartlib-P\", \"sym\":\"P\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"def\", \"case\":\"equation\"} }{ {P} }_{ i } & = \\left( I_{ 3 } - \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'd', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-d\", \"sym\":\"d\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {d} }_{ i } {\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'd', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-d\", \"sym\":\"d\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {d} }_{ i }}^T \\right)\\\\\\eqlabel{ {\"onclick\":\"event.stopPropagation(); onClickEq(this, 'heartlib', ['d', 'P'], false, [], [], 'UF9pID0gKCBJXzMgLSBkX2kgZF9p4bWAICk=');\"} }{}\n \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'q', 'heartlib', 'def', false, '')\", \"id\":\"heartlib-q\", \"sym\":\"q\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"def\", \"case\":\"equation\"} }{ {q} } & = \\left( \\sum_{i} {\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'P', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-P\", \"sym\":\"P\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {P} }_{ i }}^T \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'P', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-P\", \"sym\":\"P\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {P} }_{ i } \\right)^{-1}\\left( \\sum_{i} {\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'P', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-P\", \"sym\":\"P\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {P} }_{ i }}^T \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'P', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-P\", \"sym\":\"P\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {P} }_{ i } \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'p', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-p\", \"sym\":\"p\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {p} }_{ i } \\right)\\\\\\eqlabel{ {\"onclick\":\"event.stopPropagation(); onClickEq(this, 'heartlib', ['p', 'P', 'q'], false, [], [], 'cSA9ICgg4oiRX2kgUF9p4bWAUF9pICnigbvCuSAoIOKIkV9pIFBfaeG1gFBfaSBwX2kgKQ==');\"} }{}\n \\\\\n\\end{align*}\n"
