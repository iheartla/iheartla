 "outputs": {
  "numpy": "\"\"\"\n[A⁻¹+A⁻¹BS⁻¹BᵀA⁻¹   -A⁻¹BS⁻¹\n        -S⁻¹BᵀA⁻¹           S⁻¹]\n        where\n        A: ℝ^(2×2)\n        B: ℝ^(2×2)\n        S: ℝ^(2×2)\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, A, B, S):\n        A = np.asarray(A, dtype=np.float64)\n        B = np.asarray(B, dtype=np.float64)\n        S = np.asarray(S, dtype=np.float64)\n        assert A.shape == (2, 2)\n        assert B.shape == (2, 2)\n        assert S.shape == (2, 2)\n        ret_0 = np.block([[np.linalg.inv(A) + np.linalg.solve(A, B) @ np.linalg.solve(S, B.T) @ np.linalg.inv(A), -np.linalg.solve(A, B) @ np.linalg.inv(S)], [-np.linalg.solve(S, B.T) @ np.linalg.inv(A), np.linalg.inv(S)]])\n        self.ret = ret_0\n\n\n\n\n\n",
  "eigen": "/*\n[A⁻¹+A⁻¹BS⁻¹BᵀA⁻¹   -A⁻¹BS⁻¹\n        -S⁻¹BᵀA⁻¹           S⁻¹]\n        where\n        A: ℝ^(2×2)\n        B: ℝ^(2×2)\n        S: ℝ^(2×2)\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    Eigen::Matrix<DT, 4, 4> ret;\n\n    heartlib(\n        const Eigen::Matrix<double, 2, 2> & A,\n        const Eigen::Matrix<double, 2, 2> & B,\n        const Eigen::Matrix<double, 2, 2> & S)\n    {\n    \n        Eigen::Matrix<DT, 4, 4> ret_0;\n        ret_0 << A.inverse() + (to_double(A)).colPivHouseholderQr().solve(to_double(B)) * (to_double(S)).colPivHouseholderQr().solve(to_double(B.transpose())) * A.inverse(), -(to_double(A)).colPivHouseholderQr().solve(to_double(B)) * S.inverse(),\n        -(to_double(S)).colPivHouseholderQr().solve(to_double(B.transpose())) * A.inverse(), S.inverse();\n        ret = ret_0;\n    }\n};\n\n\n\n\n\n",
