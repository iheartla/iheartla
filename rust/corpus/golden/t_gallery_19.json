  "matlab": "function output = heartlib(A, B, S)\n% output = heartlib(A, B, S)\n%\n%    [A⁻¹+A⁻¹BS⁻¹BᵀA⁻¹   -A⁻¹BS⁻¹\n%            -S⁻¹BᵀA⁻¹           S⁻¹]\n%            where\n%            A: ℝ^(2×2)\n%            B: ℝ^(2×2)\n%            S: ℝ^(2×2)\n    assert( isequal(size(A), [2, 2]) );\n    assert( isequal(size(B), [2, 2]) );\n    assert( isequal(size(S), [2, 2]) );\n\n    ret_0 = [[inv(A) + ((A)\\(B)) * ((S)\\(B')) * inv(A), -((A)\\(B)) * inv(S)]; [-((S)\\(B')) * inv(A), inv(S)]];\n    ret = ret_0;\n    output.ret = ret;\nend\n",
