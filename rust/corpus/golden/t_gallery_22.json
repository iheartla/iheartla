 "outputs": {
  "numpy": "\"\"\"\ntr from linearalgebra\n        `J₃` = [1_3,3]\n        `k_angle(Dₘ)` = 3(sqrt(2)v)^(2/3)(7/4||`Dₘ`||_F^2-1/4tr(`J₃``Dₘ`ᵀ`Dₘ`))⁻¹\n        where\n        `Dₘ`: ℝ^(3×3)\n        v: ℝ\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, Dₘ, v):\n        Dₘ = np.asarray(Dₘ, dtype=np.float64)\n        assert Dₘ.shape == (3, 3)\n        assert np.ndim(v) == 0\n        # `J₃` = [1_3,3]\n        J3_0 = np.vstack((np.ones((3, 3))))\n        self.J3 = J3_0\n        # `k_angle(Dₘ)` = 3(sqrt(2)v)^(2/3)(7/4||`Dₘ`||_F^2-1/4tr(`J₃``Dₘ`ᵀ`Dₘ`))⁻¹\n        self.k_angleDₘ = 3 * np.power(np.asarray((np.sqrt(2) * v), dtype=np.float64), ((2) / (3))) * 1 / (((7) / (4) * np.power(np.asarray(np.linalg.norm(Dₘ, 'fro'), dtype=np.float64), 2) - (1) / (4) * np.trace(self.J3 @ Dₘ.T @ Dₘ)))\n\n\n\n\n\n",
  "eigen": "/*\ntr from linearalgebra\n        `J₃` = [1_3,3]\n        `k_angle(Dₘ)` = 3(sqrt(2)v)^(2/3)(7/4||`Dₘ`||_F^2-1/4tr(`J₃``Dₘ`ᵀ`Dₘ`))⁻¹\n        where\n        `Dₘ`: ℝ^(3×3)\n        v: ℝ\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    Eigen::Matrix<DT, 3, 3> J3;\n    DT k_angleDₘ;\n\n    heartlib(\n        const Eigen::Matrix<double, 3, 3> & Dₘ,\n        const double & v)\n    {\n    \n        // `J₃` = [1_3,3]\n        Eigen::Matrix<DT, 3, 3> J3_0;\n        J3_0 << MatrixD::Ones(3, 3);\n        J3 = J3_0;\n        // `k_angle(Dₘ)` = 3(sqrt(2)v)^(2/3)(7/4||`Dₘ`||_F^2-1/4tr(`J₃``Dₘ`ᵀ`Dₘ`))⁻¹\n        k_angleDₘ = 3 * pow((sqrt(2) * v), (2 / DT(3))) * 1 / ((7 / DT(4) * pow((Dₘ).norm(), 2) - 1 / DT(4) * (J3 * Dₘ.transpose() * Dₘ).trace()));\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\n \\omit \\span \\text{ tr from linearalgebra }\\\\\n \\\\\nJ₃ & = \\begin{bmatrix}\n\\mathbb{ 1 }_{ 3,3 }\\\\\n\\end{bmatrix} \\\\\nk_angle(Dₘ) & = 3 {\\left(  \\sqrt{ 2 } v \\right)}^{\\frac{2}{3}} \\left( \\frac{7}{4} \\left\\|Dₘ\\right\\|_F^{2} - \\frac{1}{4} tr\\left( J₃ {Dₘ}^T Dₘ \\right) \\right)^{-1} \\\\\n\\intertext{where} \nDₘ & : \\mathbb{R}^{ 3 \\times 3 } \\\\\nv & : \\mathbb{R} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n & \\text{ tr from linearalgebra }\\\\\n \\\\\nJ₃ & = \\begin{bmatrix}\n\\mathbb{ 1 }_{ 3,3 }\\\\\n\\end{bmatrix} \\\\\nk_angle(Dₘ) & = 3 {\\left(  \\sqrt{ 2 } v \\right)}^{\\frac{2}{3}} \\left( \\frac{7}{4} \\left\\|Dₘ\\right\\|_F^{2} - \\frac{1}{4} tr\\left( J₃ {Dₘ}^T Dₘ \\right) \\right)^{-1} \\\\\nwhere \\\\\nDₘ & : \\mathbb{R}^{ 3 \\times 3 } \\\\\nv & : \\mathbb{R} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(D_m, v)\n% output = heartlib(`Dₘ`, v)\n%\n%    tr from linearalgebra\n%            `J₃` = [1_3,3]\n%            `k_angle(Dₘ)` = 3(sqrt(2)v)^(2/3)(7/4||`Dₘ`||_F^2-1/4tr(`J₃``Dₘ`ᵀ`Dₘ`))⁻¹\n%            where\n%            `Dₘ`: ℝ^(3×3)\n%            v: ℝ\n    assert( isequal(size(D_m), [3, 3]) );\n    assert(numel(v) == 1);\n\n    % `J₃` = [1_3,3]\n\n    J3_0 = [[ones(3, 3)]];\n    J3 = J3_0;\n    % `k_angle(Dₘ)` = 3(sqrt(2)v)^(2/3)(7/4||`Dₘ`||_F^2-1/4tr(`J₃``Dₘ`ᵀ`Dₘ`))⁻¹\n\n    k_angleD_m = 3 * (sqrt(2) * v).^(2 / 3) * 1 / ((7 / 4 * norm(D_m, 'fro').^2 - 1 / 4 * trace(J3 * D_m' * D_m)));\n    output.J3 = J3;\n    output.k_angleD_m = k_angleD_m;\nend\n",
