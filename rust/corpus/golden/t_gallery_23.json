 "outputs": {
  "numpy": "\"\"\"\n`xᵢ` = T_*,1\n        `xⱼ` = T_*,2\n        `xₖ` = T_*,3\n        `n(T)` = (`xⱼ`-`xᵢ`)×(`xₖ`-`xᵢ`)/||(`xⱼ`-`xᵢ`)×(`xₖ`-`xᵢ`)||\n        where\n        T: ℝ^(3×3)\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, T):\n        T = np.asarray(T, dtype=np.float64)\n        assert T.shape == (3, 3)\n        # `xᵢ` = T_*,1\n        self.xᵢ = T[:, 1-1]\n        # `xⱼ` = T_*,2\n        self.xⱼ = T[:, 2-1]\n        # `xₖ` = T_*,3\n        self.xₖ = T[:, 3-1]\n        # `n(T)` = (`xⱼ`-`xᵢ`)×(`xₖ`-`xᵢ`)/||(`xⱼ`-`xᵢ`)×(`xₖ`-`xᵢ`)||\n        self.nT = (np.cross((self.xⱼ - self.xᵢ), (self.xₖ - self.xᵢ))) / (np.linalg.norm(np.cross((self.xⱼ - self.xᵢ), (self.xₖ - self.xᵢ)), 2))\n\n\n\n\n\n",
  "eigen": "/*\n`xᵢ` = T_*,1\n        `xⱼ` = T_*,2\n        `xₖ` = T_*,3\n        `n(T)` = (`xⱼ`-`xᵢ`)×(`xₖ`-`xᵢ`)/||(`xⱼ`-`xᵢ`)×(`xₖ`-`xᵢ`)||\n        where\n        T: ℝ^(3×3)\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    Eigen::Matrix<DT, 3, 1> xᵢ;\n    Eigen::Matrix<DT, 3, 1> xⱼ;\n    Eigen::Matrix<DT, 3, 1> xₖ;\n    Eigen::Matrix<DT, 3, 1> nT;\n\n    heartlib(const Eigen::Matrix<double, 3, 3> & T)\n    {\n    \n        // `xᵢ` = T_*,1\n        xᵢ = T.col(1-1);\n        // `xⱼ` = T_*,2\n        xⱼ = T.col(2-1);\n        // `xₖ` = T_*,3\n        xₖ = T.col(3-1);\n        // `n(T)` = (`xⱼ`-`xᵢ`)×(`xₖ`-`xᵢ`)/||(`xⱼ`-`xᵢ`)×(`xₖ`-`xᵢ`)||\n        nT = ((xⱼ - xᵢ)).cross((xₖ - xᵢ)) / DT((((xⱼ - xᵢ)).cross((xₖ - xᵢ))).template lpNorm<2>());\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\nx\\textsubscript{i} & = T_{*, 1} \\\\\nx\\textsubscript{j} & = T_{*, 2} \\\\\nxₖ & = T_{*, 3} \\\\\nn(T) & = \\frac{\\left( x\\textsubscript{j} - x\\textsubscript{i} \\right) × \\left( xₖ - x\\textsubscript{i} \\right)}{\\left\\|\\left( x\\textsubscript{j} - x\\textsubscript{i} \\right) × \\left( xₖ - x\\textsubscript{i} \\right)\\right\\|} \\\\\n\\intertext{where} \nT & : \\mathbb{R}^{ 3 \\times 3 } \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\nxᵢ & = T_{*, 1} \\\\\nxⱼ & = T_{*, 2} \\\\\nxₖ & = T_{*, 3} \\\\\nn(T) & = \\frac{\\left( xⱼ - xᵢ \\right) × \\left( xₖ - xᵢ \\right)}{\\left\\|\\left( xⱼ - xᵢ \\right) × \\left( xₖ - xᵢ \\right)\\right\\|} \\\\\nwhere \\\\\nT & : \\mathbb{R}^{ 3 \\times 3 } \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(T)\n% output = heartlib(T)\n%\n%    `xᵢ` = T_*,1\n%            `xⱼ` = T_*,2\n%            `xₖ` = T_*,3\n%            `n(T)` = (`xⱼ`-`xᵢ`)×(`xₖ`-`xᵢ`)/||(`xⱼ`-`xᵢ`)×(`xₖ`-`xᵢ`)||\n%            where\n%            T: ℝ^(3×3)\n    assert( isequal(size(T), [3, 3]) );\n\n    % `xᵢ` = T_*,1\n\n    x_i = T(:, 1);\n    % `xⱼ` = T_*,2\n\n    x_j = T(:, 2);\n    % `xₖ` = T_*,3\n\n    x_k = T(:, 3);\n    % `n(T)` = (`xⱼ`-`xᵢ`)×(`xₖ`-`xᵢ`)/||(`xⱼ`-`xᵢ`)×(`xₖ`-`xᵢ`)||\n\n    nT = cross((x_j - x_i), (x_k - x_i)) / norm(cross((x_j - x_i), (x_k - x_i)), 2);\n    output.x_i = x_i;\n    output.x_j = x_j;\n    output.x_k = x_k;\n    output.nT = nT;\nend\n",
