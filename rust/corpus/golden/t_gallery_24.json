 "outputs": {
  "numpy": "\"\"\"\n`n(v)` = (∑_(i for i ∈ `N₁(v)`) α_i n(T_i))/||∑_(i for i ∈ `N₁(v)`) α_i n(T_i)||\n        where\n        T_i: ℝ^(3×3)\n        α_i: ℝ\n        `N₁(v)`: {ℤ}\n        n: ℝ^(3×3) -> ℝ^3\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, T, α, N1v, n):\n        T = np.asarray(T, dtype=np.float64)\n        α = np.asarray(α, dtype=np.float64)\n        N1v = frozenset(N1v)\n        dim_0 = α.shape[0]\n        assert T.shape == (dim_0, 3, 3)\n        assert α.shape == (dim_0,)\n        # `n(v)` = (∑_(i for i ∈ `N₁(v)`) α_i n(T_i))/||∑_(i for i ∈ `N₁(v)`) α_i n(T_i)||\n        sum_0 = np.zeros((3, ))\n        for i in range(1, len(T)+1):\n            if((i) in N1v):\n                sum_0 += α[i-1] * n(T[i-1])\n        sum_1 = np.zeros((3, ))\n        for i in range(1, len(T)+1):\n            if((i) in N1v):\n                sum_1 += α[i-1] * n(T[i-1])\n        self.nv = ((sum_0)) / (np.linalg.norm(sum_1, 2))\n\n\n\n\n\n",
  "eigen": "/*\n`n(v)` = (∑_(i for i ∈ `N₁(v)`) α_i n(T_i))/||∑_(i for i ∈ `N₁(v)`) α_i n(T_i)||\n        where\n        T_i: ℝ^(3×3)\n        α_i: ℝ\n        `N₁(v)`: {ℤ}\n        n: ℝ^(3×3) -> ℝ^3\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    Eigen::Matrix<DT, 3, 1> nv;\n\n    heartlib(\n        const std::vector<Eigen::Matrix<double, 3, 3>> & T,\n        const std::vector<double> & α,\n        const std::vector<int > & N1v,\n        const std::function<Eigen::Matrix<double, 3, 1>(Eigen::Matrix<double, 3, 3>)> & n)\n    {\n        const long dim_0 = α.size();\n        assert( T.size() == dim_0 );\n        // `n(v)` = (∑_(i for i ∈ `N₁(v)`) α_i n(T_i))/||∑_(i for i ∈ `N₁(v)`) α_i n(T_i)||\n        MatrixD sum_0 = MatrixD::Zero(3, 1);\n        for(int i=1; i<=T.size(); i++){\n            if(std::binary_search(N1v.begin(), N1v.end(), int(i))){\n                sum_0 += α.at(i-1) * n((T.at(i-1)).eval());\n            }\n        }\n        MatrixD sum_1 = MatrixD::Zero(3, 1);\n        for(int i=1; i<=T.size(); i++){\n            if(std::binary_search(N1v.begin(), N1v.end(), int(i))){\n                sum_1 += α.at(i-1) * n((T.at(i-1)).eval());\n            }\n        }\n        nv = (sum_0) / DT((sum_1).template lpNorm<2>());\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\nn(v) & = \\frac{\\sum_{i \\in N₁(v) }α_{ i } n\\left( T_{ i } \\right)}{\\left\\|\\sum_{i \\in N₁(v) }α_{ i } n\\left( T_{ i } \\right)\\right\\|} \\\\\n\\intertext{where} \nT_{i} & : \\mathbb{R}^{ 3 \\times 3 } \\\\\nα_{i} & : \\mathbb{R} \\\\\nN₁(v) & : \\{\\mathbb{Z}\\} \\\\\nn & : \\mathbb{R}^{ 3 \\times 3 }\\rightarrow \\mathbb{R}^{ 3} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\nn(v) & = \\frac{\\sum_{i \\in N₁(v) }α_{ i } n\\left( T_{ i } \\right)}{\\left\\|\\sum_{i \\in N₁(v) }α_{ i } n\\left( T_{ i } \\right)\\right\\|} \\\\\nwhere \\\\\nT_{i} & : \\mathbb{R}^{ 3 \\times 3 } \\\\\nα_{i} & : \\mathbb{R} \\\\\nN₁(v) & : \\{\\mathbb{Z}\\} \\\\\nn & : \\mathbb{R}^{ 3 \\times 3 }\\rightarrow \\mathbb{R}^{ 3} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(T, alpha, N1v, n)\n% output = heartlib(T, α, `N₁(v)`, n)\n%\n%    `n(v)` = (∑_(i for i ∈ `N₁(v)`) α_i n(T_i))/||∑_(i for i ∈ `N₁(v)`) α_i n(T_i)||\n%            where\n%            T_i: ℝ^(3×3)\n%            α_i: ℝ\n%            `N₁(v)`: {ℤ}\n%            n: ℝ^(3×3) -> ℝ^3\n    alpha = reshape(alpha,[],1);\n\n    dim_0 = size(alpha, 1);\n    assert( isequal(size(T), [dim_0, 3, 3]) );\n    assert( size(alpha,1) == dim_0 );\n\n    % `n(v)` = (∑_(i for i ∈ `N₁(v)`) α_i n(T_i))/||∑_(i for i ∈ `N₁(v)`) α_i n(T_i)||\n\n    sum_0 = zeros(3,1);\n    for i = 1:size(T, 1)\n        if ismember([i],N1v,'rows')\n          sum_0 = sum_0 + alpha(i) * n(squeeze(T(i,:,:)));\n        end\n    end\n    sum_1 = zeros(3,1);\n    for i = 1:size(T, 1)\n        if ismember([i],N1v,'rows')\n          sum_1 = sum_1 + alpha(i) * n(squeeze(T(i,:,:)));\n        end\n    end\n    nv = (sum_0) / norm(sum_1, 2);\n    output.nv = nv;\nend\n",
  "macromathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'n(v)', 'heartlib', 'def', false, '')\", \"id\":\"heartlib-n(v)\", \"sym\":\"n(v)\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"def\", \"case\":\"equation\"} }{ {n(v)} } & = \\frac{\\sum_{\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'i', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-i\", \"sym\":\"i\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {i} } \\in \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'N₁(v)', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-N₁(v)\", \"sym\":\"N₁(v)\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {N₁(v)} } }\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'α', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-α\", \"sym\":\"α\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {α} }_{ i } \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'n', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-n\", \"sym\":\"n\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {n} }\\left( \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'T', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-T\", \"sym\":\"T\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {T} }_{ i } \\right)}{\\left\\|\\sum_{\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'i', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-i\", \"sym\":\"i\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {i} } \\in \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'N₁(v)', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-N₁(v)\", \"sym\":\"N₁(v)\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {N₁(v)} } }\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'α', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-α\", \"sym\":\"α\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {α} }_{ i } \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'n', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-n\", \"sym\":\"n\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {n} }\\left( \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'T', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-T\", \"sym\":\"T\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {T} }_{ i } \\right)\\right\\|}\\\\\\eqlabel{ {\"onclick\":\"event.stopPropagation(); onClickEq(this, 'heartlib', ['T', 'n', 'α', 'n(v)'], false, [], [], 'YG4odilgID0gKOKIkV8oaSBmb3IgaSDiiIggYE7igoEodilgKSDOsV9pIG4oVF9pKSkvfHziiJFfKGkgZm9yIGkg4oiIIGBO4oKBKHYpYCkgzrFfaSBuKFRfaSl8fA==');\"} }{}\n \\\\\nwhere \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'T', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-T_i\", \"sym\":\"T\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {T} }_{i} & : \\mathbb{R}^{ 3 \\times 3 } \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'α', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-α_i\", \"sym\":\"α\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {α} }_{i} & : \\mathbb{R} \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'N₁(v)', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-N₁(v)\", \"sym\":\"N₁(v)\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\"