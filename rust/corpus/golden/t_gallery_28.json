 "outputs": {
  "numpy": "\"\"\"\nL_i,j = { w_i,j if (i,j) ∈ E\n        L_i,i = -sum_(l for l != i) L_i,l\n        where\n        L: ℝ^(n×n)\n        w: ℝ^(n×n): edge weight matrix\n        E: {ℤ²} index: edges\n        \n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, w, E):\n        w = np.asarray(w, dtype=np.float64)\n        E = frozenset(E)\n        n = w.shape[1]\n        assert w.shape == (n, n)\n        assert all( len(el) == 2 for el in E )\n        # L_i,j = { w_i,j if (i,j) ∈ E\n        Lij_0 = []\n        Lvals_0 = []\n        for tuple in E:\n            i = tuple[0]+1\n            j = tuple[1]+1\n            Lij_0.append((i-1, j-1))\n            Lvals_0.append(w[i-1, j-1])\n        sparse_0 = scipy.sparse.coo_matrix((Lvals_0, np.asarray(Lij_0).T), shape=(n, n))\n        self.L = sparse_0\n        for i in range(1, n+1):\n            sum_0 = 0\n            for l in range(1, self.L.shape[1]+1):\n                if(l != i):\n                    sum_0 += self.L.tocsr()[i-1, l-1]\n            Lij_0.append((i - 1, i - 1))\n            Lvals_0.append(-sum_0)\n        self.L = scipy.sparse.coo_matrix((Lvals_0, np.asarray(Lij_0).T), shape=(n, n))\n\n\n\n\n\n",
  "eigen": "/*\nL_i,j = { w_i,j if (i,j) ∈ E\n        L_i,i = -sum_(l for l != i) L_i,l\n        where\n        L: ℝ^(n×n)\n        w: ℝ^(n×n): edge weight matrix\n        E: {ℤ²} index: edges\n        \n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    Eigen::SparseMatrix<double> L;\n\n    heartlib(\n        const Eigen::MatrixXd & w,\n        const std::vector<std::tuple< int, int > > & E)\n    {\n        const long n = w.cols();\n        assert( w.rows() == n );\n        // L_i,j = { w_i,j if (i,j) ∈ E\n        L.resize(n, n);\n        std::vector<Eigen::Triplet<DT> > tripletList_L;\n        for(const std::tuple< int, int >& tuple : E){\n            int i = std::get<0>(tuple)+1;\n            int j = std::get<1>(tuple)+1;\n            tripletList_L.push_back(Eigen::Triplet<DT>(i-1, j-1, w(i-1, j-1)));\n        }\n        L.setFromTriplets(tripletList_L.begin(), tripletList_L.end());\n        // L_i,i = -sum_(l for l != i) L_i,l\n        for( int i=1; i<=n; i++){\n            DT sum_0 = 0;\n            for(int l=1; l<=L.cols(); l++){\n                if(l != i){\n                    sum_0 += this->L.coeff(i-1, l-1);\n                }\n            }\n            tripletList_L.push_back(Eigen::Triplet<DT>(i-1, i-1, -sum_0));\n        }\n        L.setFromTriplets(tripletList_L.begin(), tripletList_L.end());\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\nL_{i, j} & = \\begin{cases} w_{i, j} & \\text{if }  \\left( i, j \\right) \\in E  \\\\ \\end{cases}  \\\\\nL_{i, i} & = -\\sum_{l != i}L_{i, l} \\\\\n\\intertext{where} \nL & : \\mathbb{R}^{ n \\times n } \\\\\nw & : \\mathbb{R}^{ n \\times n } \\text{ edge weight matrix} \\\\\nE & : \\{\\mathbb{Z}^{ 2 }\\} ,\\text{ index} \\text{ edges} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\nL_{i, j} & = \\begin{cases} w_{i, j} & \\text{if }  \\left( i, j \\right) \\in E  \\\\ \\end{cases}  \\\\\nL_{i, i} & = -\\sum_{l != i}L_{i, l} \\\\\nwhere \\\\\nL & : \\mathbb{R}^{ n \\times n } \\\\\nw & : \\mathbb{R}^{ n \\times n } \\text{ edge weight matrix} \\\\\nE & : \\{\\mathbb{Z}^{ 2 }\\} ,\\text{ index} \\text{ edges} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(w, E)\n% output = heartlib(w, E)\n%\n%    L_i,j = { w_i,j if (i,j) ∈ E\n%            L_i,i = -sum_(l for l != i) L_i,l\n%            where\n%            L: ℝ^(n×n)\n%            w: ℝ^(n×n): edge weight matrix\n%            E: {ℤ²} index: edges\n%            \n    n = size(w, 2);\n    assert( isequal(size(w), [n, n]) );\n    assert(size(E,2) == 2)\n\n    % L_i,j = { w_i,j if (i,j) ∈ E\n\n    Lij_0 = zeros(2,0);\n    Lvals_0 = zeros(1,0);\n    for index = 1:size(E, 1)\n        i = E(index, 1);\n        j = E(index, 2);\n        Lij_0(1:2,end+1) = [i;j];\n        Lvals_0(end+1) = w(i, j);\n    end\n    sparse_0 = sparse(Lij_0(1,:),Lij_0(2,:),Lvals_0,n,n);\n    L = sparse_0;\n    for i = 1:n\n        sum_0 = 0;\n        for l = 1:size(L,2)\n            if l ~= i\n              sum_0 = sum_0 + L(i, l);\n            end\n        end\n        Lij_0(1:2,end+1) = [i;i];\n        Lvals_0(end+1) = -sum_0;\n    end\n    L = sparse(Lij_0(1,:),Lij_0(2,:),Lvals_0,n,n);\n    output.L = L;\nend\n",
