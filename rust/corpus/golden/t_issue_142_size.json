 "outputs": {
  "numpy": "\"\"\"\ny = #a + #S\nm, k = #A\nwhere\na_i ∈ ℝ\nS ∈ {ℤ}\nA ∈ ℝ^(2×3)\nx ∈ ℝ^(#a)\n\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, a, S, A, x):\n        a = np.asarray(a, dtype=np.float64)\n        S = frozenset(S)\n        A = np.asarray(A, dtype=np.float64)\n        x = np.asarray(x, dtype=np.float64)\n        dim_0 = a.shape[0]\n        assert a.shape == (dim_0,)\n        assert A.shape == (2, 3)\n        assert x.shape == (dim_0,)\n        # y = #a + #S\n        self.y = len(a) + len(S)\n        rhs = A.shape\n        self.m = rhs[0]\n        self.k = rhs[1]\n\n\n\n\n\n",
  "eigen": "/*\ny = #a + #S\nm, k = #A\nwhere\na_i ∈ ℝ\nS ∈ {ℤ}\nA ∈ ℝ^(2×3)\nx ∈ ℝ^(#a)\n\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    int y;\n    int m;\n    int k;\n\n    heartlib(\n        const std::vector<double> & a,\n        const std::vector<int > & S,\n        const Eigen::Matrix<double, 2, 3> & A,\n        const Eigen::VectorXd & x)\n    {\n        const long dim_0 = a.size();\n        assert( x.size() == dim_0 );\n        // y = #a + #S\n        y = a.size() + S.size();\n        // m, k = #A\n        std::tuple< int, int > rhs = std::tuple< int, int >(A.rows(), A.cols());\n        m = std::get<0>(rhs);\n        k = std::get<1>(rhs);\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\ny & = \\#a + \\#S \\\\\nm,k & = \\#A \\\\\n\\intertext{where} \na_{i} & ∈ \\mathbb{R} \\\\\nS & ∈ \\{\\mathbb{Z}\\} \\\\\nA & ∈ \\mathbb{R}^{ 2 \\times 3 } \\\\\nx & ∈ \\mathbb{R}^{ \\#a} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\ny & = \\#a + \\#S \\\\\n & m,k & = \\#A \\\\\nwhere \\\\\na_{i} & ∈ \\mathbb{R} \\\\\nS & ∈ \\{\\mathbb{Z}\\} \\\\\nA & ∈ \\mathbb{R}^{ 2 \\times 3 } \\\\\nx & ∈ \\mathbb{R}^{ \\#a} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(a, S, A, x)\n% output = heartlib(a, S, A, x)\n%\n%    y = #a + #S\n%    m, k = #A\n%    where\n%    a_i ∈ ℝ\n%    S ∈ {ℤ}\n%    A ∈ ℝ^(2×3)\n%    x ∈ ℝ^(#a)\n%    \n    a = reshape(a,[],1);\n    x = reshape(x,[],1);\n\n    dim_0 = size(a, 1);\n    assert( size(a,1) == dim_0 );\n    assert( isequal(size(A), [2, 3]) );\n    assert( numel(x) == dim_0 );\n\n    % y = #a + #S\n\n    y = size(a, 1) + size(S, 1);\n    [m, k] = size(A);\n;\n    output.y = y;\n    output.m = m;\n    output.k = k;\nend\n",
  "macromathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'y', 'heartlib', 'def', false, '')\", \"id\":\"heartlib-y\", \"sym\":\"y\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"def\", \"case\":\"equation\"} }{ {y} } & = \\#\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'a', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-a\", \"sym\":\"a\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {a} } + \\#\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'S', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-S\", \"sym\":\"S\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {S} }\\\\\\eqlabel{ {\"onclick\":\"event.stopPropagation(); onClickEq(this, 'heartlib', ['S', 'a', 'y'], false, [], [], 'eSA9ICNhICsgI1M=');\"} }{}\n \\\\\n & \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'm', 'heartlib', 'def', false, '')\", \"id\":\"heartlib-m\", \"sym\":\"m\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"def\", \"case\":\"equation\"} }{ {m} },\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'k', 'heartlib', 'def', false, '')\", \"id\":\"heartlib-k\", \"sym\":\"k\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"def\", \"case\":\"equation\"} }{ {k} } & = \\#\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'A', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-A\", \"sym\":\"A\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {A} }\\\\\\eqlabel{ {\"onclick\":\"event.stopPropagation(); onClickEq(this, 'heartlib', ['m'], false, [], [], 'bSwgayA9ICNB');\"} }{}\n \\\\\nwhere \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'a', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-a_i\", \"sym\":\"a\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {a} }_{i} & ∈ \\mathbb{R} \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'S', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-S\", \"sym\":\"S\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {S} } & ∈ \\{\\mathbb{Z}\\} \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'A', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-A\", \"sym\":\"A\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {A} } & ∈ \\mathbb{R}^{ 2 \\times 3 } \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'x', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-x\", \"sym\":\"x\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {x} } & ∈ \\mathbb{R}^{ \\#\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'a', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-a\", \"sym\":\"a\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {a} }} \\\\\n\\\\\n\\end{align*}\n"
