 "outputs": {
  "numpy": "\"\"\"\nf(s) = s / 2 where s: ℝ\n                    g(v) = 2 v where v: ℝ ^ 3\n                    a = f(k)\n                    b = g(x)\n                    where\n                    k: ℤ\n                    x: ℤ ^ 3\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, k, x):\n        x = np.asarray(x, dtype=np.int64)\n        assert np.ndim(k) == 0\n        assert x.shape == (3,)\n        # a = f(k)\n        self.a = self.f(k)\n        # b = g(x)\n        self.b = self.g(x)\n\n    def f(self, s):\n        assert np.ndim(s) == 0\n\n        return (s) / (2)\n\n    def g(self, v):\n        v = np.asarray(v, dtype=np.float64)\n        assert v.shape == (3,)\n\n        return 2 * v\n\n\n\n\n\n",
  "eigen": "/*\nf(s) = s / 2 where s: ℝ\n                    g(v) = 2 v where v: ℝ ^ 3\n                    a = f(k)\n                    b = g(x)\n                    where\n                    k: ℤ\n                    x: ℤ ^ 3\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    DT a;\n    Eigen::Matrix<DT, 3, 1> b;\n\n    template<typename REAL>\n    REAL f(\n        const REAL & s)\n    {\n        return s / REAL(2);    \n    }\n    template<typename REAL>\n    Eigen::Matrix<REAL, 3, 1> g(\n        const Eigen::Matrix<REAL, 3, 1> & v)\n    {\n        return REAL(2) * v;    \n    }\n    heartlib(\n        const int & k,\n        const Eigen::Matrix<int, 3, 1> & x)\n    {\n    \n        // a = f(k)\n        a = f(DT(k));\n        // b = g(x)\n        b = g(Eigen::Matrix<DT, 3, 1>((x).template cast<DT>()));\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\nf\\left( s \\right) & = \\frac{s}{2} \\text{{ where }}  s : \\mathbb{R} \\\\\ng\\left( v \\right) & = 2 v \\text{{ where }}  v : \\mathbb{R}^{ 3} \\\\\na & = f\\left( k \\right) \\\\\nb & = g\\left( x \\right) \\\\\n\\intertext{where} \nk & : \\mathbb{Z} \\\\\nx & : \\mathbb{Z}^{ 3} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n & f\\left( s \\right) & = \\frac{s}{2} \\text{{ where }}  s : \\mathbb{R} \\\\\n & g\\left( v \\right) & = 2 v \\text{{ where }}  v : \\mathbb{R}^{ 3} \\\\\na & = f\\left( k \\right) \\\\\nb & = g\\left( x \\right) \\\\\nwhere \\\\\nk & : \\mathbb{Z} \\\\\nx & : \\mathbb{Z}^{ 3} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(k, x)\n% output = heartlib(k, x)\n%\n%    f(s) = s / 2 where s: ℝ\n%                        g(v) = 2 v where v: ℝ ^ 3\n%                        a = f(k)\n%                        b = g(x)\n%                        where\n%                        k: ℤ\n%                        x: ℤ ^ 3\n    x = reshape(x,[],1);\n\n    assert(numel(k) == 1);\n    assert( numel(x) == 3 );\n\n    % a = f(k)\n\n    a = f(k);\n    % b = g(x)\n\n    b = g(x);\n    function [ret] = f(s)\n        assert(numel(s) == 1);\n\n        ret = s / 2;\n    end\n\n    function [ret_1] = g(v)\n        v = reshape(v,[],1);\n        assert( numel(v) == 3 );\n\n        ret_1 = 2 * v;\n    end\n\n    output.a = a;\n    output.b = b;\n    output.f = @f;\n    output.g = @g;\nend\n",
  "macromathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n & \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'f', 'heartlib', 'def', false, '')\", \"id\":\"heartlib-f\", \"sym\":\"f\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"def\", \"case\":\"equation\"} }{ {f} }\\left( \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 's', 'heartlib', 'use', true, 'f')\", \"id\":\"heartlib-s\", \"sym\":\"s\", \"func\":\"heartlib\",  \"localFunc\":\"f\", \"type\":\"use\", \"case\":\"equation\"} }{ {s} } \\right) & = \\frac{\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 's', 'heartlib', 'use', true, 'f')\", \"id\":\"heartlib-s\", \"sym\":\"s\", \"func\":\"heartlib\",  \"localFunc\":\"f\", \"type\":\"use\", \"case\":\"equation\"} }{ {s} }}{2} \\text{{ where }}  \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 's', 'heartlib', 'use', true, 'f')\", \"id\":\"heartlib-s\", \"sym\":\"s\", \"func\":\"heartlib\",  \"localFunc\":\"f\", \"type\":\"use\", \"case\":\"equation\"} }{ {s} } : \\mathbb{R} \\\\\n & \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'g', 'heartlib', 'def', false, 'f')\", \"id\":\"heartlib-g\", \"sym\":\"g\", \"func\":\"heartlib\",  \"localFunc\":\"f\", \"type\":\"def\", \"case\":\"equation\"} }{ {g} }\\left( \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'v', 'heartlib', 'use', true, 'g')\", \"id\":\"heartlib-v\", \"sym\":\"v\", \"func\":\"heartlib\",  \"localFunc\":\"g\", \"type\":\"use\", \"case\":\"equation\"} }{ {v} } \\right) & = 2 \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'v', 'heartlib', 'use', true, 'g')\", \"id\":\"heartlib-v\", \"sym\":\"v\", \"func\":\"heartlib\",  \"localFunc\":\"g\", \"type\":\"use\", \"case\":\"equation\"} }{ {v} } \\text{{ where }}  \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'v', 'heartlib', 'use', true, 'g')\", \"id\":\"heartlib-v\", \"sym\":\"v\", \"func\":\"heartlib\",  \"localFunc\":\"g\", \"type\":\"use\", \"case\":\"equation\"} }{ {v} } : \\mathbb{R}^{ 3} \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'a', 'heartlib', 'def', false, 'g')\", \"id\":\"heartlib-a\", \"sym\":\"a\", \"func\":\"heartlib\",  \"localFunc\":\"g\", \"type\":\"def\", \"case\":\"equation\"} }{ {a} } & = \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'f', 'heartlib', 'use', false, 'g')\", \"id\":\"heartlib-f\", \"sym\":\"f\", \"func\":\"heartlib\",  \"localFunc\":\"g\", \"type\":\"use\", \"case\":\"equation\"} }{ {f} }\\left( \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'k', 'heartlib', 'use', false, 'g')\", \"id\":\"heartlib-k\", \"sym\":\"k\", \"func\":\"heartlib\",  \"localFunc\":\"g\", \"type\":\"use\", \"case\":\"equation\"} }{ {k} } \\right)\\\\\\eqlabel{ {\"onclick\":\"event.stopPropagation(); onClickEq(this, 'heartlib', ['f', 'k', 'a'], false, [], [], 'YSA9IGYoayk=');\"} }{}\n \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'b', 'heartlib', 'def', false, 'g')\", \"id\":\"heartlib-b\", \"sym\":\"b\", \"func\":\"heartlib\",  \"localFunc\":\"g\", \"type\":\"def\", \"case\":\"equation\"} }{ {b} } & = \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'g', 'heartlib', 'use', false, 'g')\", \"id\":\"heartlib-g\", \"sym\":\"g\", \"func\":\"heartlib\",  \"localFunc\":\"g\", \"type\":\"use\", \"case\":\"equation\"} }{ {g} }\\left( \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'x', 'heartlib', 'use', false, 'g')\", \"id\":\"heartlib-x\", \"sym\":\"x\", \"func\":\"heartlib\",  \"localFunc\":\"g\", \"type\":\"use\", \"case\":\"equation\"} }{ {x} } \\right)\\\\\\eqlabel{ {\"onclick\":\"event.stopPropagation(); onClickEq(this, 'heartlib', ['g', 'x', 'b'], false, [], [], 'YiA9IGcoeCk=');\"} }{}\n \\\\\nwhere 