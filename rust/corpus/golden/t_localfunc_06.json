 "outputs": {
  "numpy": "\"\"\"\ng(c) = (∑_(j ∈ S) (a + b c) where a, b = v_j) where c ∈ ℝ\n                    z = g(2)\n                    where\n                    S ∈ {ℤ}\n                    v_i ∈ ℝ^2\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, S, v):\n        S = frozenset(S)\n        v = np.asarray(v, dtype=np.float64)\n        dim_0 = v.shape[0]\n        assert v.shape == (dim_0, 2, )\n\n        self.S = S\n        self.v = v\n        # z = g(2)\n        self.z = self.g(2)\n\n    def g(self, c):\n        assert np.ndim(c) == 0\n\n        sum_0 = 0\n        for j in self.S:\n            rhs = self.v[j-1]\n            a = rhs[0]\n            b = rhs[1]\n            sum_0 += (a + b * c)\n        return (sum_0)\n\n\n\n\n\n",
  "eigen": "/*\ng(c) = (∑_(j ∈ S) (a + b c) where a, b = v_j) where c ∈ ℝ\n                    z = g(2)\n                    where\n                    S ∈ {ℤ}\n                    v_i ∈ ℝ^2\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    DT z;\n    std::vector<int > S;\n    std::vector<Eigen::Matrix<double, 2, 1>> v;\n    template<typename REAL>\n    REAL g(\n        const REAL & c)\n    {\n        REAL sum_0 = 0;\n        for(int j : this->S){\n                // a, b = v_j\n            Eigen::Matrix<REAL, 2, 1> rhs = this->v.at(j-1);\n            REAL a = rhs(0);\n            REAL b = rhs(1);\n            sum_0 += (a + b * c);\n        }\n        return (sum_0);    \n    }\n    heartlib(\n        const std::vector<int > & S,\n        const std::vector<Eigen::Matrix<double, 2, 1>> & v)\n    {\n        const long dim_0 = v.size();\n        this->S = S;\n        this->v = v;\n        // z = g(2)\n        z = g(DT(2));\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\ng\\left( c \\right) & = \\left( \\sum_{j\\in S} \\left( a + b c \\right) \\qquad \\text{{ where }}  a,b = v_{ j } \\right) \\text{{ where }}  c ∈ \\mathbb{R} \\\\\nz & = g\\left( 2 \\right) \\\\\n\\intertext{where} \nS & ∈ \\{\\mathbb{Z}\\} \\\\\nv_{i} & ∈ \\mathbb{R}^{ 2} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n & g\\left( c \\right) & = \\left( \\sum_{j\\in S} \\left( a + b c \\right) \\qquad \\text{{ where }}  a,b = v_{ j } \\right) \\text{{ where }}  c ∈ \\mathbb{R} \\\\\nz & = g\\left( 2 \\right) \\\\\nwhere \\\\\nS & ∈ \\{\\mathbb{Z}\\} \\\\\nv_{i} & ∈ \\mathbb{R}^{ 2} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(S, v)\n% output = heartlib(S, v)\n%\n%    g(c) = (∑_(j ∈ S) (a + b c) where a, b = v_j) where c ∈ ℝ\n%                        z = g(2)\n%                        where\n%                        S ∈ {ℤ}\n%                        v_i ∈ ℝ^2\n    dim_0 = size(v, 1);\n    assert( isequal(size(v), [dim_0, 2]) );\n\n    % z = g(2)\n\n    z = g(2);\n    function [ret] = g(c)\n        assert(numel(c) == 1);\n\n        sum_0 = 0;\n        range = S;\n        for index = 1:length(range)\n            j = range(index);\n                [a, b] = v(j,:)';\n            sum_0 = sum_0 + (a + b * c);\n        end\n        ret = (sum_0);\n    end\n\n    output.z = z;\n    output.g = @g;\n    output.S = S;    \n    output.v = v;\nend\n",
