  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n & f\\left( x \\right) & = x + x \\text{{ where }}  x : \\mathbb{R}^{ 3} \\\\\na & = f\\left( y + y \\right) \\\\\nb & = f\\left( 2 y \\right) \\\\\nc & = f\\left( A y \\right) \\\\\nwhere \\\\\ny & : \\mathbb{R}^{ 3} \\\\\nA & : \\mathbb{R}^{ 3 \\times 3 } \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(y, A)\n% output = heartlib(y, A)\n%\n%    f(x) = x + x where x: ℝ ^ 3\n%                        a = f(y + y)\n%                        b = f(2 y)\n%                        c = f(A y)\n%                        where\n%                        y: ℝ ^ 3\n%                        A: ℝ ^ (3 × 3)\n    y = reshape(y,[],1);\n\n    assert( numel(y) == 3 );\n    assert( isequal(size(A), [3, 3]) );\n\n    % a = f(y + y)\n\n    a = f(y + y);\n    % b = f(2 y)\n\n    b = f(2 * y);\n    % c = f(A y)\n\n    c = f(A * y);\n    function [ret] = f(x)\n        x = reshape(x,[],1);\n        assert( numel(x) == 3 );\n\n        ret = x + x;\n    end\n\n    output.a = a;\n    output.b = b;\n    output.c = c;\n    output.f = @f;\nend\n",
