  "numpy": "\"\"\"\nf(x) = x + x where x: ℝ ^ 3\n                    a = f(y + y)\n                    b = f(2 y)\n                    c = f(A y)\n                    where\n                    y: ℝ ^ 3\n                    A: ℝ ^ (3 × 3)\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, y, A):\n        y = np.asarray(y, dtype=np.float64)\n        A = np.asarray(A, dtype=np.float64)\n        assert y.shape == (3,)\n        assert A.shape == (3, 3)\n        # a = f(y + y)\n        self.a = self.f(y + y)\n        # b = f(2 y)\n        self.b = self.f(2 * y)\n        # c = f(A y)\n        self.c = self.f(A @ y)\n\n    def f(self, x):\n        x = np.asarray(x, dtype=np.float64)\n        assert x.shape == (3,)\n\n        return x + x\n\n\n\n\n\n",
  "eigen": "/*\nf(x) = x + x where x: ℝ ^ 3\n                    a = f(y + y)\n                    b = f(2 y)\n                    c = f(A y)\n                    where\n                    y: ℝ ^ 3\n                    A: ℝ ^ (3 × 3)\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    Eigen::Matrix<DT, 3, 1> a;\n    Eigen::Matrix<DT, 3, 1> b;\n    Eigen::Matrix<DT, 3, 1> c;\n\n    template<typename REAL>\n    Eigen::Matrix<REAL, 3, 1> f(\n        const Eigen::Matrix<REAL, 3, 1> & x)\n    {\n        return x + x;    \n    }\n    heartlib(\n        const Eigen::Matrix<double, 3, 1> & y,\n        const Eigen::Matrix<double, 3, 3> & A)\n    {\n    \n        // a = f(y + y)\n        a = f((y + y).eval());\n        // b = f(2 y)\n        b = f((DT(2) * y).eval());\n        // c = f(A y)\n        c = f((A * y).eval());\n    }\n};\n\n\n\n\n\n",
