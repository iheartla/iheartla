 "outputs": {
  "numpy": "\"\"\"\ng(f, p) = a where f ∈ ℤ, p ∈ ℝ,\n                    a = p + i,\n                    i, j = v_f\n                    z = g(1, 2)\n                    where\n                    v_i ∈ ℝ^2\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, v):\n        v = np.asarray(v, dtype=np.float64)\n        dim_0 = v.shape[0]\n        assert v.shape == (dim_0, 2, )\n\n        self.v = v\n        # z = g(1, 2)\n        self.z = self.g(1, 2)\n\n    def g(self, f, p):\n        assert np.ndim(f) == 0\n        assert np.ndim(p) == 0\n\n        rhs = self.v[f-1]\n        i = rhs[0]\n        j = rhs[1]\n\n        # a = p + i\n        a = p + i\n        return a\n\n\n\n\n\n",
  "eigen": "/*\ng(f, p) = a where f ∈ ℤ, p ∈ ℝ,\n                    a = p + i,\n                    i, j = v_f\n                    z = g(1, 2)\n                    where\n                    v_i ∈ ℝ^2\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    DT z;\n    std::vector<Eigen::Matrix<double, 2, 1>> v;\n    template<typename REAL>\n    REAL g(\n        const int & f,\n        const REAL & p)\n    {\n        // i, j = v_f\n        Eigen::Matrix<REAL, 2, 1> rhs = this->v.at(f-1);\n        REAL i = rhs(0);\n        REAL j = rhs(1);\n\n        // a = p + i\n        REAL a = p + i;\n        return a;    \n    }\n    heartlib(const std::vector<Eigen::Matrix<double, 2, 1>> & v)\n    {\n        const long dim_0 = v.size();\n        this->v = v;\n        // z = g(1, 2)\n        z = g(1, DT(2));\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\ng\\left( f,p \\right) & = a\\\\ & \\begin{aligned}[t] \\text{ where }& \\\\ f & ∈ \\mathbb{Z}\\\\ p & ∈ \\mathbb{R}\\\\a & = p + i\\\\i,j & = v_{ f }\\end{aligned}  \\\\\nz & = g\\left( 1,2 \\right) \\\\\n\\intertext{where} \nv_{i} & ∈ \\mathbb{R}^{ 2} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n & g\\left( f,p \\right) & = a\\\\ & \\begin{aligned}[t] \\text{ where }& \\\\ f & ∈ \\mathbb{Z}\\\\ p & ∈ \\mathbb{R}\\\\a & = p + i\\\\i,j & = v_{ f }\\end{aligned}  \\\\\nz & = g\\left( 1,2 \\right) \\\\\nwhere \\\\\nv_{i} & ∈ \\mathbb{R}^{ 2} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(v)\n% output = heartlib(v)\n%\n%    g(f, p) = a where f ∈ ℤ, p ∈ ℝ,\n%                        a = p + i,\n%                        i, j = v_f\n%                        z = g(1, 2)\n%                        where\n%                        v_i ∈ ℝ^2\n    dim_0 = size(v, 1);\n    assert( isequal(size(v), [dim_0, 2]) );\n\n    % z = g(1, 2)\n\n    z = g(1, 2);\n    function [ret] = g(f, p)\n        assert(numel(f) == 1);\n        assert(numel(p) == 1);\n\n        [i, j] = v(f,:)';\n\n        % a = p + i\n        a = p + i;\n        ret = a;\n    end\n\n    output.z = z;\n    output.g = @g;\n    output.v = v;\nend\n",
