 "outputs": {
  "numpy": "\"\"\"\nB = [ A ; 1 ]\n        where\n        A: ℝ ^ 2: a matrix\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, A):\n        A = np.asarray(A, dtype=np.float64)\n        assert A.shape == (2,)\n        # B = [ A ; 1 ]\n        B_0 = np.vstack(((A).reshape(2, 1), 1))\n        self.B = B_0\n\n\n\n\n\n",
  "eigen": "/*\nB = [ A ; 1 ]\n        where\n        A: ℝ ^ 2: a matrix\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    Eigen::Matrix<DT, 3, 1> B;\n\n    heartlib(const Eigen::Matrix<double, 2, 1> & A)\n    {\n    \n        // B = [ A ; 1 ]\n        Eigen::Matrix<DT, 3, 1> B_0;\n        B_0 << A,\n        1;\n        B = B_0;\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\nB & = \\begin{bmatrix}\nA\\\\\n1\\\\\n\\end{bmatrix} \\\\\n\\intertext{where} \nA & : \\mathbb{R}^{ 2} \\text{ a matrix} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\nB & = \\begin{bmatrix}\nA\\\\\n1\\\\\n\\end{bmatrix} \\\\\nwhere \\\\\nA & : \\mathbb{R}^{ 2} \\text{ a matrix} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(A)\n% output = heartlib(A)\n%\n%    B = [ A ; 1 ]\n%            where\n%            A: ℝ ^ 2: a matrix\n    A = reshape(A,[],1);\n\n    assert( numel(A) == 2 );\n\n    % B = [ A ; 1 ]\n\n    B_0 = [[reshape(A, [2, 1])]; [1]];\n    B = B_0;\n    output.B = B;\nend\n",
