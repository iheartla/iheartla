 "outputs": {
  "numpy": "\"\"\"\nM_ij = { A_ij if A_ij > 0\n        -1 if A_ij < -2\n        0 otherwise\n        N_ij = { A_ij if A_ij > 0\n        where\n        A: ℝ ^ (2 × 2): a matrix\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, A):\n        A = np.asarray(A, dtype=np.float64)\n        assert A.shape == (2, 2)\n        # M_ij = { A_ij if A_ij > 0\n        #         -1 if A_ij < -2\n        #         0 otherwise\n        self.M = np.zeros((2, 2))\n        for i in range(1, 2+1):\n            for j in range(1, 2+1):\n                M_ij = 0\n                if A[i-1, j-1] > 0:\n                    M_ij = A[i-1, j-1]\n                elif A[i-1, j-1] < -2:\n                    M_ij = -1\n                else:\n                    M_ij = 0\n                self.M[i-1][j-1] = M_ij\n        # N_ij = { A_ij if A_ij > 0\n        self.N = np.zeros((2, 2))\n        for i in range(1, 2+1):\n            for j in range(1, 2+1):\n                N_ij = 0\n                if A[i-1, j-1] > 0:\n                    N_ij = A[i-1, j-1]\n                self.N[i-1][j-1] = N_ij\n\n\n\n\n\n",
