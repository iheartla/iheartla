 "outputs": {
  "numpy": "\"\"\"\nC = [ A   1   2  0  B]\n        where\n        A: ℝ ^ (1 × 2)\n        B: ℝ ^ (1 × 2) sparse  \n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, A, B):\n        A = np.asarray(A, dtype=np.float64)\n        assert A.shape == (1, 2)\n        assert B.shape == (1, 2)\n        # C = [ A   1   2  0  B]\n        C_0 = sparse.hstack((A, [[1]], [[2]], [[0]], B))\n        self.C = C_0\n\n\n\n\n\n",
  "eigen": "/*\nC = [ A   1   2  0  B]\n        where\n        A: ℝ ^ (1 × 2)\n        B: ℝ ^ (1 × 2) sparse  \n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    Eigen::SparseMatrix<double> C;\n\n    heartlib(\n        const Eigen::Matrix<double, 1, 2> & A,\n        const Eigen::SparseMatrix<double> & B)\n    {\n        assert( B.rows() == 1 );\n        assert( B.cols() == 2 );\n        // C = [ A   1   2  0  B]\n        Eigen::SparseMatrix<DT> C_0(1, 7);\n        std::vector<Eigen::Triplet<DT> > tripletListC_0;\n        Eigen::SparseMatrix<DT> tmp = A.sparseView();\n        for (int k=0; k < tmp.outerSize(); ++k){\n            for (Eigen::SparseMatrix<DT>::InnerIterator it(tmp, k); it; ++it){\n                tripletListC_0.push_back(Eigen::Triplet<DT>((int)it.row()+0, (int)it.col()+0, it.value()));\n            }\n        }\n        tripletListC_0.push_back(Eigen::Triplet<DT>(0, 2, 1));\n        tripletListC_0.push_back(Eigen::Triplet<DT>(0, 3, 2));\n        tripletListC_0.push_back(Eigen::Triplet<DT>(0, 4, 0));\n        tmp = B;\n        for (int k=0; k < tmp.outerSize(); ++k){\n            for (Eigen::SparseMatrix<DT>::InnerIterator it(tmp, k); it; ++it){\n                tripletListC_0.push_back(Eigen::Triplet<DT>((int)it.row()+0, (int)it.col()+5, it.value()));\n            }\n        }\n        C_0.setFromTriplets(tripletListC_0.begin(), tripletListC_0.end());\n        C = C_0;\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\nC & = \\begin{bmatrix}\nA & 1 & 2 & 0 & B\\\\\n\\end{bmatrix} \\\\\n\\intertext{where} \nA & : \\mathbb{R}^{ 1 \\times 2 } \\\\\nB & : \\mathbb{R}^{ 1 \\times 2 } ,\\text{ sparse} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\nC & = \\begin{bmatrix}\nA & 1 & 2 & 0 & B\\\\\n\\end{bmatrix} \\\\\nwhere \\\\\nA & : \\mathbb{R}^{ 1 \\times 2 } \\\\\nB & : \\mathbb{R}^{ 1 \\times 2 } ,\\text{ sparse} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(A, B)\n% output = heartlib(A, B)\n%\n%    C = [ A   1   2  0  B]\n%            where\n%            A: ℝ ^ (1 × 2)\n%            B: ℝ ^ (1 × 2) sparse  \n    assert( isequal(size(A), [1, 2]) );\n    assert( isequal(size(B), [1, 2]) );\n\n    % C = [ A   1   2  0  B]\n\n    C_0 = [[A, 1, 2, 0, B]];\n    C = C_0;\n    output.C = C;\nend\n",
  "macromathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'C', 'heartlib', 'def', false, '')\", \"id\":\"heartlib-C\", \"sym\":\"C\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"def\", \"case\":\"equation\"} }{ {C} } & = \\begin{bmatrix}\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'A', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-A\", \"sym\":\"A\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {A} } & 1 & 2 & 0 & \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'B', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-B\", \"sym\":\"B\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {B} }\\\\\n\\end{bmatrix}\\\\\\eqlabel{ {\"onclick\":\"event.stopPropagation(); onClickEq(this, 'heartlib', ['A', 'B', 'C'], false, [], [], 'QyA9IFsgQSAgIDEgICAyICAwICBCXQ==');\"} }{}\n \\\\\nwhere \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'A', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-A\", \"sym\":\"A\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {A} } & : \\mathbb{R}^{ 1 \\times 2 } \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'B', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-B\", \"sym\":\"B\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {B} } & : \\mathbb{R}^{ 1 \\times 2 } ,\\text{ sparse} \\\\\n\\\\\n\\end{align*}\n"
