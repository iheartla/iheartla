 "outputs": {
  "numpy": "\"\"\"\nG_ij = { P_ij + J_ij  if  ( i , j ) ∈ E\n        0 otherwise\n\n        where\n        P: ℝ ^ (4 × 4): a matrix\n        J: ℝ ^ (4 × 4): a matrix\n        G: ℝ ^ (10 × 10): a matrix\n        E: { ℤ × ℤ } index\n        \n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, P, J, E):\n        P = np.asarray(P, dtype=np.float64)\n        J = np.asarray(J, dtype=np.float64)\n        E = frozenset(E)\n        assert P.shape == (4, 4)\n        assert J.shape == (4, 4)\n        assert all( len(el) == 2 for el in E )\n        # G_ij = { P_ij + J_ij  if  ( i , j ) ∈ E\n        #         0 otherwise\n        Gij_0 = []\n        Gvals_0 = []\n        for tuple in E:\n            i = tuple[0]+1\n            j = tuple[1]+1\n            Gij_0.append((i-1, j-1))\n            Gvals_0.append(P[i-1, j-1] + J[i-1, j-1])\n        sparse_0 = scipy.sparse.coo_matrix((Gvals_0, np.asarray(Gij_0).T), shape=(10, 10))\n        self.G = sparse_0\n\n\n\n\n\n",
  "eigen": "/*\nG_ij = { P_ij + J_ij  if  ( i , j ) ∈ E\n        0 otherwise\n\n        where\n        P: ℝ ^ (4 × 4): a matrix\n        J: ℝ ^ (4 × 4): a matrix\n        G: ℝ ^ (10 × 10): a matrix\n        E: { ℤ × ℤ } index\n        \n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    Eigen::SparseMatrix<double> G;\n\n    heartlib(\n        const Eigen::Matrix<double, 4, 4> & P,\n        const Eigen::Matrix<double, 4, 4> & J,\n        const std::vector<std::tuple< int, int > > & E)\n    {\n    \n        // G_ij = { P_ij + J_ij  if  ( i , j ) ∈ E\n        //         0 otherwise\n        G.resize(10, 10);\n        std::vector<Eigen::Triplet<DT> > tripletList_G;\n        for(const std::tuple< int, int >& tuple : E){\n            int i = std::get<0>(tuple)+1;\n            int j = std::get<1>(tuple)+1;\n            tripletList_G.push_back(Eigen::Triplet<DT>(i-1, j-1, P(i-1, j-1) + J(i-1, j-1)));\n        }\n        G.setFromTriplets(tripletList_G.begin(), tripletList_G.end());\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\nG_{i, j} & = \\begin{cases} P_{i, j} + J_{i, j} & \\text{if }  \\left( i, j \\right) \\in E  \\\\ 0 & \\text{otherwise} \\end{cases} \\\\\n\\intertext{where} \nP & : \\mathbb{R}^{ 4 \\times 4 } \\text{ a matrix} \\\\\nJ & : \\mathbb{R}^{ 4 \\times 4 } \\text{ a matrix} \\\\\nG & : \\mathbb{R}^{ 10 \\times 10 } \\text{ a matrix} \\\\\nE & : \\{\\mathbb{Z} \\times \\mathbb{Z}\\} ,\\text{ index} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\nG_{i, j} & = \\begin{cases} P_{i, j} + J_{i, j} & \\text{if }  \\left( i, j \\right) \\in E  \\\\ 0 & \\text{otherwise} \\end{cases} \\\\\nwhere \\\\\nP & : \\mathbb{R}^{ 4 \\times 4 } \\text{ a matrix} \\\\\nJ & : \\mathbb{R}^{ 4 \\times 4 } \\text{ a matrix} \\\\\nG & : \\mathbb{R}^{ 10 \\times 10 } \\text{ a matrix} \\\\\nE & : \\{\\mathbb{Z} \\times \\mathbb{Z}\\} ,\\text{ index} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(P, J, E)\n% output = heartlib(P, J, E)\n%\n%    G_ij = { P_ij + J_ij  if  ( i , j ) ∈ E\n%            0 otherwise\n%    \n%            where\n%            P: ℝ ^ (4 × 4): a matrix\n%            J: ℝ ^ (4 × 4): a matrix\n%            G: ℝ ^ (10 × 10): a matrix\n%            E: { ℤ × ℤ } index\n%            \n    assert( isequal(size(P), [4, 4]) );\n    assert( isequal(size(J), [4, 4]) );\n    assert(size(E,2) == 2)\n\n    % G_ij = { P_ij + J_ij  if  ( i , j ) ∈ E\n    %         0 otherwise\n\n    Gij_0 = zeros(2,0);\n    Gvals_0 = zeros(1,0);\n    for index = 1:size(E, 1)\n        i = E(index, 1);\n        j = E(index, 2);\n        Gij_0(1:2,end+1) = [i;j];\n        Gvals_0(end+1) = P(i, j) + J(i, j);\n    end\n    sparse_0 = sparse(Gij_0(1,:),Gij_0(2,:),Gvals_0,10,10);\n    G = sparse_0;\n    output.G = G;\nend\n",
  "macromathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'G', 'heartlib', 'def', false, '')\", \"id\":\"heartlib-G\", \"sym\":\"G\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"def\", \"case\":\"equation\"} }{ {G} }_{i, j} & = \\begin{cases} \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'P', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-P\", \"sym\":\"P\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {P} }_{i, j} + \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'J', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-J\", \"sym\":\"J\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {J} }_{i, j} & \\text{if }  \\left( \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'i', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-i\", \"sym\":\"i\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {i} }, \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'j', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-j\", \"sym\":\"j\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {j} } \\right) \\in \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'E', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-E\", \"sym\":\"E\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {E} }  \\\\ 0 & \\text{otherwise} \\end{cases}\\\\\\eqlabel{ {\"onclick\":\"event.stopPropagation(); onClickEq(this, 'heartlib', ['G'], false, [], [], 'R19paiA9IHsgUF9paiArIEpfaWogIGlmICAoIGkgLCBqICkg4oiIIEUKICAgICAgICAwIG90aGVyd2lzZQ==');\"} }{}\n \\\\\nwhere \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'P', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-P\", \"sym\":\"P\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {P} } & : \\mathbb{R}^{ 4 \\times 4 } \\text{ a matrix} \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'J', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-J\", \"sym\":\"J\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {J} } & : \\mathbb{R}^{ 4 \\times 4 } \\text{ a matrix} \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'G', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-G\", \"sym\":\"G\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {G} } & : \\mathbb{R}^{ 10 \\times 10 } \\text{ a matrix} \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'E', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-E\", \"sym\":\"E\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {E} } & : \\{\\mathbb{Z} \\times \\mathbb{Z}\\} ,\\text{ index} \\\\\n\\\\\n\\end{align*}\n"
