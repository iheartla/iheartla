 "outputs": {
  "numpy": "\"\"\"\nB = (1, A, 4) + (1, 1, 1, 1)\n        where\n        A: ℝ ^ 2: a vector\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, A):\n        A = np.asarray(A, dtype=np.float64)\n        assert A.shape == (2,)\n        # B = (1, A, 4) + (1, 1, 1, 1)\n        self.B = np.hstack((1, A, 4)) + np.hstack((1, 1, 1, 1))\n\n\n\n\n\n",
  "eigen": "/*\nB = (1, A, 4) + (1, 1, 1, 1)\n        where\n        A: ℝ ^ 2: a vector\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    Eigen::Matrix<DT, 4, 1> B;\n\n    heartlib(const Eigen::Matrix<double, 2, 1> & A)\n    {\n    \n        // B = (1, A, 4) + (1, 1, 1, 1)\n        Eigen::Matrix<DT, 4, 1> B_0;\n        B_0 << 1, A, 4;\n        Eigen::Matrix<int, 4, 1> B_1;\n        B_1 << 1, 1, 1, 1;\n        B = B_0 + (B_1).template cast<DT>();\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\nB & = \\begin{pmatrix}\n1\\\\A\\\\4\\end{pmatrix} + \\begin{pmatrix}\n1\\\\1\\\\1\\\\1\\end{pmatrix} \\\\\n\\intertext{where} \nA & : \\mathbb{R}^{ 2} \\text{ a vector} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\nB & = \\begin{pmatrix}\n1\\\\A\\\\4\\end{pmatrix} + \\begin{pmatrix}\n1\\\\1\\\\1\\\\1\\end{pmatrix} \\\\\nwhere \\\\\nA & : \\mathbb{R}^{ 2} \\text{ a vector} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(A)\n% output = heartlib(A)\n%\n%    B = (1, A, 4) + (1, 1, 1, 1)\n%            where\n%            A: ℝ ^ 2: a vector\n    A = reshape(A,[],1);\n\n    assert( numel(A) == 2 );\n\n    % B = (1, A, 4) + (1, 1, 1, 1)\n\n    B = [1; A; 4] + [1; 1; 1; 1];\n    output.B = B;\nend\n",
  "macromathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'B', 'heartlib', 'def', false, '')\", \"id\":\"heartlib-B\", \"sym\":\"B\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"def\", \"case\":\"equation\"} }{ {B} } & = \\begin{pmatrix}\n1\\\\\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'A', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-A\", \"sym\":\"A\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {A} }\\\\4\\end{pmatrix} + \\begin{pmatrix}\n1\\\\1\\\\1\\\\1\\end{pmatrix}\\\\\\eqlabel{ {\"onclick\":\"event.stopPropagation(); onClickEq(this, 'heartlib', ['A', 'B'], false, [], [], 'QiA9ICgxLCBBLCA0KSArICgxLCAxLCAxLCAxKQ==');\"} }{}\n \\\\\nwhere \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'A', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-A\", \"sym\":\"A\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {A} } & : \\mathbb{R}^{ 2} \\text{ a vector} \\\\\n\\\\\n\\end{align*}\n"
