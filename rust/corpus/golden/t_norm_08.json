  "numpy": "\"\"\"\nA = |a|\n                    where \n                    a: scalar\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, a):\n        assert np.ndim(a) == 0\n        # A = |a|\n        self.A = np.absolute(a)\n\n\n\n\n\n",
