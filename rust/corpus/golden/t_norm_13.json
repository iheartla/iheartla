 "outputs": {
  "numpy": "\"\"\"\nA = ||T||\n                    where \n                    T: ℝ ^ 3: vector\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, T):\n        T = np.asarray(T, dtype=np.float64)\n        assert T.shape == (3,)\n        # A = ||T||\n        self.A = np.linalg.norm(T, 2)\n\n\n\n\n\n",
  "eigen": "/*\nA = ||T||\n                    where \n                    T: ℝ ^ 3: vector\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    DT A;\n\n    heartlib(const Eigen::Matrix<double, 3, 1> & T)\n    {\n    \n        // A = ||T||\n        A = (T).template lpNorm<2>();\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\nA & = \\left\\|T\\right\\| \\\\\n\\intertext{where} \nT & : \\mathbb{R}^{ 3} \\text{ vector} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\nA & = \\left\\|T\\right\\| \\\\\nwhere \\\\\nT & : \\mathbb{R}^{ 3} \\text{ vector} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(T)\n% output = heartlib(T)\n%\n%    A = ||T||\n%                        where \n%                        T: ℝ ^ 3: vector\n    T = reshape(T,[],1);\n\n    assert( numel(T) == 3 );\n\n    % A = ||T||\n\n    A = norm(T, 2);\n    output.A = A;\nend\n",
