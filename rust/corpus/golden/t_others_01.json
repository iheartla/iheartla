 "outputs": {
  "numpy": "\"\"\"\nc = int_[1, 2] ia 𝕕i\n        where \n        a: scalar \n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, a):\n        assert np.ndim(a) == 0\n        # c = int_[1, 2] ia 𝕕i\n        self.c = quad(lambda i: i * a, 1, 2)[0]\n\n\n\n\n\n",
