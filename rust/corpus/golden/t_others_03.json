 "outputs": {
  "numpy": "\"\"\"\nc = int_0^3  int_[1, 2] ia 𝕕i 𝕕j\n        where \n        a: scalar \n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, a):\n        assert np.ndim(a) == 0\n        # c = int_0^3  int_[1, 2] ia 𝕕i 𝕕j\n        self.c = quad(lambda j: quad(lambda i: i * a, 1, 2)[0], 0, 3)[0]\n\n\n\n\n\n",
  "eigen": "/*\nc = int_0^3  int_[1, 2] ia 𝕕i 𝕕j\n        where \n        a: scalar \n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    DT c;\n\n    heartlib(const double & a)\n    {\n    \n        // c = int_0^3  int_[1, 2] ia 𝕕i 𝕕j\n        c = ;\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\nc & = \\int_{0}^{3} \\int_{1}^{2} i a di dj \\\\\n\\intertext{where} \na & : \\mathbb{R} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\nc & = \\int_{0}^{3} \\int_{1}^{2} i a di dj \\\\\nwhere \\\\\na & : \\mathbb{R} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(a)\n% output = heartlib(a)\n%\n%    c = int_0^3  int_[1, 2] ia 𝕕i 𝕕j\n%            where \n%            a: scalar \n    assert(numel(a) == 1);\n\n    % c = int_0^3  int_[1, 2] ia 𝕕i 𝕕j\n\n    c = integral(@(j) integral(@(i) i * a, 1, 2,'ArrayValued',true), 0, 3,'ArrayValued',true);\n    output.c = c;\nend\n",
