 "outputs": {
  "numpy": "\"\"\"\nb = argmax_(i ∈ ℝ^3) i⋅a\n        s.t.\n        i_1 > 4\n        i_1 < 9\n        i_2 > 4\n        i_2 < 9\n        i_3 > 4\n        i_3 < 9\n        where \n        a: ℝ^3 \n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, a):\n        a = np.asarray(a, dtype=np.float64)\n        assert a.shape == (3,)\n\n        self.a = a\n        def pack(i):\n            return np.concatenate([i])\n        def unpack(X):\n            return X[0:3]\n        def cons(X):\n            i = unpack(X)\n            return i[1-1] - 4\n        def cons_1(X):\n            i = unpack(X)\n            return 9 - i[1-1]\n        def cons_2(X):\n            i = unpack(X)\n            return i[2-1] - 4\n        def cons_3(X):\n            i = unpack(X)\n            return 9 - i[2-1]\n        def cons_4(X):\n            i = unpack(X)\n            return i[3-1] - 4\n        def cons_5(X):\n            i = unpack(X)\n            return 9 - i[3-1]\n        cons_6 = ({'type': 'ineq', 'fun': cons}, {'type': 'ineq', 'fun': cons_1}, {'type': 'ineq', 'fun': cons_2}, {'type': 'ineq', 'fun': cons_3}, {'type': 'ineq', 'fun': cons_4}, {'type': 'ineq', 'fun': cons_5})\n        def target(X):\n            i = unpack(X)\n            return -(np.dot((i).ravel(), (a).ravel()))\n        opt = minimize(target, np.zeros(3), constraints=cons_6)\n        i = unpack(opt.x)\n        self.b = unpack(opt.x)\n        self.i = i\n\n\n\n\n\n",
  "eigen": "/*\nb = argmax_(i ∈ ℝ^3) i⋅a\n        s.t.\n        i_1 > 4\n        i_1 < 9\n        i_2 > 4\n        i_2 < 9\n        i_3 > 4\n        i_3 < 9\n        where \n        a: ℝ^3 \n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include <LBFGS.h>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    Eigen::Matrix<DT, 3, 1> b;\n    Eigen::Matrix<double, 3, 1> a;\n    heartlib(const Eigen::Matrix<double, 3, 1> & a)\n    {\n    \n        this->a = a;\n        // b = argmax_(i ∈ ℝ^3) i⋅a\n        //         s.t.\n        //         i_1 > 4\n        //         i_1 < 9\n        //         i_2 > 4\n        //         i_2 < 9\n        //         i_3 > 4\n        //         i_3 < 9\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\n\\begin{aligned} b = \\argmax_{i  \\in \\mathbb{R}^{ 3}} \\quad & i \\cdot a \\\\\n\\textrm{s.t.} \\quad &i_{ 1 } > 4\\\\\n & i_{ 1 } < 9\\\\\n & i_{ 2 } > 4\\\\\n & i_{ 2 } < 9\\\\\n & i_{ 3 } > 4\\\\\n & i_{ 3 } < 9\n\\end{aligned} \\\\\n\\intertext{where} \na & : \\mathbb{R}^{ 3} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n\\begin{aligned} b = \\argmax_{i  \\in \\mathbb{R}^{ 3}} \\quad & i \\cdot a \\\\\n\\textrm{s.t.} \\quad &i_{ 1 } > 4\\\\\n & i_{ 1 } < 9\\\\\n & i_{ 2 } > 4\\\\\n & i_{ 2 } < 9\\\\\n & i_{ 3 } > 4\\\\\n & i_{ 3 } < 9\n\\end{aligned} \\\\\nwhere \\\\\na & : \\mathbb{R}^{ 3} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(a)\n% output = heartlib(a)\n%\n%    b = argmax_(i ∈ ℝ^3) i⋅a\n%            s.t.\n%            i_1 > 4\n%            i_1 < 9\n%            i_2 > 4\n%            i_2 < 9\n%            i_3 > 4\n%            i_3 < 9\n%            where \n%            a: ℝ^3 \n    a = reshape(a,[],1);\n\n    assert( numel(a) == 3 );\n\n    i = optimvar('i', 3);\n    prob = optimproblem;\n    prob.Constraints.cons1 = i(1) >= 4;\n    prob.Constraints.cons2 = i(1) <= 9;\n    prob.Constraints.cons3 = i(2) >= 4;\n    prob.Constraints.cons4 = i(2) <= 9;\n    prob.Constraints.cons5 = i(3) >= 4;\n    prob.Constraints.cons6 = i(3) <= 9;\n    prob.Objective = -(dot(i,a));\n    [optimize, ~] = solve(prob);\n    b = optimize.i;\n    output.b = b;\n    output.a = a;\nend\n",
  "macromathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n\\begin{aligned} \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'b', 'heartlib', 'def', false, '')\", \"id\":\"heartlib-b\", \"sym\":\"b\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"def\", \"case\":\"equation\"} }{ {b} } = \\argmax_{i  \\in \\mathbb{R}^{ 3}} \\quad & \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'i', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-i\", \"sym\":\"i\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {i} } \\cdot \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'a', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-a\", \"sym\":\"a\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {a} } \\\\\n\\textrm{s.t.} \\quad &\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'i', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-i\", \"sym\":\"i\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {i} }_{ 1 } > 4\\\\\n & \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'i', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-i\", \"sym\":\"i\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {i} }_{ 1 } < 9\\\\\n & \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'i', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-i\", \"sym\":\"i\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {i} }_{ 2 } > 4\\\\\n & \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'i', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-i\", \"sym\":\"i\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {i} }_{ 2 } < 9\\\\\n & \\idlabel{ {\"o