 "outputs": {
  "numpy": "\"\"\"\nb = argmin_(i ∈ ℝ) (i - 1)^2\n        s.t.\n        i = 2\n        where\n        a: scalar\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, a):\n        assert np.ndim(a) == 0\n        def pack(i):\n            return np.concatenate([[i]])\n        def unpack(X):\n            return X[0:1][0]\n        def cons(X):\n            i = unpack(X)\n            return i - 2\n        cons_1 = ({'type': 'eq', 'fun': cons})\n        def target(X):\n            i = unpack(X)\n            return np.power(np.asarray((i - 1), dtype=np.float64), 2)\n        opt = minimize(target, np.zeros(1), constraints=cons_1)\n        i = unpack(opt.x)\n        self.b = unpack(opt.x)\n        self.i = i\n\n\n\n\n\n",
  "eigen": "/*\nb = argmin_(i ∈ ℝ) (i - 1)^2\n        s.t.\n        i = 2\n        where\n        a: scalar\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include <LBFGS.h>\n#include <LBFGSB.h>\n#include <limits>\n#include <stdexcept>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    DT b;\n\n    heartlib(const double & a)\n    {\n    \n        // b = argmin_(i ∈ ℝ) (i - 1)^2\n        //         s.t.\n        //         i = 2\n            auto unpack = [&](const VectorD & X, DT & i)\n            {\n                i = X(0);\n            };\n            auto target = [&](const VectorD & X)\n            {\n                DT i;\n                unpack(X, i);\n                return DT(pow((i - 1), 2));\n            };\n            VectorD best_X;\n            DT best_f = std::numeric_limits<DT>::infinity();\n            auto helper = [&](const VectorD & X, VectorD & grad)\n            {\n                VectorD Xh = X;\n                for(int k = 0; k < X.size(); ++k)\n                {\n                    const DT h = 1e-6 * std::max(DT(1), std::abs(X(k)));\n                    Xh(k) = X(k) + h;\n                    const DT f_plus = target(Xh);\n                    Xh(k) = X(k) - h;\n                    const DT f_minus = target(Xh);\n                    Xh(k) = X(k);\n                    grad(k) = (f_plus - f_minus) / (2 * h);\n                }\n                const DT f = target(X);\n                if(f < best_f){ best_f = f; best_X = X; }  // the best point evaluated, kept if the line search gives up\n                return f;\n            };\n            VectorD lower = VectorD::Constant(1, -std::numeric_limits<DT>::infinity());\n            VectorD upper = VectorD::Constant(1, std::numeric_limits<DT>::infinity());\n            lower(0) = std::max(lower(0), DT(2));\n            upper(0) = std::min(upper(0), DT(2));\n            VectorD init = VectorD::Zero(1);\n            init = init.cwiseMax(lower).cwiseMin(upper);\n            DT fx;\n            LBFGSpp::LBFGSBParam<DT> param;\n            param.epsilon = 1e-8;\n            param.max_iterations = 1000;\n            LBFGSpp::LBFGSBSolver<DT> solver(param);\n            try\n            {\n                solver.minimize(helper, init, fx, lower, upper);\n            }\n            catch(const std::runtime_error &)\n            {\n                // LBFGSpp's line search could not decrease the objective further (e.g. near a\n                // nonsmooth or exactly zero minimum): use the best point evaluated\n                if(!(best_f < std::numeric_limits<DT>::infinity())) throw;\n            }\n            init = best_X;\n            fx = best_f;\n            DT i;\n            unpack(init, i);\n        b = i;\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\n\\begin{aligned} b = \\argmin_{i  \\in \\mathbb{R}} \\quad & {\\left( i - 1 \\right)}^{2} \\\\\n\\textrm{s.t.} \\quad &i = 2\n\\end{aligned} \\\\\n\\intertext{where} \na & : \\mathbb{R} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n\\begin{aligned} b = \\argmin_{i  \\in \\mathbb{R}} \\quad & {\\left( i - 1 \\right)}^{2} \\\\\n\\textrm{s.t.} \\quad &i = 2\n\\end{aligned} \\\\\nwhere \\\\\na & : \\mathbb{R} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(a)\n% output = heartlib(a)\n%\n%    b = argmin_(i ∈ ℝ) (i - 1)^2\n%            s.t.\n%            i = 2\n%            where\n%            a: scalar\n    assert(numel(a) == 1);\n\n    i = optimvar('i');\n    prob = optimproblem;\n    prob.Objective = (i - 1).^2;\n    [optimize, ~] = solve(prob);\n    b = optimize.i;\n    output.b = b;\nend\n",
  "macromathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n\\begin{aligned} \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'b', 'heartlib', 'def', false, '')\", \"id\":\"heartlib-b\", \"sym\":\"b\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"def\", \"case\":\"equation\"} }{ {b} } = \\argmin_{i  \\in \\mathbb{R}} \\quad & {\\left( \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'i', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-i\", \"sym\":\"i\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {i} } - 1 \\right)}^{2} \\\\\n\\textrm{s.t.} \\quad &\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'i', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-i\", \"sym\":\"i\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {i} } = 2\n\\end{aligned}\\\\\\eqlabel{ {\"onclick\":\"event.stopPropagation(); onClickEq(this, 'heartlib', ['i', 'b'], false, [], [], 'YiA9IGFyZ21pbl8oaSDiiIgg4oSdKSAoaSAtIDEpXjIKICAgICAgICBzLnQuCiAgICAgICAgaSA9IDI=');\"} }{}\n \\\\\nwhere \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'a', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-a\", \"sym\":\"a\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {a} } & : \\mathbb{R} \\\\\n\\\\\n\\end{align*}\n"
