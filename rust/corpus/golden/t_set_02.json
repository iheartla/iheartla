 "outputs": {
  "numpy": "\"\"\"\nL_i,j = { α_ij if j ∉ N(i)\n        M_i,j = { α_ij if j ∉ S\n        where\n        L: ℝ^(n×n)\n        M: ℝ^(n×n)\n        α: ℝ^(n×n)\n        N: ℤ -> {ℤ}\n        S: {ℤ}\n        \n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, α, N, S):\n        α = np.asarray(α, dtype=np.float64)\n        S = frozenset(S)\n        n = α.shape[1]\n        assert α.shape == (n, n)\n        # L_i,j = { α_ij if j ∉ N(i)\n        Lij_0 = []\n        Lvals_0 = []\n        for i in range(1, n+1):\n            for j in range(1, n+1):\n                if (j) not in N(i):\n                    Lij_0.append((i-1, j-1))\n                    Lvals_0.append(α[i-1, j-1])\n        sparse_0 = scipy.sparse.coo_matrix((Lvals_0, np.asarray(Lij_0).T), shape=(n, n))\n        self.L = sparse_0\n        # M_i,j = { α_ij if j ∉ S\n        Mij_0 = []\n        Mvals_0 = []\n        for i in range(1, n+1):\n            for j in range(1, n+1):\n                if (j) not in S:\n                    Mij_0.append((i-1, j-1))\n                    Mvals_0.append(α[i-1, j-1])\n        sparse_1 = scipy.sparse.coo_matrix((Mvals_0, np.asarray(Mij_0).T), shape=(n, n))\n        self.M = sparse_1\n\n\n\n\n\n",
  "eigen": "/*\nL_i,j = { α_ij if j ∉ N(i)\n        M_i,j = { α_ij if j ∉ S\n        where\n        L: ℝ^(n×n)\n        M: ℝ^(n×n)\n        α: ℝ^(n×n)\n        N: ℤ -> {ℤ}\n        S: {ℤ}\n        \n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    Eigen::SparseMatrix<double> L;\n    Eigen::SparseMatrix<double> M;\n\n    heartlib(\n        const Eigen::MatrixXd & α,\n        const std::function<std::vector<int >(int)> & N,\n        const std::vector<int > & S)\n    {\n        const long n = α.cols();\n        assert( α.rows() == n );\n        // L_i,j = { α_ij if j ∉ N(i)\n        L.resize(n, n);\n        std::vector<Eigen::Triplet<DT> > tripletList_L;\n        for( int i=1; i<=n; i++){\n            for( int j=1; j<=n; j++){\n                const std::vector<int >& set = N(i);\n                if(!std::binary_search(set.begin(), set.end(), int(j))){\n                    tripletList_L.push_back(Eigen::Triplet<DT>(i-1, j-1, α(i-1, j-1)));\n                }\n            }\n        }\n        L.setFromTriplets(tripletList_L.begin(), tripletList_L.end());\n        // M_i,j = { α_ij if j ∉ S\n        M.resize(n, n);\n        std::vector<Eigen::Triplet<DT> > tripletList_M;\n        for( int i=1; i<=n; i++){\n            for( int j=1; j<=n; j++){\n                if(!std::binary_search(S.begin(), S.end(), int(j))){\n                    tripletList_M.push_back(Eigen::Triplet<DT>(i-1, j-1, α(i-1, j-1)));\n                }\n            }\n        }\n        M.setFromTriplets(tripletList_M.begin(), tripletList_M.end());\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\nL_{i, j} & = \\begin{cases} α_{i, j} & \\text{if }  j \\notin N\\left( i \\right)  \\\\ \\end{cases}  \\\\\nM_{i, j} & = \\begin{cases} α_{i, j} & \\text{if }  j \\notin S  \\\\ \\end{cases}  \\\\\n\\intertext{where} \nL & : \\mathbb{R}^{ n \\times n } \\\\\nM & : \\mathbb{R}^{ n \\times n } \\\\\nα & : \\mathbb{R}^{ n \\times n } \\\\\nN & : \\mathbb{Z}\\rightarrow \\{\\mathbb{Z}\\} \\\\\nS & : \\{\\mathbb{Z}\\} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\nL_{i, j} & = \\begin{cases} α_{i, j} & \\text{if }  j \\notin N\\left( i \\right)  \\\\ \\end{cases}  \\\\\nM_{i, j} & = \\begin{cases} α_{i, j} & \\text{if }  j \\notin S  \\\\ \\end{cases}  \\\\\nwhere \\\\\nL & : \\mathbb{R}^{ n \\times n } \\\\\nM & : \\mathbb{R}^{ n \\times n } \\\\\nα & : \\mathbb{R}^{ n \\times n } \\\\\nN & : \\mathbb{Z}\\rightarrow \\{\\mathbb{Z}\\} \\\\\nS & : \\{\\mathbb{Z}\\} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(alpha, N, S)\n% output = heartlib(α, N, S)\n%\n%    L_i,j = { α_ij if j ∉ N(i)\n%            M_i,j = { α_ij if j ∉ S\n%            where\n%            L: ℝ^(n×n)\n%            M: ℝ^(n×n)\n%            α: ℝ^(n×n)\n%            N: ℤ -> {ℤ}\n%            S: {ℤ}\n%            \n    n = size(alpha, 2);\n    assert( isequal(size(alpha), [n, n]) );\n\n    % L_i,j = { α_ij if j ∉ N(i)\n\n    Lij_0 = zeros(2,0);\n    Lvals_0 = zeros(1,0);\n    for i = 1:n\n        for j = 1:n\n            if ~ismember([j],N(i),'rows')\n                Lij_0(1:2,end+1) = [i;j];\n                Lvals_0(end+1) = alpha(i, j);\n            end\n        end\n    end\n    sparse_0 = sparse(Lij_0(1,:),Lij_0(2,:),Lvals_0,n,n);\n    L = sparse_0;\n    % M_i,j = { α_ij if j ∉ S\n\n    Mij_0 = zeros(2,0);\n    Mvals_0 = zeros(1,0);\n    for i = 1:n\n        for j = 1:n\n            if ~ismember([j],S,'rows')\n                Mij_0(1:2,end+1) = [i;j];\n                Mvals_0(end+1) = alpha(i, j);\n            end\n        end\n    end\n    sparse_1 = sparse(Mij_0(1,:),Mij_0(2,:),Mvals_0,n,n);\n    M = sparse_1;\n    output.L = L;\n    output.M = M;\nend\n",
