 "outputs": {
  "numpy": "\"\"\"\nf(U) = sequence(U, {5}) where U_i ⊂ V\n                    g(U) = ∪_i U_i where U_i ⊂ V\n                    z = 1\n                    where\n                    V ∈ {ℤ}\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, V):\n        V = frozenset(V)\n\n        self.V = V\n        # z = 1\n        self.z = 1\n\n    def f(self, U):\n        U = np.fromiter((frozenset(x) for x in U), dtype=object, count=len(U))\n        dim_0 = U.shape[0]\n        seq = list(U)\n        seq.append({5})\n        return seq\n\n    def g(self, U):\n        U = np.fromiter((frozenset(x) for x in U), dtype=object, count=len(U))\n        dim_1 = U.shape[0]\n        union_0 = frozenset()\n        for i in range(1, len(U)+1):\n            union_0 = frozenset.union(union_0, U[i-1])\n        return union_0\n\n\n\n\n\n",
  "eigen": "/*\nf(U) = sequence(U, {5}) where U_i ⊂ V\n                    g(U) = ∪_i U_i where U_i ⊂ V\n                    z = 1\n                    where\n                    V ∈ {ℤ}\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    int z;\n    std::vector<int > V;\n    std::vector<std::vector<int >> f(\n        const std::vector<std::vector<int >> & U)\n    {\n        const long dim_0 = U.size();\n        std::vector<int > fset_0({5});\n        if(fset_0.size() > 1){\n            sort(fset_0.begin(), fset_0.end());\n            fset_0.erase(unique(fset_0.begin(), fset_0.end() ), fset_0.end());\n        }\n        std::vector<std::vector<int >> seq = U;\n        seq.reserve(seq.size()+1);\n        seq.push_back(fset_0);\n        return seq;    \n    }\n    std::vector<int > g(\n        const std::vector<std::vector<int >> & U)\n    {\n        const long dim_1 = U.size();\n        std::vector<int > union_0;\n        std::vector<int > tmp;\n        for(int i=1; i<=U.size(); i++){\n            const std::vector<int >& set = U.at(i-1);\n            std::set_union(union_0.begin(), union_0.end(), set.begin(), set.end(), std::back_inserter(tmp));\n            union_0.assign(tmp.begin(), tmp.end());\n            tmp.clear();\n        }\n        return union_0;    \n    }\n    heartlib(const std::vector<int > & V)\n    {\n    \n        this->V = V;\n        // z = 1\n        z = 1;\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\nf\\left( U \\right) & = \\textit{sequence}(U,\\{5\\}) \\text{{ where }}  U_{i} \\subset V \\\\\ng\\left( U \\right) & = \\bigcup_{i} U_{ i } \\text{{ where }}  U_{i} \\subset V \\\\\nz & = 1 \\\\\n\\intertext{where} \nV & ∈ \\{\\mathbb{Z}\\} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n & f\\left( U \\right) & = \\textit{sequence}(U,\\{5\\}) \\text{{ where }}  U_{i} \\subset V \\\\\n & g\\left( U \\right) & = \\bigcup_{i} U_{ i } \\text{{ where }}  U_{i} \\subset V \\\\\nz & = 1 \\\\\nwhere \\\\\nV & ∈ \\{\\mathbb{Z}\\} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(V)\n% output = heartlib(V)\n%\n%    f(U) = sequence(U, {5}) where U_i ⊂ V\n%                        g(U) = ∪_i U_i where U_i ⊂ V\n%                        z = 1\n%                        where\n%                        V ∈ {ℤ}\n    % z = 1\n\n    z = 1;\n    function [ret] = f(U)\n        dim_0 = size(U, 1);\n        seq = U\n        seq.add([5])\n        ret = seq;\n    end\n\n    function [ret_1] = g(U)\n        dim_1 = size(U, 1);\n        union_0 = [];\n        for i = 1:size(U,1)\n            union_0 = union(union_0, U{i});\n        end\n        ret_1 = union_0;\n    end\n\n    output.z = z;\n    output.f = @f;\n    output.g = @g;\n    output.V = V;\nend\n",
