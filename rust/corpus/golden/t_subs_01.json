 "outputs": {
  "numpy": "\"\"\"\nw ∈ ℝ^(p×k)\n        x = [ w\n              0_1,k ]\n        a = x + y\n        where\n        y ∈ ℝ^((p+1)×k)\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, w, y):\n        w = np.asarray(w, dtype=np.float64)\n        y = np.asarray(y, dtype=np.float64)\n        p = w.shape[0]\n        k = w.shape[1]\n        assert w.shape == (p, k)\n        assert y.shape == ((p+1), k)\n        assert (p+1) == int((p+1))\n        # x = [ w\n        #               0_1,k ]\n        x_0 = np.vstack((w, np.zeros((1, k))))\n        self.x = x_0\n        # a = x + y\n        self.a = self.x + y\n\n\n\n\n\n",
  "eigen": "/*\nw ∈ ℝ^(p×k)\n        x = [ w\n              0_1,k ]\n        a = x + y\n        where\n        y ∈ ℝ^((p+1)×k)\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    MatrixD x;\n    MatrixD a;\n\n    heartlib(\n        const Eigen::MatrixXd & w,\n        const Eigen::MatrixXd & y)\n    {\n        const long p = w.rows();\n        const long k = w.cols();\n        assert( w.rows() == p );\n        assert( y.rows() == (p+1) );\n        assert( y.cols() == k );\n        assert( fmod((p+1), 1) == 0.0 );\n        // x = [ w\n        //               0_1,k ]\n        MatrixD x_0(p + 1, k);\n        x_0 << w,\n        MatrixD::Zero(1, k);\n        x = x_0;\n        // a = x + y\n        a = x + y;\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\nw & ∈ \\mathbb{R}^{ p \\times k } \\\\\n\\\\\nx & = \\begin{bmatrix}\nw\\\\\n\\mathbb{ 0 }_{ 1,k }\\\\\n\\end{bmatrix} \\\\\na & = x + y \\\\\n\\intertext{where} \ny & ∈ \\mathbb{R}^{ \\left( p + 1 \\right) \\times k } \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\nw & ∈ \\mathbb{R}^{ p \\times k } \\\\\n\\\\\nx & = \\begin{bmatrix}\nw\\\\\n\\mathbb{ 0 }_{ 1,k }\\\\\n\\end{bmatrix} \\\\\na & = x + y \\\\\nwhere \\\\\ny & ∈ \\mathbb{R}^{ \\left( p + 1 \\right) \\times k } \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(w, y)\n% output = heartlib(w, y)\n%\n%    w ∈ ℝ^(p×k)\n%            x = [ w\n%                  0_1,k ]\n%            a = x + y\n%            where\n%            y ∈ ℝ^((p+1)×k)\n    p = size(w, 1);\n    k = size(w, 2);\n    assert( isequal(size(w), [p, k]) );\n    assert( isequal(size(y), [(p+1), k]) );\n    assert( mod((p+1), 1) == 0.0 );\n\n    % x = [ w\n    %               0_1,k ]\n\n    x_0 = [[w]; [zeros(1, k)]];\n    x = x_0;\n    % a = x + y\n\n    a = x + y;\n    output.x = x;\n    output.a = a;\nend\n",
