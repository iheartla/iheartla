 "outputs": {
  "numpy": "\"\"\"\nv_ij = sum_k u_k w_i,j\n        where\n        w ∈ ℝ^(2×2)\n        u ∈ ℝ^2\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, w, u):\n        w = np.asarray(w, dtype=np.float64)\n        u = np.asarray(u, dtype=np.float64)\n        assert w.shape == (2, 2)\n        assert u.shape == (2,)\n        # v_ij = sum_k u_k w_i,j\n        self.v = np.zeros((2, 2))\n        for i in range(1, 2+1):\n            for j in range(1, 2+1):\n                sum_0 = 0\n                for k in range(1, len(u)+1):\n                    sum_0 += u[k-1] * w[i-1, j-1]\n                self.v[i-1][j-1] = sum_0\n\n\n\n\n\n",
  "eigen": "/*\nv_ij = sum_k u_k w_i,j\n        where\n        w ∈ ℝ^(2×2)\n        u ∈ ℝ^2\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    Eigen::Matrix<DT, 2, 2> v;\n\n    heartlib(\n        const Eigen::Matrix<double, 2, 2> & w,\n        const Eigen::Matrix<double, 2, 1> & u)\n    {\n    \n        // v_ij = sum_k u_k w_i,j\n        v = MatrixD::Zero(2, 2);\n        for( int i=1; i<=2; i++){\n            for( int j=1; j<=2; j++){\n                DT sum_0 = 0;\n                for(int k=1; k<=u.size(); k++){\n                    sum_0 += u[k-1] * w(i-1, j-1);\n                }\n                v(i-1, j-1) = sum_0;\n            }\n        }\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\nv_{i,j} & = \\sum_{k} u_{ k } w_{i, j} \\\\\n\\intertext{where} \nw & ∈ \\mathbb{R}^{ 2 \\times 2 } \\\\\nu & ∈ \\mathbb{R}^{ 2} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\nv_{i,j} & = \\sum_{k} u_{ k } w_{i, j} \\\\\nwhere \\\\\nw & ∈ \\mathbb{R}^{ 2 \\times 2 } \\\\\nu & ∈ \\mathbb{R}^{ 2} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(w, u)\n% output = heartlib(w, u)\n%\n%    v_ij = sum_k u_k w_i,j\n%            where\n%            w ∈ ℝ^(2×2)\n%            u ∈ ℝ^2\n    u = reshape(u,[],1);\n\n    assert( isequal(size(w), [2, 2]) );\n    assert( numel(u) == 2 );\n\n    % v_ij = sum_k u_k w_i,j\n\n    v = zeros(2, 2);\n    for i = 1:2\n        for j = 1:2\n            sum_0 = 0;\n            for k = 1:size(u,1)\n                sum_0 = sum_0 + u(k) * w(i, j);\n            end\n            v(i, j) = sum_0;\n        end\n    end\n    output.v = v;\nend\n",
  "macromathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'v', 'heartlib', 'def', false, '')\", \"id\":\"heartlib-v_ij\", \"sym\":\"v\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"def\", \"case\":\"equation\"} }{ {v} }_{i,j} & = \\sum_{k} \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'u', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-u\", \"sym\":\"u\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {u} }_{ k } \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'w', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-w\", \"sym\":\"w\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {w} }_{i, j}\\\\\\eqlabel{ {\"onclick\":\"event.stopPropagation(); onClickEq(this, 'heartlib', ['u', 'w', 'v'], false, [], [], 'dl9paiA9IHN1bV9rIHVfayB3X2ksag==');\"} }{}\n \\\\\nwhere \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'w', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-w\", \"sym\":\"w\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {w} } & ∈ \\mathbb{R}^{ 2 \\times 2 } \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'u', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-u\", \"sym\":\"u\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {u} } & ∈ \\mathbb{R}^{ 2} \\\\\n\\\\\n\\end{align*}\n"
