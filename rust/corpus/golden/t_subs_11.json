 "outputs": {
  "numpy": "\"\"\"\na = ∑_i ∑_j (A_i,j,* B_i)\n        where\n        A_i ∈ ℝ^(n_i×m_i)\n        B_i ∈ ℝ^m_i\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, A, B):\n        A = np.fromiter((np.asarray(x) for x in A), dtype=object, count=len(A))\n        B = np.fromiter((np.asarray(x) for x in B), dtype=object, count=len(B))\n        dim_0 = A.shape[0]\n        # a = ∑_i ∑_j (A_i,j,* B_i)\n        sum_0 = 0\n        for i in range(1, len(A)+1):\n            sum_1 = 0\n            for j in range(1, A[i-1].shape[0]+1):\n                sum_1 += ((A[i-1][j-1, :] @ B[i-1]).item())\n            sum_0 += sum_1\n        self.a = sum_0\n\n\n\n\n\n",
  "eigen": "/*\na = ∑_i ∑_j (A_i,j,* B_i)\n        where\n        A_i ∈ ℝ^(n_i×m_i)\n        B_i ∈ ℝ^m_i\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    DT a;\n\n    heartlib(\n        const std::vector<Eigen::MatrixXd> & A,\n        const std::vector<Eigen::VectorXd> & B)\n    {\n        const long dim_0 = A.size();\n        assert( B.size() == dim_0 );\n        // a = ∑_i ∑_j (A_i,j,* B_i)\n        DT sum_0 = 0;\n        for(int i=1; i<=A.size(); i++){\n            DT sum_1 = 0;\n            for(int j=1; j<=A.at(i-1).rows(); j++){\n                sum_1 += ((A.at(i-1).row(j-1) * B.at(i-1)).value());\n            }\n            sum_0 += sum_1;\n        }\n        a = sum_0;\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\na & = \\sum_{i} \\sum_{j} \\left( A_{ i, j, *} B_{ i } \\right) \\\\\n\\intertext{where} \nA_{i} & ∈ \\mathbb{R}^{ n_{ i } \\times m_{ i } } \\\\\nB_{i} & ∈ \\mathbb{R}^{ m_{ i }} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
