 "outputs": {
  "numpy": "\"\"\"\nC = sum_i (A_i + B_i)\n        where\n        A_i: ℝ ^ (2 × 2): a matrix\n        B_i: ℝ ^ (2 × 2): a matrix\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, A, B):\n        A = np.asarray(A, dtype=np.float64)\n        B = np.asarray(B, dtype=np.float64)\n        dim_0 = A.shape[0]\n        assert A.shape == (dim_0, 2, 2)\n        assert B.shape == (dim_0, 2, 2)\n        # C = sum_i (A_i + B_i)\n        sum_0 = np.zeros((2, 2))\n        for i in range(1, len(B)+1):\n            sum_0 += (A[i-1] + B[i-1])\n        self.C = sum_0\n\n\n\n\n\n",
  "eigen": "/*\nC = sum_i (A_i + B_i)\n        where\n        A_i: ℝ ^ (2 × 2): a matrix\n        B_i: ℝ ^ (2 × 2): a matrix\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    Eigen::Matrix<DT, 2, 2> C;\n\n    heartlib(\n        const std::vector<Eigen::Matrix<double, 2, 2>> & A,\n        const std::vector<Eigen::Matrix<double, 2, 2>> & B)\n    {\n        const long dim_0 = A.size();\n        assert( B.size() == dim_0 );\n        // C = sum_i (A_i + B_i)\n        MatrixD sum_0 = MatrixD::Zero(2, 2);\n        for(int i=1; i<=B.size(); i++){\n            sum_0 += (A.at(i-1) + B.at(i-1));\n        }\n        C = sum_0;\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\nC & = \\sum_{i} \\left( A_{ i } + B_{ i } \\right) \\\\\n\\intertext{where} \nA_{i} & : \\mathbb{R}^{ 2 \\times 2 } \\text{ a matrix} \\\\\nB_{i} & : \\mathbb{R}^{ 2 \\times 2 } \\text{ a matrix} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\nC & = \\sum_{i} \\left( A_{ i } + B_{ i } \\right) \\\\\nwhere \\\\\nA_{i} & : \\mathbb{R}^{ 2 \\times 2 } \\text{ a matrix} \\\\\nB_{i} & : \\mathbb{R}^{ 2 \\times 2 } \\text{ a matrix} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(A, B)\n% output = heartlib(A, B)\n%\n%    C = sum_i (A_i + B_i)\n%            where\n%            A_i: ℝ ^ (2 × 2): a matrix\n%            B_i: ℝ ^ (2 × 2): a matrix\n    dim_0 = size(A, 1);\n    assert( isequal(size(A), [dim_0, 2, 2]) );\n    assert( isequal(size(B), [dim_0, 2, 2]) );\n\n    % C = sum_i (A_i + B_i)\n\n    sum_0 = zeros(2, 2);\n    for i = 1:size(B, 1)\n        sum_0 = sum_0 + (squeeze(A(i,:,:)) + squeeze(B(i,:,:)));\n    end\n    C = sum_0;\n    output.C = C;\nend\n",
  "macromathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'C', 'heartlib', 'def', false, '')\", \"id\":\"heartlib-C\", \"sym\":\"C\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"def\", \"case\":\"equation\"} }{ {C} } & = \\sum_{i} \\left( \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'A', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-A\", \"sym\":\"A\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {A} }_{ i } + \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'B', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-B\", \"sym\":\"B\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {B} }_{ i } \\right)\\\\\\eqlabel{ {\"onclick\":\"event.stopPropagation(); onClickEq(this, 'heartlib', ['B', 'A', 'C'], false, [], [], 'QyA9IHN1bV9pIChBX2kgKyBCX2kp');\"} }{}\n \\\\\nwhere \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'A', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-A_i\", \"sym\":\"A\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {A} }_{i} & : \\mathbb{R}^{ 2 \\times 2 } \\text{ a matrix} \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'B', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-B_i\", \"sym\":\"B\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {B} }_{i} & : \\mathbb{R}^{ 2 \\times 2 } \\text{ a matrix} \\\\\n\\\\\n\\end{align*}\n"
