 "outputs": {
  "numpy": "\"\"\"\nq_i = p_i\n        where\n        p ∈ ℝ^3\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, p):\n        p = np.asarray(p, dtype=np.float64)\n        assert p.shape == (3,)\n        # q_i = p_i\n        self.q = np.zeros(3)\n        for i in range(1, 3+1):\n            self.q[i-1] = p[i-1]\n\n\n\n\n\n",
  "eigen": "/*\nq_i = p_i\n        where\n        p ∈ ℝ^3\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    Eigen::Matrix<DT, 3, 1> q;\n\n    heartlib(const Eigen::Matrix<double, 3, 1> & p)\n    {\n    \n        // q_i = p_i\n        q.resize(3);\n        for( int i=1; i<=3; i++){\n            q[i-1] = p[i-1];\n        }\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\nq_{ i } & = p_{ i } \\\\\n\\intertext{where} \np & ∈ \\mathbb{R}^{ 3} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\nq_{ i } & = p_{ i } \\\\\nwhere \\\\\np & ∈ \\mathbb{R}^{ 3} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(p)\n% output = heartlib(p)\n%\n%    q_i = p_i\n%            where\n%            p ∈ ℝ^3\n    p = reshape(p,[],1);\n\n    assert( numel(p) == 3 );\n\n    % q_i = p_i\n\n    q = zeros(3,1);\n    for i = 1:3\n        q(i) = p(i);\n    end\n    output.q = q;\nend\n",
  "macromathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'q', 'heartlib', 'def', false, '')\", \"id\":\"heartlib-q\", \"sym\":\"q\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"def\", \"case\":\"equation\"} }{ {q} }_{ i } & = \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'p', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-p\", \"sym\":\"p\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {p} }_{ i }\\\\\\eqlabel{ {\"onclick\":\"event.stopPropagation(); onClickEq(this, 'heartlib', ['p', 'q'], false, [], [], 'cV9pID0gcF9p');\"} }{}\n \\\\\nwhere \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'p', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-p\", \"sym\":\"p\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {p} } & ∈ \\mathbb{R}^{ 3} \\\\\n\\\\\n\\end{align*}\n"
