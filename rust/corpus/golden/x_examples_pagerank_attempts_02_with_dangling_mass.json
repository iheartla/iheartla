 "outputs": {
  "numpy": "\"\"\"\ny = α (Mᵀx + (dᵀx) p) + (1-α) p\n\nwhere\n\nM ∈ ℝ^(n×n)\nx ∈ ℝ^n\nd ∈ ℝ^n\np ∈ ℝ^n\nα ∈ ℝ\n\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, M, x, d, p, α):\n        M = np.asarray(M, dtype=np.float64)\n        x = np.asarray(x, dtype=np.float64)\n        d = np.asarray(d, dtype=np.float64)\n        p = np.asarray(p, dtype=np.float64)\n        n = M.shape[1]\n        assert M.shape == (n, n)\n        assert x.shape == (n,)\n        assert d.shape == (n,)\n        assert p.shape == (n,)\n        assert np.ndim(α) == 0\n        # y = α (Mᵀx + (dᵀx) p) + (1-α) p\n        self.y = α * (M.T @ x + ((d.T.reshape(1, n) @ x).item()) * p) + (1 - α) * p\n\n\n\n\n\n",
  "eigen": "/*\ny = α (Mᵀx + (dᵀx) p) + (1-α) p\n\nwhere\n\nM ∈ ℝ^(n×n)\nx ∈ ℝ^n\nd ∈ ℝ^n\np ∈ ℝ^n\nα ∈ ℝ\n\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    VectorD y;\n\n    heartlib(\n        const Eigen::MatrixXd & M,\n        const Eigen::VectorXd & x,\n        const Eigen::VectorXd & d,\n        const Eigen::VectorXd & p,\n        const double & α)\n    {\n        const long n = M.cols();\n        assert( M.rows() == n );\n        assert( x.size() == n );\n        assert( d.size() == n );\n        assert( p.size() == n );\n        // y = α (Mᵀx + (dᵀx) p) + (1-α) p\n        y = α * (M.transpose() * x + ((d.transpose() * x).value()) * p) + (1 - α) * p;\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\ny & = α \\left( {M}^T x + \\left( {d}^T x \\right) p \\right) + \\left( 1 - α \\right) p \\\\\n\\intertext{where} \nM & ∈ \\mathbb{R}^{ n \\times n } \\\\\nx & ∈ \\mathbb{R}^{ n} \\\\\nd & ∈ \\mathbb{R}^{ n} \\\\\np & ∈ \\mathbb{R}^{ n} \\\\\nα & ∈ \\mathbb{R} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\ny & = α \\left( {M}^T x + \\left( {d}^T x \\right) p \\right) + \\left( 1 - α \\right) p \\\\\nwhere \\\\\nM & ∈ \\mathbb{R}^{ n \\times n } \\\\\nx & ∈ \\mathbb{R}^{ n} \\\\\nd & ∈ \\mathbb{R}^{ n} \\\\\np & ∈ \\mathbb{R}^{ n} \\\\\nα & ∈ \\mathbb{R} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(M, x, d, p, alpha)\n% output = heartlib(M, x, d, p, α)\n%\n%    y = α (Mᵀx + (dᵀx) p) + (1-α) p\n%    \n%    where\n%    \n%    M ∈ ℝ^(n×n)\n%    x ∈ ℝ^n\n%    d ∈ ℝ^n\n%    p ∈ ℝ^n\n%    α ∈ ℝ\n%    \n    x = reshape(x,[],1);\n    d = reshape(d,[],1);\n    p = reshape(p,[],1);\n\n    n = size(M, 2);\n    assert( isequal(size(M), [n, n]) );\n    assert( numel(x) == n );\n    assert( numel(d) == n );\n    assert( numel(p) == n );\n    assert(numel(alpha) == 1);\n\n    % y = α (Mᵀx + (dᵀx) p) + (1-α) p\n\n    y = alpha * (M' * x + (d' * x) * p) + (1 - alpha) * p;\n    output.y = y;\nend\n",
