 "outputs": {
  "numpy": "\"\"\"\ny = α Mᵀx + (1-α) p\n\nwhere\n\nM ∈ ℝ^(n×n)\nx ∈ ℝ^n\nd ∈ ℝ^n\np ∈ ℝ^n\nα ∈ ℝ\n\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, M, x, d, p, α):\n        M = np.asarray(M, dtype=np.float64)\n        x = np.asarray(x, dtype=np.float64)\n        d = np.asarray(d, dtype=np.float64)\n        p = np.asarray(p, dtype=np.float64)\n        n = M.shape[1]\n        assert M.shape == (n, n)\n        assert x.shape == (n,)\n        assert d.shape == (n,)\n        assert p.shape == (n,)\n        assert np.ndim(α) == 0\n        # y = α Mᵀx + (1-α) p\n        self.y = α * M.T @ x + (1 - α) * p\n\n\n\n\n\n",
  "eigen": "/*\ny = α Mᵀx + (1-α) p\n\nwhere\n\nM ∈ ℝ^(n×n)\nx ∈ ℝ^n\nd ∈ ℝ^n\np ∈ ℝ^n\nα ∈ ℝ\n\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    VectorD y;\n\n    heartlib(\n        const Eigen::MatrixXd & M,\n        const Eigen::VectorXd & x,\n        const Eigen::VectorXd & d,\n        const Eigen::VectorXd & p,\n        const double & α)\n    {\n        const long n = M.cols();\n        assert( M.rows() == n );\n        assert( x.size() == n );\n        assert( d.size() == n );\n        assert( p.size() == n );\n        // y = α Mᵀx + (1-α) p\n        y = α * M.transpose() * x + (1 - α) * p;\n    }\n};\n\n\n\n\n\n",
