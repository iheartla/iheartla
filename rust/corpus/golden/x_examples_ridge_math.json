 "outputs": {
  "numpy": "\"\"\"\nw = (XᵀX + λI_n)⁻¹ Xᵀy\n\nwhere\n\nX ∈ ℝ^(m×n)\ny ∈ ℝ^m\nλ ∈ ℝ\n\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, X, y, λ):\n        X = np.asarray(X, dtype=np.float64)\n        y = np.asarray(y, dtype=np.float64)\n        m = X.shape[0]\n        n = X.shape[1]\n        assert X.shape == (m, n)\n        assert y.shape == (m,)\n        assert np.ndim(λ) == 0\n        # w = (XᵀX + λI_n)⁻¹ Xᵀy\n        self.w = np.linalg.solve((X.T @ X + λ * np.identity(n)), X.T) @ y\n\n\n\n\n\n",
  "eigen": "/*\nw = (XᵀX + λI_n)⁻¹ Xᵀy\n\nwhere\n\nX ∈ ℝ^(m×n)\ny ∈ ℝ^m\nλ ∈ ℝ\n\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    VectorD w;\n\n    heartlib(\n        const Eigen::MatrixXd & X,\n        const Eigen::VectorXd & y,\n        const double & λ)\n    {\n        const long m = X.rows();\n        const long n = X.cols();\n        assert( X.rows() == m );\n        assert( y.size() == m );\n        // w = (XᵀX + λI_n)⁻¹ Xᵀy\n        w = (to_double((X.transpose() * X + λ * MatrixD::Identity(n, n)))).colPivHouseholderQr().solve(to_double(X.transpose())) * y;\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\nw & = \\left( {X}^T X + λ I_{ n } \\right)^{-1}{X}^T y \\\\\n\\intertext{where} \nX & ∈ \\mathbb{R}^{ m \\times n } \\\\\ny & ∈ \\mathbb{R}^{ m} \\\\\nλ & ∈ \\mathbb{R} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\nw & = \\left( {X}^T X + λ I_{ n } \\right)^{-1}{X}^T y \\\\\nwhere \\\\\nX & ∈ \\mathbb{R}^{ m \\times n } \\\\\ny & ∈ \\mathbb{R}^{ m} \\\\\nλ & ∈ \\mathbb{R} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(X, y, lambda_)\n% output = heartlib(X, y, λ)\n%\n%    w = (XᵀX + λI_n)⁻¹ Xᵀy\n%    \n%    where\n%    \n%    X ∈ ℝ^(m×n)\n%    y ∈ ℝ^m\n%    λ ∈ ℝ\n%    \n    y = reshape(y,[],1);\n\n    m = size(X, 1);\n    n = size(X, 2);\n    assert( isequal(size(X), [m, n]) );\n    assert( numel(y) == m );\n    assert(numel(lambda_) == 1);\n\n    % w = (XᵀX + λI_n)⁻¹ Xᵀy\n\n    w = (((X' * X + lambda_ * speye(n)))\\(X')) * y;\n    output.w = w;\nend\n",
