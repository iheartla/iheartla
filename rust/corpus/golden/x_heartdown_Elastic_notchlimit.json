 "outputs": {
  "numpy": "\"\"\"\n`E_n` = `$δ^{(−)}$`(1/10 log((`$β_q$`-`$β^{(−)}$`)))^2 + `$δ^{(+)}$`(1/10 log((`$β^{(+)}$`-`$β_q$`)))^2\nwhere\n`$δ^{(−)}$` ∈ ℝ \n`$δ^{(+)}$` ∈ ℝ\n`$β_q$` ∈ ℝ :  barycentric coordinates \n`$β^{(−)}$` ∈ ℝ : the barycentric coordinates of the notch bounds on their corresponding edges\n`$β^{(+)}$` ∈ ℝ : the barycentric coordinates of the notch bounds on their corresponding edges\n\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, δ_circumflex_accent_minus_sign, δ_circumflex_accent_plus_sign, β_q, β_circumflex_accent_minus_sign, β_circumflex_accent_plus_sign):\n        assert np.ndim(δ_circumflex_accent_minus_sign) == 0\n        assert np.ndim(δ_circumflex_accent_plus_sign) == 0\n        assert np.ndim(β_q) == 0\n        assert np.ndim(β_circumflex_accent_minus_sign) == 0\n        assert np.ndim(β_circumflex_accent_plus_sign) == 0\n        # `E_n` = `$δ^{(−)}$`(1/10 log((`$β_q$`-`$β^{(−)}$`)))^2 + `$δ^{(+)}$`(1/10 log((`$β^{(+)}$`-`$β_q$`)))^2\n        self.E_n = δ_circumflex_accent_minus_sign * np.power(np.asarray(((1) / (10) * np.log((β_q - β_circumflex_accent_minus_sign))), dtype=np.float64), 2) + δ_circumflex_accent_plus_sign * np.power(np.asarray(((1) / (10) * np.log((β_circumflex_accent_plus_sign - β_q))), dtype=np.float64), 2)\n\n\n\n\n\n",
  "eigen": "/*\n`E_n` = `$δ^{(−)}$`(1/10 log((`$β_q$`-`$β^{(−)}$`)))^2 + `$δ^{(+)}$`(1/10 log((`$β^{(+)}$`-`$β_q$`)))^2\nwhere\n`$δ^{(−)}$` ∈ ℝ \n`$δ^{(+)}$` ∈ ℝ\n`$β_q$` ∈ ℝ :  barycentric coordinates \n`$β^{(−)}$` ∈ ℝ : the barycentric coordinates of the notch bounds on their corresponding edges\n`$β^{(+)}$` ∈ ℝ : the barycentric coordinates of the notch bounds on their corresponding edges\n\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    DT E_n;\n\n    heartlib(\n        const double & δ_circumflex_accent_minus_sign,\n        const double & δ_circumflex_accent_plus_sign,\n        const double & β_q,\n        const double & β_circumflex_accent_minus_sign,\n        const double & β_circumflex_accent_plus_sign)\n    {\n    \n        // `E_n` = `$δ^{(−)}$`(1/10 log((`$β_q$`-`$β^{(−)}$`)))^2 + `$δ^{(+)}$`(1/10 log((`$β^{(+)}$`-`$β_q$`)))^2\n        E_n = δ_circumflex_accent_minus_sign * pow((1 / DT(10) * log((β_q - β_circumflex_accent_minus_sign))), 2) + δ_circumflex_accent_plus_sign * pow((1 / DT(10) * log((β_circumflex_accent_plus_sign - β_q))), 2);\n    }\n};\n\n\n\n\n\n",
