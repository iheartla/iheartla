 "outputs": {
  "numpy": "\"\"\"\n`E_p` = (μ log((ε + `$β_q$`)))^2 + (μ log((ε + 1 - `$β_q$`)))^2\nwhere\nμ ∈ ℝ : a weighting parameter\nε ∈ ℝ : denoting how far $q$ is allowed to move past the end of the edge\n`$β_q$` ∈ ℝ :  barycentric coordinates \n\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, μ, ε, β_q):\n        assert np.ndim(μ) == 0\n        assert np.ndim(ε) == 0\n        assert np.ndim(β_q) == 0\n        # `E_p` = (μ log((ε + `$β_q$`)))^2 + (μ log((ε + 1 - `$β_q$`)))^2\n        self.E_p = np.power(np.asarray((μ * np.log((ε + β_q))), dtype=np.float64), 2) + np.power(np.asarray((μ * np.log((ε + 1 - β_q))), dtype=np.float64), 2)\n\n\n\n\n\n",
  "eigen": "/*\n`E_p` = (μ log((ε + `$β_q$`)))^2 + (μ log((ε + 1 - `$β_q$`)))^2\nwhere\nμ ∈ ℝ : a weighting parameter\nε ∈ ℝ : denoting how far $q$ is allowed to move past the end of the edge\n`$β_q$` ∈ ℝ :  barycentric coordinates \n\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    DT E_p;\n\n    heartlib(\n        const double & μ,\n        const double & ε,\n        const double & β_q)\n    {\n    \n        // `E_p` = (μ log((ε + `$β_q$`)))^2 + (μ log((ε + 1 - `$β_q$`)))^2\n        E_p = pow((μ * log((ε + β_q))), 2) + pow((μ * log((ε + 1 - β_q))), 2);\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\nE_p & = {\\left( μ  \\log{ \\left( ε + β_q \\right) } \\right)}^{2} + {\\left( μ  \\log{ \\left( ε + 1 - β_q \\right) } \\right)}^{2} \\\\\n\\intertext{where} \nμ & ∈ \\mathbb{R} \\text{ a weighting parameter} \\\\\nε & ∈ \\mathbb{R} \\text{ denoting how far \\$q\\$ is allowed to move past the end of the edge} \\\\\nβ_q & ∈ \\mathbb{R} \\text{ barycentric coordinates } \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\nE_p & = {\\left( μ  \\log{ \\left( ε + β_q \\right) } \\right)}^{2} + {\\left( μ  \\log{ \\left( ε + 1 - β_q \\right) } \\right)}^{2} \\\\\nwhere \\\\\nμ & ∈ \\mathbb{R} \\text{ a weighting parameter} \\\\\nε & ∈ \\mathbb{R} \\text{ denoting how far \\$q\\$ is allowed to move past the end of the edge} \\\\\nβ_q & ∈ \\mathbb{R} \\text{ barycentric coordinates } \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(mu, epsilon, beta_q)\n% output = heartlib(μ, ε, `$β_q$`)\n%\n%    `E_p` = (μ log((ε + `$β_q$`)))^2 + (μ log((ε + 1 - `$β_q$`)))^2\n%    where\n%    μ ∈ ℝ : a weighting parameter\n%    ε ∈ ℝ : denoting how far $q$ is allowed to move past the end of the edge\n%    `$β_q$` ∈ ℝ :  barycentric coordinates \n%    \n    assert(numel(mu) == 1);\n    assert(numel(epsilon) == 1);\n    assert(numel(beta_q) == 1);\n\n    % `E_p` = (μ log((ε + `$β_q$`)))^2 + (μ log((ε + 1 - `$β_q$`)))^2\n\n    E_p = (mu * log((epsilon + beta_q))).^2 + (mu * log((epsilon + 1 - beta_q))).^2;\n    output.E_p = E_p;\nend\n",
