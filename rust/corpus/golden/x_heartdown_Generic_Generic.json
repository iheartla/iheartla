 "outputs": {
  "numpy": "\"\"\"\n `$x_p$` = (-y, x)\n `$v_p$` = (-v, u)\nM=[-J`$x_p$`+`$v_p$`  J  `$x_p$`  I_2] \n\nwhere\nJ: ℝ^(2×2): The Jacobian matrix\nx: ℝ : point coordinate\ny: ℝ : point coordinate\nu: ℝ : vector field coordinate\nv: ℝ : vector field coordinate\n\n\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, J, x, y, u, v):\n        J = np.asarray(J, dtype=np.float64)\n        assert J.shape == (2, 2)\n        assert np.ndim(x) == 0\n        assert np.ndim(y) == 0\n        assert np.ndim(u) == 0\n        assert np.ndim(v) == 0\n        # `$x_p$` = (-y, x)\n        self.x_p = np.hstack((-y, x))\n        # `$v_p$` = (-v, u)\n        self.v_p = np.hstack((-v, u))\n        # M=[-J`$x_p$`+`$v_p$`  J  `$x_p$`  I_2]\n        M_0 = np.hstack(((-J @ self.x_p + self.v_p).reshape(2, 1), J, (self.x_p).reshape(2, 1), np.identity(2)))\n        self.M = M_0\n\n\n\n\n\n",
  "eigen": "/*\n `$x_p$` = (-y, x)\n `$v_p$` = (-v, u)\nM=[-J`$x_p$`+`$v_p$`  J  `$x_p$`  I_2] \n\nwhere\nJ: ℝ^(2×2): The Jacobian matrix\nx: ℝ : point coordinate\ny: ℝ : point coordinate\nu: ℝ : vector field coordinate\nv: ℝ : vector field coordinate\n\n\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    Eigen::Matrix<DT, 2, 1> x_p;\n    Eigen::Matrix<DT, 2, 1> v_p;\n    Eigen::Matrix<DT, 2, 6> M;\n\n    heartlib(\n        const Eigen::Matrix<double, 2, 2> & J,\n        const double & x,\n        const double & y,\n        const double & u,\n        const double & v)\n    {\n    \n        // `$x_p$` = (-y, x)\n        Eigen::Matrix<DT, 2, 1> x_p_0;\n        x_p_0 << -y, x;\n        x_p = x_p_0;\n        // `$v_p$` = (-v, u)\n        Eigen::Matrix<DT, 2, 1> v_p_0;\n        v_p_0 << -v, u;\n        v_p = v_p_0;\n        // M=[-J`$x_p$`+`$v_p$`  J  `$x_p$`  I_2]\n        Eigen::Matrix<DT, 2, 6> M_0;\n        M_0 << -J * x_p + v_p, J, x_p, MatrixD::Identity(2, 2);\n        M = M_0;\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\nx_p & = \\begin{pmatrix}\n-y\\\\x\\end{pmatrix} \\\\\nv_p & = \\begin{pmatrix}\n-v\\\\u\\end{pmatrix} \\\\\nM & = \\begin{bmatrix}\n-J x_p + v_p & J & x_p & I_{ 2 }\\\\\n\\end{bmatrix} \\\\\n\\intertext{where} \nJ & : \\mathbb{R}^{ 2 \\times 2 } \\text{ The Jacobian matrix} \\\\\nx & : \\mathbb{R} \\text{ point coordinate} \\\\\ny & : \\mathbb{R} \\text{ point coordinate} \\\\\nu & : \\mathbb{R} \\text{ vector field coordinate} \\\\\nv & : \\mathbb{R} \\text{ vector field coordinate} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\nx_p & = \\begin{pmatrix}\n-y\\\\x\\end{pmatrix} \\\\\nv_p & = \\begin{pmatrix}\n-v\\\\u\\end{pmatrix} \\\\\nM & = \\begin{bmatrix}\n-J x_p + v_p & J & x_p & I_{ 2 }\\\\\n\\end{bmatrix} \\\\\nwhere \\\\\nJ & : \\mathbb{R}^{ 2 \\times 2 } \\text{ The Jacobian matrix} \\\\\nx & : \\mathbb{R} \\text{ point coordinate} \\\\\ny & : \\mathbb{R} \\text{ point coordinate} \\\\\nu & : \\mathbb{R} \\text{ vector field coordinate} \\\\\nv & : \\mathbb{R} \\text{ vector field coordinate} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(J, x, y, u, v)\n% output = heartlib(J, x, y, u, v)\n%\n%     `$x_p$` = (-y, x)\n%     `$v_p$` = (-v, u)\n%    M=[-J`$x_p$`+`$v_p$`  J  `$x_p$`  I_2] \n%    \n%    where\n%    J: ℝ^(2×2): The Jacobian matrix\n%    x: ℝ : point coordinate\n%    y: ℝ : point coordinate\n%    u: ℝ : vector field coordinate\n%    v: ℝ : vector field coordinate\n%    \n%    \n    assert( isequal(size(J), [2, 2]) );\n    assert(numel(x) == 1);\n    assert(numel(y) == 1);\n    assert(numel(u) == 1);\n    assert(numel(v) == 1);\n\n    % `$x_p$` = (-y, x)\n\n    x_p = [-y; x];\n    % `$v_p$` = (-v, u)\n\n    v_p = [-v; u];\n    % M=[-J`$x_p$`+`$v_p$`  J  `$x_p$`  I_2]\n\n    M_0 = [[reshape(-J * x_p + v_p, [2, 1]), J, reshape(x_p, [2, 1]), speye(2)]];\n    M = M_0;\n    output.x_p = x_p;\n    output.v_p = v_p;\n    output.M = M;\nend\n",
