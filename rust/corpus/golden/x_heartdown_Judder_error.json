 "outputs": {
  "numpy": "\"\"\"\nE = sum_i |log(O_i) - log(M_i)|/log(O_i) \n\nO ∈ ℝ^N\nM ∈ ℝ^N\n\n\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, O, M):\n        O = np.asarray(O, dtype=np.float64)\n        M = np.asarray(M, dtype=np.float64)\n        N = O.shape[0]\n        assert O.shape == (N,)\n        assert M.shape == (N,)\n        # E = sum_i |log(O_i) - log(M_i)|/log(O_i)\n        sum_0 = 0\n        for i in range(1, len(M)+1):\n            sum_0 += (np.absolute(np.log(O[i-1]) - np.log(M[i-1]))) / (np.log(O[i-1]))\n        self.E = sum_0\n\n\n\n\n\n",
  "eigen": "/*\nE = sum_i |log(O_i) - log(M_i)|/log(O_i) \n\nO ∈ ℝ^N\nM ∈ ℝ^N\n\n\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    DT E;\n\n    heartlib(\n        const Eigen::VectorXd & O,\n        const Eigen::VectorXd & M)\n    {\n        const long N = O.size();\n        assert( M.size() == N );\n        // E = sum_i |log(O_i) - log(M_i)|/log(O_i)\n        DT sum_0 = 0;\n        for(int i=1; i<=M.size(); i++){\n            sum_0 += abs(log(O[i-1]) - log(M[i-1])) / DT(log(O[i-1]));\n        }\n        E = sum_0;\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\nE & = \\sum_{i} \\frac{\\left| \\log{ O_{ i } } -  \\log{ M_{ i } }\\right|}{ \\log{ O_{ i } }} \\\\\n\\\\\nO & ∈ \\mathbb{R}^{ N} \\\\\nM & ∈ \\mathbb{R}^{ N} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\nE & = \\sum_{i} \\frac{\\left| \\log{ O_{ i } } -  \\log{ M_{ i } }\\right|}{ \\log{ O_{ i } }} \\\\\n\\\\\nO & ∈ \\mathbb{R}^{ N} \\\\\nM & ∈ \\mathbb{R}^{ N} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(O, M)\n% output = heartlib(O, M)\n%\n%    E = sum_i |log(O_i) - log(M_i)|/log(O_i) \n%    \n%    O ∈ ℝ^N\n%    M ∈ ℝ^N\n%    \n%    \n    O = reshape(O,[],1);\n    M = reshape(M,[],1);\n\n    N = size(O, 1);\n    assert( numel(O) == N );\n    assert( numel(M) == N );\n\n    % E = sum_i |log(O_i) - log(M_i)|/log(O_i)\n\n    sum_0 = 0;\n    for i = 1:size(M,1)\n        sum_0 = sum_0 + abs(log(O(i)) - log(M(i))) / log(O(i));\n    end\n    E = sum_0;\n    output.E = E;\nend\n",
  "macromathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'E', 'heartlib', 'def', false, '')\", \"id\":\"heartlib-E\", \"sym\":\"E\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"def\", \"case\":\"equation\"} }{ {E} } & = \\sum_{i} \\frac{\\left| \\log{ \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'O', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-O\", \"sym\":\"O\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {O} }_{ i } } -  \\log{ \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'M', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-M\", \"sym\":\"M\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {M} }_{ i } }\\right|}{ \\log{ \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'O', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-O\", \"sym\":\"O\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {O} }_{ i } }}\\\\\\eqlabel{ {\"onclick\":\"event.stopPropagation(); onClickEq(this, 'heartlib', ['M', 'O', 'E'], false, [], [], 'RSA9IHN1bV9pIHxsb2coT19pKSAtIGxvZyhNX2kpfC9sb2coT19pKQ==');\"} }{}\n \\\\\n\\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'O', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-O\", \"sym\":\"O\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {O} } & ∈ \\mathbb{R}^{ \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'N', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-N\", \"sym\":\"N\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {N} }} \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'M', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-M\", \"sym\":\"M\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {M} } & ∈ \\mathbb{R}^{ \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'N', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-N\", \"sym\":\"N\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {N} }} \\\\\n\\\\\n\\end{align*}\n"
