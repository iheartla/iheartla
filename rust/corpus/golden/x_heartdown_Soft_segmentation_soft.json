 "outputs": {
  "numpy": "\"\"\"\n`$F_S$` = sum_i α_i D_i(`$\\boldsymbol{u}$`_i) + σ((sum_i α_i)/(sum_i α_i^2) - 1)\n\nwhere\n\nD_i: ℝ^3 -> ℝ\n`$\\boldsymbol{u}$`_i: ℝ^3\nσ: ℝ\nα_i: ℝ \n\n\"\"\"\nimport numpy as np\nimport scipy\nimport scipy.linalg\nfrom scipy import sparse\nfrom scipy.integrate import quad, solve_ivp\nfrom scipy.optimize import minimize\n\n\nclass heartlib:\n    def __init__(self, D, boldsymbolu, σ, α):\n        boldsymbolu = np.asarray(boldsymbolu, dtype=np.float64)\n        α = np.asarray(α, dtype=np.float64)\n        dim_0 = α.shape[0]\n        assert boldsymbolu.shape == (dim_0, 3, )\n        assert np.ndim(σ) == 0\n        assert α.shape == (dim_0,)\n        # `$F_S$` = sum_i α_i D_i(`$\\boldsymbol{u}$`_i) + σ((sum_i α_i)/(sum_i α_i^2) - 1)\n        sum_0 = 0\n        for i in range(1, len(boldsymbolu)+1):\n            sum_0 += α[i-1] * D(i, boldsymbolu[i-1])\n        sum_1 = 0\n        for i in range(1, len(α)+1):\n            sum_1 += α[i-1]\n        sum_2 = 0\n        for i in range(1, len(α)+1):\n            sum_2 += np.power(np.asarray(α[i-1], dtype=np.float64), 2)\n        self.F_S = sum_0 + σ * (((sum_1)) / ((sum_2)) - 1)\n\n\n\n\n\n",
  "eigen": "/*\n`$F_S$` = sum_i α_i D_i(`$\\boldsymbol{u}$`_i) + σ((sum_i α_i)/(sum_i α_i^2) - 1)\n\nwhere\n\nD_i: ℝ^3 -> ℝ\n`$\\boldsymbol{u}$`_i: ℝ^3\nσ: ℝ\nα_i: ℝ \n\n*/\n#include <Eigen/Core>\n#include <Eigen/QR>\n#include <Eigen/Dense>\n#include <Eigen/Sparse>\n#include <iostream>\n#include <set>\n#include <algorithm>\n#include \"type_helper.h\"\n\nusing namespace iheartmesh;\nstruct heartlib {\n    using DT = double;\n    using MatrixD = Eigen::MatrixXd;\n    using VectorD = Eigen::VectorXd;\n    DT F_S;\n\n    heartlib(\n        const std::function<double(int, Eigen::Matrix<double, 3, 1>)> & D,\n        const std::vector<Eigen::Matrix<double, 3, 1>> & boldsymbolu,\n        const double & σ,\n        const std::vector<double> & α)\n    {\n        const long dim_0 = α.size();\n        assert( boldsymbolu.size() == dim_0 );\n        // `$F_S$` = sum_i α_i D_i(`$\\boldsymbol{u}$`_i) + σ((sum_i α_i)/(sum_i α_i^2) - 1)\n        DT sum_0 = 0;\n        for(int i=1; i<=boldsymbolu.size(); i++){\n            sum_0 += α.at(i-1) * D(i, (boldsymbolu.at(i-1)).eval());\n        }\n        DT sum_1 = 0;\n        for(int i=1; i<=α.size(); i++){\n            sum_1 += α.at(i-1);\n        }\n        DT sum_2 = 0;\n        for(int i=1; i<=α.size(); i++){\n            sum_2 += pow(α.at(i-1), 2);\n        }\n        F_S = sum_0 + σ * ((sum_1) / DT((sum_2)) - 1);\n    }\n};\n\n\n\n\n\n",
  "latex": "\\documentclass[12pt]{article}\n\\usepackage{mathdots}\n\\usepackage[bb=boondox]{mathalfa}\n\\usepackage{mathtools}\n\\usepackage{amssymb}\n\\usepackage{unicode-math}\n\\usepackage{libertine}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\usepackage[paperheight=8in,paperwidth=4in,margin=.3in,heightrounded]{geometry}\n\\let\\originalleft\\left\n\\let\\originalright\\right\n\\renewcommand{\\left}{\\mathopen{}\\mathclose\\bgroup\\originalleft}\n\\renewcommand{\\right}{\\aftergroup\\egroup\\originalright}\n\\begin{document}\n\n\\begin{center}\n\\resizebox{\\textwidth}{!} \n{\n\\begin{minipage}[c]{\\textwidth}\n\\begin{align*}\nF_S & = \\sum_{i} α_{ i } D_{i}\\left( \\boldsymbol{u}_{ i } \\right) + σ \\left( \\frac{\\sum_{i} α_{ i }}{\\sum_{i} {α_{ i }}^{2}} - 1 \\right) \\\\\n\\intertext{where} \nD_{i} & : \\mathbb{R}^{ 3}\\rightarrow \\mathbb{R} \\\\\n\\boldsymbol{u}_{i} & : \\mathbb{R}^{ 3} \\\\\nσ & : \\mathbb{R} \\\\\nα_{i} & : \\mathbb{R} \\\\\n\\\\\n\\end{align*}\n\\end{minipage}\n}\n\\end{center}\n\n\\end{document}\n",
  "mathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\nF_S & = \\sum_{i} α_{ i } D_{i}\\left( \\boldsymbol{u}_{ i } \\right) + σ \\left( \\frac{\\sum_{i} α_{ i }}{\\sum_{i} {α_{ i }}^{2}} - 1 \\right) \\\\\nwhere \\\\\nD_{i} & : \\mathbb{R}^{ 3}\\rightarrow \\mathbb{R} \\\\\n\\boldsymbol{u}_{i} & : \\mathbb{R}^{ 3} \\\\\nσ & : \\mathbb{R} \\\\\nα_{i} & : \\mathbb{R} \\\\\n\\\\\n\\end{align*}\n",
  "matlab": "function output = heartlib(D, boldsymbolu, sigma, alpha)\n% output = heartlib(D, `$\\boldsymbol{u}$`, σ, α)\n%\n%    `$F_S$` = sum_i α_i D_i(`$\\boldsymbol{u}$`_i) + σ((sum_i α_i)/(sum_i α_i^2) - 1)\n%    \n%    where\n%    \n%    D_i: ℝ^3 -> ℝ\n%    `$\\boldsymbol{u}$`_i: ℝ^3\n%    σ: ℝ\n%    α_i: ℝ \n%    \n    alpha = reshape(alpha,[],1);\n\n    dim_0 = size(alpha, 1);\n    assert( isequal(size(boldsymbolu), [dim_0, 3]) );\n    assert(numel(sigma) == 1);\n    assert( size(alpha,1) == dim_0 );\n\n    % `$F_S$` = sum_i α_i D_i(`$\\boldsymbol{u}$`_i) + σ((sum_i α_i)/(sum_i α_i^2) - 1)\n\n    sum_0 = 0;\n    for i = 1:size(boldsymbolu, 1)\n        sum_0 = sum_0 + alpha(i) * D(i, boldsymbolu(i,:)');\n    end\n    sum_1 = 0;\n    for i = 1:size(alpha, 1)\n        sum_1 = sum_1 + alpha(i);\n    end\n    sum_2 = 0;\n    for i = 1:size(alpha, 1)\n        sum_2 = sum_2 + alpha(i).^2;\n    end\n    F_S = sum_0 + sigma * ((sum_1) / (sum_2) - 1);\n    output.F_S = F_S;\nend\n",
  "macromathjax": "\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\begin{align*}\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, '$F_S$', 'heartlib', 'def', false, '')\", \"id\":\"heartlib-$F_S$\", \"sym\":\"$F_S$\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"def\", \"case\":\"equation\"} }{ {F_S} } & = \\sum_{i} \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'α', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-α\", \"sym\":\"α\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {α} }_{ i } \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'D', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-D\", \"sym\":\"D\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {D} }_{\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'i', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-i\", \"sym\":\"i\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {i} }}\\left( \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, '$\\\\\\\\boldsymbol{u}$', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-$\\\\\\\\boldsymbol{u}$\", \"sym\":\"$\\\\\\\\boldsymbol{u}$\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {\\boldsymbol{u}} }_{ i } \\right) + \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'σ', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-σ\", \"sym\":\"σ\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {σ} } \\left( \\frac{\\sum_{i} \\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'α', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-α\", \"sym\":\"α\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {α} }_{ i }}{\\sum_{i} {\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'α', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-α\", \"sym\":\"α\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {α} }_{ i }}^{2}} - 1 \\right)\\\\\\eqlabel{ {\"onclick\":\"event.stopPropagation(); onClickEq(this, 'heartlib', ['$\\\\\\\\boldsymbol{u}$', 'D', 'i', 'α', 'σ', '$F_S$'], false, [], [], 'YCRGX1MkYCA9IHN1bV9pIM6xX2kgRF9pKGAkXGJvbGRzeW1ib2x7dX0kYF9pKSArIM-DKChzdW1faSDOsV9pKS8oc3VtX2kgzrFfaV4yKSAtIDEp');\"} }{}\n \\\\\nwhere \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'D', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-D_i\", \"sym\":\"D\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {D} }_{i} & : \\mathbb{R}^{ 3}\\rightarrow \\mathbb{R} \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, '$\\\\\\\\boldsymbol{u}$', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-$\\\\\\\\boldsymbol{u}$_i\", \"sym\":\"$\\\\\\\\boldsymbol{u}$\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {\\boldsymbol{u}} }_{i} & : \\mathbb{R}^{ 3} \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'σ', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-σ\", \"sym\":\"σ\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {σ} } & : \\mathbb{R} \\\\\n\\idlabel{ {\"onclick\":\"event.stopPropagation(); onClickSymbol(this, 'α', 'heartlib', 'use', false, '')\", \"id\":\"heartlib-α_i\", \"sym\":\"α\", \"func\":\"heartlib\",  \"localFunc\":\"\", \"type\":\"use\", \"case\":\"equation\"} }{ {α} }_{i} & : \\mathbb{R} \\\\\n\\\\\n\\end{align*}\n"
