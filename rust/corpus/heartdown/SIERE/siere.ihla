`$G(u)$` = [`$v_G$`
          M⁻¹`$f_G$`]
`$H(u)$` = [`$v_H$`
          M⁻¹`$f_H$`]
`$v_G$` = `$U_s$``$U_s$`^T Mv
`$v_H$` =  v - `$v_G$`
`$f_G$` =  M`$U_s$``$U_s$`^T f
`$f_H$` =  f - `$f_G$`

where 
`$U_s$` : ℝ^(n × s)
M : ℝ^(n × n)
v : ℝ^n
f : ℝ^n
K : ℝ^(n × n)

`$J_G$` = [0    `$U_s$``$U_s$`^TM
      -`$U_s$``$U_s$`^TK`$U_s$``$U_s$`^TM 0 ]
`$J_H$` =  [0     I_n
            -M⁻¹K 0] - `$J_G$` 


`$u_+$` =  u + (`$\boldsymbol{I}$` -h`$J_H$`)⁻¹(h `$H(u)$` + h[`$U_s$` 0
                                               0   `$U_s$`] `$φ_1$`(h`$J_G^r$`) `$G^r(u)$`)
where 
`$\boldsymbol{I}$` : ℝ^(2n × 2n)
h : ℝ
`$φ_1$` : ℝ^(k×k) -> ℝ^(k×k)
u : ℝ^(2n × 1)

`$J_G^r$` = [0     I_s
            -`$U_s$`^TK`$U_s$` 0]
`$G^r(u)$` = [`$U_s$`^TMv
            `$U_s$`^Tf]

