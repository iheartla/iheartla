m(ω;σ) = exp(-2π^2 ω^2 σ^2) where ω ∈ ℝ, σ∈ ℝ

m̃(ω;σ) = CSF(ω) m(ω;σ) where ω ∈ ℝ, σ∈ ℝ
where
CSF ∈ ℝ->ℝ


`$E_b$`(σ) = sum_i ( (m̃(ω_i ; σ))/`$m̃_{t,b}$`)^`$β_b$`  where σ ∈ ℝ
where
ω_i ∈ ℝ
`$m̃_{t,b}$` ∈ ℝ
`$β_b$` ∈ ℝ

`$∆Q_P$` = `$E_b$`(`$σ_P^A$`) - `$E_b$`(`$σ_P^B$`)
`$∆Q_O$` = `$E_b$`(`$σ_O^A$`) - `$E_b$`(`$σ_O^B$`)
where
`$σ_P^A$` ∈ ℝ
`$σ_P^B$` ∈ ℝ
`$σ_O^A$` ∈ ℝ
`$σ_O^B$` ∈ ℝ
